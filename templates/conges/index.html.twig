{% extends 'base.html.twig' %}
{% block title %}Mes congés{% endblock %}
{% block page_title %}Mes congés{% endblock %}

{% block body %}
{% set estFamille = type == 'FAMILLE' %}

<style>
  .cg-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media(max-width:560px){.cg-grid{grid-template-columns:1fr;}}
  .cg-field label{display:block;font-size:12px;font-weight:600;color:var(--text-muted);margin-bottom:5px;}
  .cg-field input[type=date],.cg-field input[type=text]{width:100%;padding:11px;border:1px solid var(--border);border-radius:10px;font-size:15px;font-family:inherit;}
  .cg-radios{display:flex;gap:8px;}
  .cg-radios label{flex:1;border:1.5px solid var(--border);border-radius:10px;padding:9px;text-align:center;font-size:13.5px;font-weight:600;color:var(--text-muted);cursor:pointer;}
  .cg-radios input{position:absolute;opacity:0;}
  .cg-radios input:checked + span{color:var(--primary);}
  .cg-item{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 16px;border:1px solid var(--border);border-radius:12px;margin-bottom:10px;}
  .cg-dates{font-weight:700;font-size:15px;}
  .cg-meta{font-size:12.5px;color:var(--text-muted);}
  .cg-actions{margin-left:auto;display:flex;gap:8px;}
  .cg-edit{display:none;margin-top:10px;padding-top:12px;border-top:1px dashed var(--border);}
  .cg-edit.on{display:block;}
</style>

<div class="page-header">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <div>
      <h1>Mes congés</h1>
      <p>Déclarez vos périodes d'absence à tout moment — autant que nécessaire.</p>
    </div>
    <a href="{{ estFamille ? path('famille_panel_mvc') : path('dashboard') }}" class="btn btn-secondary btn-sm">
      <i class="fas fa-arrow-left"></i> Mon espace
    </a>
  </div>
</div>

{% for msg in app.flashes('success') %}
<div class="alert alert-success mb-3" style="background:var(--success-bg);border:1px solid #a7f3d0;color:#065f46;border-radius:var(--radius);padding:12px 16px;"><i class="fas fa-check-circle me-2"></i>{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger mb-3" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:12px 16px;"><i class="fas fa-exclamation-circle me-2"></i>{{ msg }}</div>
{% endfor %}

{# ── Ajouter un congé ── #}
<div class="card" style="margin-bottom:22px;">
  <div class="card-header"><i class="fas fa-plus-circle" style="color:var(--primary);"></i><span class="card-title">Ajouter un congé</span></div>
  <div class="card-body">
    <form method="POST" action="{{ path('mes_conges_ajouter_mvc', {type: type, personneId: personneId}) }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('conge_ajouter') }}">
      <div class="cg-grid">
        <div class="cg-field"><label>À partir du</label><input type="date" name="dateDebut" required></div>
        <div class="cg-field"><label>Jusqu'au</label><input type="date" name="dateFin" required></div>
      </div>

      {% if estFamille %}
      <div class="cg-grid" style="margin-top:14px;">
        <div class="cg-field"><label>Maintenir les prestations pendant ce congé&nbsp;?</label>
          <div class="cg-radios">
            <label><input type="radio" name="maintienPrestation" value="oui"><span>Oui</span></label>
            <label><input type="radio" name="maintienPrestation" value="non"><span>Non</span></label>
          </div>
        </div>
        <div class="cg-field"><label>Remplacement si l'intervenante est absente&nbsp;?</label>
          <div class="cg-radios">
            <label><input type="radio" name="souhaiteRemplacement" value="oui"><span>Oui</span></label>
            <label><input type="radio" name="souhaiteRemplacement" value="non"><span>Non</span></label>
          </div>
        </div>
      </div>
      {% else %}
      <div class="cg-field" style="margin-top:14px;max-width:420px;">
        <label>Seriez-vous disponible pour des remplacements&nbsp;? <span style="font-weight:400;color:var(--text-muted);">(en dehors de vos congés)</span></label>
        <div class="cg-radios">
          <label><input type="radio" name="disponible" value="oui" {{ dispoRempl ? 'checked' }}><span>Oui</span></label>
          <label><input type="radio" name="disponible" value="non" {{ not dispoRempl ? 'checked' }}><span>Non</span></label>
        </div>
      </div>
      {% endif %}

      <div class="cg-field" style="margin-top:14px;"><label>Motif / précision (facultatif)</label><input type="text" name="motif" maxlength="500" placeholder="Ex. congés d'été, week-end prolongé…"></div>

      <button type="submit" class="btn btn-primary" style="margin-top:16px;"><i class="fas fa-check"></i> Enregistrer ce congé</button>
    </form>
  </div>
</div>

{# ── Liste des congés ── #}
<div class="card">
  <div class="card-header"><i class="fas fa-umbrella-beach" style="color:var(--primary);"></i><span class="card-title">Mes congés déclarés</span></div>
  <div class="card-body">
    {% if conges is empty %}
      <div class="empty-state" style="padding:24px;color:var(--text-muted);text-align:center;">Aucun congé déclaré pour le moment.</div>
    {% else %}
      {% for c in conges %}
      <div>
        <div class="cg-item">
          <div>
            <div class="cg-dates">{{ c.dateDebut|date('d/m/Y') }} → {{ c.dateFin|date('d/m/Y') }}
              {% if not estFamille %}
                {% if c.statut == 'VALIDE' %}<span style="font-size:11px;font-weight:700;background:#e9f9ef;color:#16a34a;padding:2px 8px;border-radius:999px;">✓ Validé</span>
                {% elseif c.statut == 'REFUSE' %}<span style="font-size:11px;font-weight:700;background:#fdeaea;color:#dc2626;padding:2px 8px;border-radius:999px;">✕ Refusé</span>
                {% else %}<span style="font-size:11px;font-weight:700;background:#fdf3e6;color:#b45309;padding:2px 8px;border-radius:999px;">⏳ En attente de validation</span>{% endif %}
              {% endif %}
            </div>
            <div class="cg-meta">
              {% if estFamille %}
                Ménage : {{ c.maintienPrestation == true ? 'maintenu' : (c.maintienPrestation == false ? 'suspendu' : '—') }}
                {% if c.souhaiteRemplacement is not null %} · Remplacement : {{ c.souhaiteRemplacement ? 'oui' : 'non' }}{% endif %}
                {% if c.motif %} · « {{ c.motif }} »{% endif %}
              {% elseif c.motif %}
                « {{ c.motif }} »
              {% endif %}
              {% if c.origine == 'CAMPAGNE' %} · <span title="Collecté via une campagne">campagne</span>{% endif %}
            </div>
          </div>
          <div class="cg-actions">
            {% set verrou = not estFamille and c.statut == 'VALIDE' %}
            {% if verrou %}
              <span class="cg-meta" title="Congé validé — contactez l'administrateur pour le modifier"><i class="fas fa-lock"></i> Verrouillé</span>
            {% else %}
              <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('edit-{{ c.id }}').classList.toggle('on')"><i class="fas fa-pen"></i></button>
              <form method="POST" action="{{ path('mes_conges_supprimer_mvc', {type: type, personneId: personneId, id: c.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce congé ?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('conge_supprimer_' ~ c.id) }}">
                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
              </form>
            {% endif %}
          </div>
        </div>

        {# Édition inline #}
        <div id="edit-{{ c.id }}" class="cg-edit">
          <form method="POST" action="{{ path('mes_conges_modifier_mvc', {type: type, personneId: personneId, id: c.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('conge_modifier_' ~ c.id) }}">
            <div class="cg-grid">
              <div class="cg-field"><label>À partir du</label><input type="date" name="dateDebut" value="{{ c.dateDebut|date('Y-m-d') }}" required></div>
              <div class="cg-field"><label>Jusqu'au</label><input type="date" name="dateFin" value="{{ c.dateFin|date('Y-m-d') }}" required></div>
            </div>
            {% if estFamille %}
            <div class="cg-grid" style="margin-top:12px;">
              <div class="cg-field"><label>Maintenir les prestations&nbsp;?</label>
                <div class="cg-radios">
                  <label><input type="radio" name="maintienPrestation" value="oui" {{ c.maintienPrestation == true ? 'checked' }}><span>Oui</span></label>
                  <label><input type="radio" name="maintienPrestation" value="non" {{ c.maintienPrestation == false ? 'checked' }}><span>Non</span></label>
                </div>
              </div>
              <div class="cg-field"><label>Remplacement&nbsp;?</label>
                <div class="cg-radios">
                  <label><input type="radio" name="souhaiteRemplacement" value="oui" {{ c.souhaiteRemplacement == true ? 'checked' }}><span>Oui</span></label>
                  <label><input type="radio" name="souhaiteRemplacement" value="non" {{ c.souhaiteRemplacement == false ? 'checked' }}><span>Non</span></label>
                </div>
              </div>
            </div>
            {% endif %}
            <div class="cg-field" style="margin-top:12px;"><label>Motif (facultatif)</label><input type="text" name="motif" maxlength="500" value="{{ c.motif }}"></div>
            <button type="submit" class="btn btn-primary btn-sm" style="margin-top:12px;"><i class="fas fa-check"></i> Mettre à jour</button>
          </form>
        </div>
      </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
{% endblock %}
