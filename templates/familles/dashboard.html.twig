{% extends 'base.html.twig' %}

{% block title %}Mon espace - {{ famille.nomFamille }}{% endblock %}

{% block body %}

<div class="famille-container">

    <h1 class="title">
        Espace famille : <strong>{{ famille.nomFamille }}</strong>
    </h1>

    {# ================= FLASH ================= #}
    <div class="flash-zone">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
    </div>

    {# ================= MENU CARDS ================= #}
    <div class="menu-grid">

        <a class="menu-card" href="{{ path('famille_profile_mvc') }}">
            <img src="{{ asset('assets/icons/user.png') }}">
            <span>Mon profil</span>
        </a>

        {% if famille.prestGardeEnfants %}
        <a class="menu-card" href="{{ path('releves_famille_mvc', {numFam: famille.numeroFamille}) }}">
            <img src="{{ asset('assets/icons/folderENFA.png') }}">
            <span>Garde d’enfants</span>
        </a>
        {% endif %}

        {% if famille.prestMenage %}
        <a class="menu-card" href="{{ path('releves_famille_mvc', {numFam: famille.numeroFamille}) }}">
            <img src="{{ asset('assets/icons/folderMENA.png') }}">
            <span>Ménage</span>
        </a>
        {% endif %}

    </div>

    {# ================= À VALIDER ================= #}
    <h2 class="section-title">Heures à valider</h2>

    {% if prestationsNonValidees is empty %}

        <div class="empty-state">
            Aucune heure en attente de validation
        </div>

    {% else %}

        <div class="card-list">

            {% for p in prestationsNonValidees %}

                <div class="presta-card">

                    <div class="presta-header">
                        <div class="date">
                            {{ p.datePresta|date('d/m/Y') }}
                        </div>

                        <div class="type">
                            {{ p.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                        </div>
                    </div>

                    <div class="presta-body">
                        <div>
                            <strong>Intervenant :</strong> {{ p.numInter }}
                        </div>
                        <div>
                            {{ p.heureDebutPresta|date('H:i') }} → {{ p.heureFinPresta|date('H:i') }}
                        </div>
                    </div>

                    <div class="presta-actions">

                        <form method="POST"
                              action="{{ path('famille_valider_prestation_mvc', {
                                  numFam: famille.numeroFamille,
                                  id: p.id
                              }) }}">
                            <button class="btn btn-success">Valider</button>
                        </form>

                        <form method="POST"
                              action="{{ path('famille_signaler_prestation_mvc', {
                                  numFam: famille.numeroFamille,
                                  id: p.id
                              }) }}">
                            <input type="text" name="remarque" placeholder="Motif">
                            <button class="btn btn-danger">Signaler</button>
                        </form>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

    {# ================= VALIDÉES ================= #}
    <h2 class="section-title">Heures validées</h2>

    {% set validees = prestationsValidees|filter(p => p.validerFam) %}

    {% if validees is empty %}

        <div class="empty-state">
            Aucune heure validée ce mois
        </div>

    {% else %}

        <div class="card-list">

            {% for p in validees %}

                <div class="mini-card">

                    <div>
                        {{ p.datePresta|date('d/m/Y') }}
                    </div>

                    <div>
                        {{ p.heureDebutPresta|date('H:i') }} → {{ p.heureFinPresta|date('H:i') }}
                    </div>

                    <div class="badge">
                        {{ p.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

</div>

{% endblock %}