{% extends 'base.html.twig' %}

{% block title %}Espace famille{% endblock %}

{% block body %}
<h1>Bienvenue, famille {{ famille.nomFamille ?? famille.numeroFamilleFamille ?? '' }}</h1>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

<h2>Heures à valider</h2>
{% if prestationsNonValidees is empty %}
    <p>Aucune heure en attente de validation.</p>
{% else %}
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Intervenant</th>
                <th>Date</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for p in prestationsNonValidees %}
            <tr>
                <td>{{ p.numInter }}</td>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta|date('H:i') }}</td>
                <td>{{ p.heureFinPresta|date('H:i') }}</td>
                <td>{{ p.typePresta == 'MENA' ? 'Ménage' : 'Garde d\'enfants' }}</td>
                <td>
                    <form method="POST" action="{{ path('famille_valider_prestation_mvc', {numFam: famille.numeroFamille, id: p.id}) }}" style="display:inline;">
                        <button type="submit" class="btn-vert">Valider</button>
                    </form>
                    <form method="POST" action="{{ path('famille_signaler_prestation_mvc', {numFam: famille.numeroFamille, id: p.id}) }}" style="display:inline;">
                        <input type="text" name="remarque" placeholder="Motif du signalement" required>
                        <button type="submit" class="btn-rouge">Signaler</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<h2>Heures validées</h2>
{% if prestationsValidees is empty %}
    <p>Aucune heure validée ce mois.</p>
{% else %}
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody>
        {% for p in prestationsValidees %}
            {% if p.validerFam %}
            <tr>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta|date('H:i') }}</td>
                <td>{{ p.heureFinPresta|date('H:i') }}</td>
                <td>{{ p.typePresta == 'MENA' ? 'Ménage' : 'Garde d\'enfants' }}</td>
            </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
