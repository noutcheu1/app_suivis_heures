{% extends 'base.html.twig' %}
{% block title %}Confirmer mes heures — {{ famille.nomFamille ?? '' }}{% endblock %}
{% block page_title %}Confirmation des heures{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>{{ famille_label(famille) }}</h1>
            <p>{{ moisLabel|capitalize }} — heures à confirmer</p>
        </div>
        {% if isAdmin %}
        <a href="{{ path('admin_famille_detail_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Retour admin
        </a>
        {% else %}
        <a href="{{ path('famille_panel_mvc') }}" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Tableau de bord
        </a>
        {% endif %}
    </div>
</div>

{# ── Prestations du mois courant non encore déclarées ─────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-pen" style="color:var(--primary);"></i>
        <span class="card-title">Prestations à confirmer ce mois</span>
        <span class="badge {{ lignes|length > 0 ? 'badge-warning' : 'badge-success' }}" style="margin-left:auto;">
            {{ lignes|length }}
        </span>
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">

        {% if lignes is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-check-circle" style="color:var(--success);"></i></div>
            <h3>Tout est à jour</h3>
            <p>Aucune prestation en attente de confirmation pour ce mois.</p>
        </div>
        {% else %}

        <div style="padding:12px 18px 4px;font-size:12.5px;color:var(--text-muted);background:var(--bg-secondary);border-bottom:1px solid var(--border);">
            <i class="fas fa-info-circle"></i>
            Les heures indiquées sont celles <strong>prévues au planning</strong>.
            Confirmez ou corrigez si nécessaire.
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Intervenant</th>
                    <th>Type</th>
                    <th>Horaire prévu</th>
                    <th>Votre heure de début</th>
                    <th>Votre heure de fin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in lignes %}
            {% set h = ligne.horaire %}
            {% set p = ligne.proposer %}
            {% set iv = ligne.intervenant %}
            <tr>
                <td>
                    {{ h.datePresta|date('d/m/Y') }}<br>
                    <small style="color:var(--text-muted);">
                        {{ h.datePresta|date('D')|replace({'Mon':'Lun','Tue':'Mar','Wed':'Mer','Thu':'Jeu','Fri':'Ven','Sat':'Sam','Sun':'Dim'}) }}
                    </small>
                </td>
                <td style="font-weight:500;">
                    {% if iv %}
                        {{ iv.prenom }} {{ iv.nom }}
                    {% else %}
                        <span style="color:var(--text-muted);">—</span>
                    {% endif %}
                </td>
                <td>
                    <span class="badge {{ h.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ h.typePresta == 'MENA' ? 'Ménage' : (h.typePresta == 'ENFA' ? "Garde d'enfants" : h.typePresta) }}
                    </span>
                </td>
                {% set heureDebutRef = (p and p.heureDebut) ? p.heureDebut : h.heureDebutPresta %}
                {% set heureFinRef   = (p and p.heureFin)   ? p.heureFin   : h.heureFinPresta %}
                <td style="font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap;">
                    {% if heureDebutRef and heureFinRef %}
                        {{ heureDebutRef|date('H:i') }} → {{ heureFinRef|date('H:i') }}
                        
                    {% else %}
                        <span style="color:var(--text-muted);">—</span>
                    {% endif %}
                </td>
                <form method="POST"
                      action="{{ path('famille_declarer_heures_mvc', {numFam: famille.numeroFamille, id: h.id}) }}"
                      style="display:contents;">
                    <td>
                        <input type="time" name="heureDebut" required
                               value="{{ heureDebutRef ? heureDebutRef|date('H:i') : '' }}"
                               style="height:34px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:13px;padding:0 8px;width:105px;">
                    </td>
                    <td>
                        <input type="time" name="heureFin" required
                               value="{{ heureFinRef ? heureFinRef|date('H:i') : '' }}"
                               style="height:34px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:13px;padding:0 8px;width:105px;">
                    </td>
                    <td>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-check"></i> Confirmer
                        </button>
                    </td>
                </form>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</div>

{% endblock %}
