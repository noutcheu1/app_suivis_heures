{% extends 'base_new.html.twig' %}

{% block title %}Liste des familles - Application Chaudoudoux{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 15px;
    }
    
    .search-container {
        background: white;
        padding: 1.5rem;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    
    .famille-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 1.5rem;
        border-left: 5px solid #17a2b8;
    }
    
    .famille-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .famille-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
    
    .famille-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #495057;
        margin: 0;
    }
    
    .famille-id {
        background: #e9ecef;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.9rem;
        color: #6c757d;
    }
    
    .famille-info {
        margin-bottom: 1rem;
    }
    
    .famille-info-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        color: #6c757d;
    }
    
    .famille-info-item i {
        margin-right: 0.5rem;
        width: 20px;
        text-align: center;
    }
    
    .famille-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    
    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
    }
    
    .btn-action:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }
    
    .btn-primary {
        background: linear-gradient(45deg, #0d6efd, #0056b3);
        color: white;
    }
    
    .btn-success {
        background: linear-gradient(45deg, #28a745, #1e7e34);
        color: white;
    }
    
    .btn-info {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }
    
    .search-input {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: border-color 0.3s ease;
    }
    
    .search-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
    
    .pagination {
        justify-content: center;
        margin-top: 2rem;
    }
    
    .pagination .page-link {
        border: none;
        margin: 0 0.25rem;
        border-radius: 8px;
        color: #0d6efd;
    }
    
    .pagination .page-item.active .page-link {
        background: linear-gradient(45deg, #0d6efd, #0056b3);
    }
</style>
{% endblock %}

{% block body %}
<!-- Header de la page -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-3">
                    <i class="fas fa-home me-3"></i>
                    Liste des familles
                </h1>
                <p class="mb-0">
                    Gérez toutes les familles inscrites dans le système
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="text-white">
                    <i class="fas fa-users me-2"></i>
                    {{ familles|length }} famille(s) trouvée(s)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barre de recherche -->
<div class="container">
    <div class="search-container">
        <form method="GET" action="{{ path('familles_mvc') }}">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label for="search" class="form-label">
                        <i class="fas fa-search me-2"></i>
                        Rechercher une famille
                    </label>
                    <input type="text" class="form-control search-input" id="search" name="search" 
                           placeholder="Nom de famille, numéro de famille..." 
                           value="{{ app.request.query.get('search', '') }}">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>
                        Rechercher
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Liste des familles -->
<div class="container">
    {% if familles is defined and familles|length > 0 %}
        {% for famille in familles %}
            <div class="famille-card">
                <div class="famille-header">
                    <h3 class="famille-name">
                        <i class="fas fa-home me-2 text-info"></i>
                        {{ famille['Nom de la famille']|default('Nom non spécifié') }}
                    </h3>
                    <span class="famille-id">
                        #{{ famille.id|default(famille.numFamille|default('N/A')) }}
                    </span>
                </div>
                
                <div class="famille-info">
                    {% if famille['Adresse'] is defined and famille['Adresse'] %}
                        <div class="famille-info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>{{ famille['Adresse'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if famille['Téléphone'] is defined and famille['Téléphone'] %}
                        <div class="famille-info-item">
                            <i class="fas fa-phone"></i>
                            <span>{{ famille['Téléphone'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if famille['Email'] is defined and famille['Email'] %}
                        <div class="famille-info-item">
                            <i class="fas fa-envelope"></i>
                            <span>{{ famille['Email'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if famille.PGE is defined and famille.PGE != "PGE_ _ _ _" and famille.PGE != "" %}
                        <div class="famille-info-item">
                            <i class="fas fa-child text-success"></i>
                            <span>Service Garde d'enfant activé</span>
                        </div>
                    {% endif %}
                    
                    {% if famille.PM is defined and famille.PM != "" %}
                        <div class="famille-info-item">
                            <i class="fas fa-broom text-warning"></i>
                            <span>Service Ménage activé</span>
                        </div>
                    {% endif %}
                </div>
                
                <div class="famille-actions">
                    <a href="{{ path('famille_panel_mvc', {id: famille.id|default(famille.numFamille)}) }}" 
                       class="btn-action btn-primary">
                        <i class="fas fa-tachometer-alt me-2"></i>
                        Tableau de bord
                    </a>
                    
                    <a href="{{ path('famille_profile_mvc', {id: famille.id|default(famille.numFamille)}) }}" 
                       class="btn-action btn-info">
                        <i class="fas fa-user me-2"></i>
                        Profil
                    </a>
                    
                    {% if famille.PGE is defined and famille.PGE != "PGE_ _ _ _" and famille.PGE != "" %}
                        <a href="{{ path('releves_famille_mvc', {numFam: famille.id|default(famille.numFamille)}) }}" 
                           class="btn-action btn-success">
                            <i class="fas fa-child me-2"></i>
                            Relevés ENFA
                        </a>
                    {% endif %}
                    
                    {% if famille.PM is defined and famille.PM != "" %}
                        <a href="{{ path('releves_famille_mvc', {numFam: famille.id|default(famille.numFamille)}) }}" 
                           class="btn-action btn-success">
                            <i class="fas fa-broom me-2"></i>
                            Relevés MENA
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-home fa-4x text-muted"></i>
            </div>
            <h3 class="text-muted">Aucune famille trouvée</h3>
            <p class="text-muted">
                {% if app.request.query.get('search') %}
                    Aucune famille ne correspond à votre recherche.
                {% else %}
                    Il n'y a aucune famille enregistrée dans le système.
                {% endif %}
            </p>
            {% if app.request.query.get('search') %}
                <a href="{{ path('familles_mvc') }}" class="btn btn-primary mt-3">
                    <i class="fas fa-times me-2"></i>
                    Effacer la recherche
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>

<!-- Pagination (si nécessaire) -->
{% if familles is defined and familles|length > 10 %}
<div class="container">
    <nav aria-label="Pagination des familles">
        <ul class="pagination">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            <li class="page-item active">
                <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">3</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}
{% endblock %}
