                        <li class="nav-item"><a class="nav-link" href="{{ path('famille_profile_mvc') }}"><i class="fas fa-user-circle me-1"></i>Mon profil</a></li>
                    {% endif %}

                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <span style="width:30px;height:30px;border-radius:50%;background:var(--primary);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fas fa-user" style="font-size:12px;color:#fff;"></i>
                            </span>
                            <span style="font-size:13px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ app.user.username }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-item-text text-muted" style="font-size:11px;">
                                    {% if is_granted('ROLE_ADMIN') %}Administrateur
                                    {% elseif is_granted('ROLE_INTERVENANT') %}Intervenant
                                    {% else %}Famille{% endif %}
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="fas fa-sign-out-alt me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    {# Main #}
    <div class="main-wrapper">
        <main class="page-content">
            {# Flash messages #}
            {% set flashes = app.flashes %}
            {% if flashes is not empty %}
            <div class="flash-list">
                {% for label, messages in flashes %}
                    {% for msg in messages %}
                        <div class="flash-msg flash-{{ label == 'error' ? 'error' : label }}">
                            <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'error' ? 'exclamation-circle' : (label == 'warning' ? 'triangle-exclamation' : 'info-circle')) }}"></i>
                            {{ msg }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% endif %}

{% else %}
<body>
<div class="auth-shell">
{% endif %}

{% block body %}{% endblock %}

{% if app.user %}
        </main>
    </div>
</div>
{% else %}
</div>
{% endif %}

{% block modal %}
<div class="modal fade" id="modalMessage" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:var(--radius-lg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold" id="modalTitle">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4" id="modalBody">Contenu</div>
            <div class="modal-footer border-0 pt-0" id="modalFooter">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
<script>
    // Mark active nav link
    const currentPath = window.location.pathname;
    document.querySelectorAll('.navbar .nav-link, .navbar .dropdown-item').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
            link.classList.add('active');
        }
    });

    // Auto-close success flashes
    document.querySelectorAll('.flash-success').forEach(el => {
        setTimeout(() => el.style.opacity = '0', 5000);
        setTimeout(() => el.remove(), 5300);
    });
</script>
<script src="{{ asset('/assets/js/app.js') }}"></script>
{% endblock %}

</body>
</html>
