                    <i class="fas fa-file-import"></i> Import Access
                </a>

            {# ── Intervenant ── #}
            {% elseif is_granted('ROLE_INTERVENANT') %}
                {% set iid = auth_intervenant_id() %}
                <div class="sidebar-section-label">Mon espace</div>

                <a class="sidebar-link" href="{{ path('intervenant_panel_mvc', {id: iid}) }}">
                    <i class="fas fa-house"></i> Accueil
                </a>
                <a class="sidebar-link" href="{{ path('intervenant_suivie_mvc',  {id: iid}) }}">
                    <i class="fas fa-plus-circle"></i> Saisir mes heures
                </a>
                <a class="sidebar-link" href="{{ path('intervenant_qr_mvc',  {id: iid}) }}">
                    <i class="fas fa-qrcode"></i> Scanner QR
                </a>
                <a class="sidebar-link" href="{{ path('intervenant_planning_mvc',  {id: iid}) }}">
                    <i class="fas fa-calendar-days"></i> Mes familles
                </a>
                <a class="sidebar-link" href="{{ path('intervenant_heures_mvc',  {id: iid}) }}">
                    <i class="fas fa-clock"></i> Mes heures
                </a>
                {% if iid %}<a class="sidebar-link" href="{{ path('releves_intervenant_mvc', {intervenantId: iid}) }}">
                    <i class="fas fa-file-invoice"></i> Mes relevés
                </a>{% endif %}
                <a class="sidebar-link" href="{{ path('intervenant_profile_mvc',  {id: iid}) }}">
                    <i class="fas fa-user-circle"></i> Mon profil
                </a>

            {# ── Famille ── #}
            {% elseif is_granted('ROLE_FAMILLE') %}
                {% set fid = auth_famille_id() %}
                <div class="sidebar-section-label">Mon espace</div>

                <a class="sidebar-link" href="{{ path('famille_panel_mvc') }}">
                    <i class="fas fa-house"></i> Accueil
                </a>
                <a class="sidebar-link" href="{{ path('famille_detail_mvc', {numFam: fid}) }}">
                    <i class="fas fa-pen"></i> Saisir mes heures
                </a>
                <a class="sidebar-link" href="{{ path('famille_qr_mvc') }}">
                    <i class="fas fa-qrcode"></i> Mon QR code
                </a>
                <a class="sidebar-link" href="{{ path('famille_releves_mvc', {numFam: fid}) }}">
                    <i class="fas fa-file-invoice"></i> Mes relevés
                </a>
                <a class="sidebar-link" href="{{ path('famille_ma_facture_mvc') }}">
                    <i class="fas fa-file-invoice-dollar"></i> Ma facture
                </a>
                <a class="sidebar-link" href="{{ path('famille_estimation_facture_mvc', {numFam: fid}) }}">
                    <i class="fas fa-calculator"></i> Estimation facture
                </a>
                <a class="sidebar-link" href="{{ path('famille_profile_mvc') }}">
                    <i class="fas fa-user-circle"></i> Mon profil
                </a>
            {% endif %}

        </nav>

        {# User footer #}
        <div class="sidebar-footer">
            <div class="sidebar-user" onclick="window.location='{{ path('app_logout') }}'">
                <div class="sidebar-avatar"><i class="fas fa-user"></i></div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">{{ app.user.username }}</div>
                    <div class="sidebar-user-role">
                        {% if is_granted('ROLE_ADMIN') %}Administrateur
                        {% elseif is_granted('ROLE_INTERVENANT') %}Intervenant
                        {% else %}Famille{% endif %}
                    </div>
                </div>
                <i class="fas fa-arrow-right-from-bracket" style="color:rgba(255,255,255,.3);font-size:12px;"></i>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    {# Main #}
    <div class="main-wrapper">
        <header class="topbar">
            <button class="hamburger" onclick="openSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-title">{% block page_title %}{% endblock %}</div>
            <div class="topbar-actions">
                <a href="{{ path('app_logout') }}" class="btn-topbar">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="d-none d-md-inline">Déconnexion</span>
                </a>
            </div>
        </header>

        <main class="page-content">
            {# Flash messages #}
            {% set flashes = app.flashes %}
            {% if flashes is not empty %}
            <div class="flash-list">
                {% for label, messages in flashes %}
                    {% for msg in messages %}
                        <div class="flash-msg flash-{{ label == 'error' ? 'error' : label }}">
                            <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'error' ? 'exclamation-circle' : (label == 'warning' ? 'triangle-exclamation' : 'info-circle')) }}"></i>
                            {{ msg }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% endif %}

{# single block body — defined exactly once #}
{% else %}
<body>
<div class="auth-shell">
{% endif %}

{% block body %}{% endblock %}

{% if app.user %}
        </main>
    </div>
</div>
{% else %}
</div>
{% endif %}

{% block modal %}
<div class="modal fade" id="modalMessage" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:var(--radius-lg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold" id="modalTitle">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4" id="modalBody">Contenu</div>
            <div class="modal-footer border-0 pt-0" id="modalFooter">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
<script>
    function openSidebar() {
        document.getElementById('sidebar').classList.add('open');
        document.getElementById('sidebarOverlay').classList.add('open');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('open');
    }

    // Mark active sidebar link
    const path = window.location.pathname;
    document.querySelectorAll('.sidebar-link').forEach(link => {
        if (link.getAttribute('href') === path) link.classList.add('active');
    });

    // Auto-close success flashes
    document.querySelectorAll('.flash-success').forEach(el => {
        setTimeout(() => el.style.opacity = '0', 5000);
        setTimeout(() => el.remove(), 5300);
    });
</script>
<script src="{{ asset('/assets/js/app.js') }}"></script>
{% endblock %}

</body>
</html>
