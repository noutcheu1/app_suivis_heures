<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
    <title>{% block title %}La Maison des Chaudoudoux{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ─── Design Tokens ─────────────────────────────────── */
        :root {
            --primary:        #4f46e5;
            --primary-hover:  #4338ca;
            --primary-light:  #eef2ff;
            --primary-ring:   rgba(79,70,229,.18);

            --bg:             #f8fafc;
            --white:          #ffffff;
            --border:         #e2e8f0;
            --border-strong:  #cbd5e1;

            --text:           #0f172a;
            --text-muted:     #64748b;
            --text-xmuted:    #94a3b8;

            --success:        #10b981;
            --success-bg:     #ecfdf5;
            --danger:         #ef4444;
            --danger-bg:      #fef2f2;
            --warning:        #f59e0b;
            --warning-bg:     #fffbeb;
            --info:           #0ea5e9;
            --info-bg:        #f0f9ff;

            --navbar-h:       56px;

            --radius-sm:  5px;
            --radius:     8px;
            --radius-md:  10px;
            --radius-lg:  14px;
            --radius-xl:  18px;

            --shadow-xs:  0 1px 2px rgba(0,0,0,.05);
            --shadow-sm:  0 1px 3px rgba(0,0,0,.07),0 1px 2px rgba(0,0,0,.04);
            --shadow:     0 4px 12px rgba(0,0,0,.06),0 1px 3px rgba(0,0,0,.05);
            --shadow-lg:  0 10px 40px rgba(0,0,0,.12);

            --transition: all .15s ease;
        }

        /* ─── Reset ─────────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 15px;
            line-height: 1.6;
            color: var(--text);
            background: var(--bg);
            margin: 0;
        }

        a { color: var(--primary); text-decoration: none; }
        a:hover { color: var(--primary-hover); }

        /* ─── App Shell ──────────────────────────────────────── */
        .app-shell {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ─── Navbar Bootstrap overrides ────────────────────── */
        .navbar { box-shadow: 0 1px 4px rgba(0,0,0,.25); }
        .navbar .nav-link { font-size: 13px; padding: 0.4rem 0.75rem !important; }
        .navbar .dropdown-item { font-size: 13px; padding: 0.4rem 1rem; }
        .navbar-brand { font-size: 14px; font-weight: 600; }
        .navbar .btn-sm { font-size: 12px; }

        /* ─── Main wrapper ───────────────────────────────────── */
        .main-wrapper {
            flex: 1;
            padding-top: var(--navbar-h);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ─── Page Content ───────────────────────────────────── */
        .page-content {
            flex: 1;
            padding: 28px 32px;
        }

        /* ─── Page Header ────────────────────────────────────── */
        .page-header { margin-bottom: 24px; }

        .page-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 4px;
            line-height: 1.3;
        }

        .page-header p {
            font-size: 14px;
            color: var(--text-muted);
            margin: 0;
        }

        /* ─── Cards ──────────────────────────────────────────── */
        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-xs);
        }

        .card-body { padding: 20px; }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            margin: 0;
        }

        /* ─── KPI Card ───────────────────────────────────────── */
        .kpi-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .kpi-label {
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--text-muted);
        }

        .kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--text);
            line-height: 1;
        }

        .kpi-icon {
            width: 38px; height: 38px;
            border-radius: var(--radius);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 8px;
        }

        /* ─── Nav Tabs ───────────────────────────────────────── */
        .nav-tabs-custom {
            display: flex;
            gap: 2px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
        }

        .nav-tabs-custom a {
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-muted);
            border-radius: var(--radius) var(--radius) 0 0;
            transition: var(--transition);
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
        }

        .nav-tabs-custom a:hover { color: var(--text); }

        .nav-tabs-custom a.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
            background: var(--primary-light);
        }

        /* ─── Action Cards ───────────────────────────────────── */
        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 14px;
        }

        .action-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            transition: var(--transition);
            cursor: pointer;
            text-decoration: none;
            color: var(--text);
        }

        .action-card:hover {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-ring);
            color: var(--text);
        }

        .action-card-icon {
            width: 40px; height: 40px;
            border-radius: var(--radius);
            display: flex; align-items: center; justify-content: center;
        }

        .action-card-icon i { font-size: 18px; }

        .action-card-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            margin: 0;
        }

        .action-card-desc {
            font-size: 12.5px;
            color: var(--text-muted);
            margin: 0;
        }

        /* ─── Buttons ────────────────────────────────────────── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0 16px;
            height: 36px;
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
            border: 1px solid transparent;
            text-decoration: none;
        }

        .btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); color: #fff; }

        .btn-secondary { background: var(--white); color: var(--text); border-color: var(--border); }
        .btn-secondary:hover { background: var(--bg); border-color: var(--border-strong); }

        .btn-success { background: var(--success); color: #fff; border-color: var(--success); }
        .btn-success:hover { filter: brightness(.92); }

        .btn-danger { background: var(--danger); color: #fff; border-color: var(--danger); }
        .btn-danger:hover { filter: brightness(.92); }

        .btn-ghost { background: transparent; color: var(--text-muted); border-color: transparent; }
        .btn-ghost:hover { background: var(--bg); color: var(--text); }

        .btn-sm { height: 30px; padding: 0 12px; font-size: 13px; }
        .btn-lg { height: 44px; padding: 0 22px; font-size: 15px; }

        /* ─── Badges ─────────────────────────────────────────── */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .badge-success { background: var(--success-bg); color: #065f46; }
        .badge-danger  { background: var(--danger-bg);  color: #991b1b; }
        .badge-warning { background: var(--warning-bg); color: #92400e; }
        .badge-info    { background: var(--info-bg);    color: #075985; }
        .badge-muted   { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
        .badge-primary { background: var(--primary-light); color: var(--primary); }

        /* ─── Tables ─────────────────────────────────────────── */
        .table-wrapper {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table-toolbar {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .table-search {
            flex: 1;
            max-width: 300px;
            position: relative;
        }

        .table-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            color: var(--text-xmuted);
        }

        .table-search input {
            width: 100%;
            height: 34px;
            padding: 0 12px 0 34px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-size: 14px;
            font-family: inherit;
            color: var(--text);
            background: var(--bg);
            outline: none;
            transition: var(--transition);
        }

        .table-search input:focus {
            border-color: var(--primary);
            background: var(--white);
            box-shadow: 0 0 0 3px var(--primary-ring);
        }

        table.data-table { width: 100%; border-collapse: collapse; }

        table.data-table thead th {
            padding: 11px 16px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--text-muted);
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
        }

        table.data-table thead th:hover { color: var(--text); }

        table.data-table tbody td {
            padding: 13px 16px;
            font-size: 14px;
            color: var(--text);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        table.data-table tbody tr:last-child td { border-bottom: none; }
        table.data-table tbody tr:hover td { background: #fafbfc; }

        /* ─── Empty State ────────────────────────────────────── */
        .empty-state { text-align: center; padding: 60px 20px; }

        .empty-state-icon {
            width: 60px; height: 60px;
            background: var(--bg);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 14px;
        }

        .empty-state-icon i { font-size: 24px; color: var(--text-xmuted); }

        .empty-state h3 { font-size: 16px; font-weight: 600; color: var(--text); margin: 0 0 6px; }
        .empty-state p { font-size: 14px; color: var(--text-muted); margin: 0; }

        /* ─── Flash messages ─────────────────────────────────── */
        .flash-list { margin-bottom: 20px; }

        .flash-msg {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 16px;
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .flash-success { background: var(--success-bg); color: #065f46; border: 1px solid #a7f3d0; }
        .flash-error   { background: var(--danger-bg);  color: #991b1b; border: 1px solid #fecaca; }
        .flash-warning { background: var(--warning-bg); color: #92400e; border: 1px solid #fde68a; }
        .flash-info    { background: var(--info-bg);    color: #075985; border: 1px solid #bae6fd; }

        /* ─── Prestation cards ───────────────────────────────── */
        .prestation-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .prestation-date { text-align: center; min-width: 52px; }

        .prestation-date .day { font-size: 24px; font-weight: 700; color: var(--text); line-height: 1; }
        .prestation-date .month { font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 500; }

        .prestation-sep { width: 1px; height: 40px; background: var(--border); }

        .prestation-info { flex: 1; min-width: 0; }

        .prestation-title { font-size: 14px; font-weight: 600; color: var(--text); margin: 0 0 3px; }
        .prestation-meta { font-size: 12.5px; color: var(--text-muted); }

        /* ─── Auth layout ────────────────────────────────────── */
        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4f46e5 100%);
            padding: 20px;
        }

        /* ─── Mobile ─────────────────────────────────────────── */
        @media (max-width: 900px) {
            .hamburger { display: flex; }

            .topnav-menu {
                display: none;
                position: fixed;
                top: var(--navbar-h);
                left: 0; right: 0;
                background: var(--navbar-bg);
                flex-direction: column;
                align-items: stretch;
                padding: 12px;
                gap: 2px;
                box-shadow: 0 8px 30px rgba(0,0,0,.3);
                max-height: calc(100vh - var(--navbar-h));
                overflow-y: auto;
            }

            .topnav-menu.open { display: flex; }

            .topnav-link { width: 100%; height: 50px; font-size: 16px; justify-content: flex-start; }

            .topnav-dropdown-menu {
                position: static;
                box-shadow: none;
                border: none;
                background: rgba(255,255,255,.06);
                margin: 2px 0;
                padding: 4px;
            }

            .topnav-dropdown-menu a { color: rgba(255,255,255,.8); font-size: 15px; height: 44px; }
            .topnav-dropdown-menu a:hover { background: rgba(255,255,255,.1); color: #fff; }
            .topnav-dropdown-menu a i { color: rgba(255,255,255,.5); }

            .topnav-end {
                border-left: none;
                border-top: 1px solid rgba(255,255,255,.12);
                padding: 12px 0 0;
                margin-top: 8px;
                width: 100%;
                justify-content: space-between;
            }

            .topnav-divider { background: rgba(255,255,255,.12); }

            .topnav-brand-text small { display: none; }

            .page-content { padding: 20px 16px; }
            .action-grid { grid-template-columns: 1fr 1fr; }
            table.data-table { min-width: 480px; }
            .card-body { padding: 16px; }
            .kpi-value { font-size: 24px; }
        }

        @media (max-width: 480px) {
            .action-grid { grid-template-columns: 1fr; }
            .page-content { padding: 16px 12px; }
            .page-header h1 { font-size: 19px; }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

