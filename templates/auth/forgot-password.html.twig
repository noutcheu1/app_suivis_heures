{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<h1>Mot de passe oublié</h1>

{% if error is defined and error %}
    <p style="color:red;">{{ error }}</p>
{% endif %}

{% if success is defined and success %}
    <p style="color:green;">{{ success }}</p>
    <p><a href="{{ path('mdp_oublie_verification_mvc') }}">Saisir mon code →</a></p>
{% else %}
    <form method="POST" action="{{ path('mdp_oublie_mvc') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('mdp_oublie') }}">
        <div class="form-group">
            <label for="identifiant">Votre identifiant (numéro SS ou numéro client)</label>
            <input type="text" id="identifiant" name="identifiant" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary">Recevoir un code par email</button>
    </form>
{% endif %}

<p><a href="{{ path('app_login') }}">← Retour à la connexion</a></p>
{% endblock %}
