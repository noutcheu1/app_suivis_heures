{% extends 'base.html.twig' %}
{% block title %}Inscription — La Maison des Chaudoudoux{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.register-card {
    width: 100%;
    max-width: 460px;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,.25), 0 4px 16px rgba(0,0,0,.1);
}
.register-top {
    padding: 36px 36px 24px;
    text-align: center;
}
.register-logo {
    width: 56px; height: 56px;
    background: #10b981;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
}
.register-logo i { font-size: 24px; color: #fff; }
.register-title { font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 4px; }
.register-subtitle { font-size: 13px; color: #64748b; margin: 0; }
.register-body { padding: 0 36px 32px; }
.field-label {
    font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .6px;
    color: #64748b; display: block; margin-bottom: 6px;
}
.input-wrap { position: relative; margin-bottom: 4px; }
.input-wrap .input-icon {
    position: absolute; left: 12px; top: 50%;
    transform: translateY(-50%);
    font-size: 14px; color: #94a3b8; pointer-events: none;
}
.input-wrap input {
    width: 100%; padding: 0 42px 0 38px; height: 44px;
    border: 1.5px solid #e2e8f0; border-radius: 10px;
    background: #f8fafc; color: #0f172a;
    font-size: 14px; font-family: inherit;
    box-sizing: border-box; outline: none;
    transition: all .2s;
}
.input-wrap input:focus {
    border-color: #10b981; background: #fff;
    box-shadow: 0 0 0 4px rgba(16,185,129,.1);
}
.input-wrap input.is-invalid { border-color: #ef4444; }
.input-wrap input::placeholder { color: #cbd5e1; }
.eye-btn {
    position: absolute; right: 10px; top: 50%;
    transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: #cbd5e1; padding: 4px; line-height: 1;
    transition: color .15s;
}
.eye-btn:hover { color: #10b981; }
.field-hint { font-size: 11px; color: #94a3b8; margin: 4px 0 14px; }
.match-ok   { font-size: 11px; color: #10b981; margin: 4px 0 14px; }
.match-fail { font-size: 11px; color: #ef4444; margin: 4px 0 14px; }
.btn-register {
    width: 100%; height: 44px;
    background: #10b981; color: #fff;
    border: none; border-radius: 10px;
    font-size: 14px; font-weight: 600;
    font-family: inherit; cursor: pointer;
    display: flex; align-items: center;
    justify-content: center; gap: 8px;
    transition: all .15s;
    box-shadow: 0 4px 14px rgba(16,185,129,.35);
}
.btn-register:hover { background: #059669; transform: translateY(-1px); }
.error-box {
    background: #fef2f2; border: 1.5px solid #fecaca;
    border-radius: 10px; padding: 11px 14px;
    font-size: 13px; color: #991b1b;
    display: flex; align-items: center; gap: 9px;
    margin-bottom: 16px;
}
.login-cta { text-align: center; font-size: 13px; color: #64748b; margin-top: 18px; }
.login-cta a { color: #10b981; font-weight: 600; }
.type-selector { display:flex; gap:10px; margin-bottom:20px; }
.type-btn {
    flex:1; padding:12px 8px; border:2px solid #e2e8f0;
    border-radius:10px; background:#f8fafc; cursor:pointer;
    font-size:13px; font-weight:600; font-family:inherit;
    color:#64748b; text-align:center; transition:all .2s;
    display:flex; flex-direction:column; align-items:center; gap:6px;
}
.type-btn i { font-size:20px; }
.type-btn:hover { border-color:#10b981; color:#10b981; background:#f0fdf4; }
.type-btn.selected { border-color:#10b981; background:#ecfdf5; color:#065f46; box-shadow:0 0 0 3px rgba(16,185,129,.15); }
.register-footer {
    padding: 14px 36px;
    border-top: 1px solid #f1f5f9;
    background: #f8fafc;
    text-align: center;
    font-size: 11.5px; color: #94a3b8;
    display: flex; align-items: center;
    justify-content: center; gap: 6px;
}
</style>
{% endblock %}

{% block body %}
<div class="register-card">

    <div class="register-top">
        <div class="register-logo"><i class="fas fa-user-plus"></i></div>
        <h1 class="register-title">Créer un compte</h1>
        <p class="register-subtitle">
            {% if type == 'INTER' %}Inscription Intervenant{% elseif type == 'FAM' %}Inscription Famille{% else %}Choisissez votre profil{% endif %}
        </p>
    </div>

    <div class="register-body">

        {% if error is defined and error %}
        <div class="error-box">
            <i class="fas fa-exclamation-circle"></i>
            {{ error }}
        </div>
        {% endif %}

        <div id="errorBox" class="error-box" style="display:none;">
            <i class="fas fa-exclamation-circle"></i>
            <span id="errorText"></span>
        </div>

        <form id="create_login_form" method="POST" action="{{ path('app_register') }}">
            <input type="hidden" id="type" name="type" value="{{ type }}">

            <div class="type-selector">
                <button type="button" class="type-btn {% if type == 'INTER' %}selected{% endif %}"
                        id="btn-inter" onclick="selectType('INTER')">
                    <i class="fas fa-user-tie"></i>Intervenant
                </button>
                <button type="button" class="type-btn {% if type == 'FAM' %}selected{% endif %}"
                        id="btn-fam" onclick="selectType('FAM')">
                    <i class="fas fa-users"></i>Famille
                </button>
            </div>

            <div class="mb-3">
                <label class="field-label" id="id-label">
                    {% if type == 'INTER' %}Identifiant salarié{% else %}Code client (PM ou PGE){% endif %}
                </label>
                <div class="input-wrap">
                    <i class="fas fa-id-card input-icon" id="id-icon"></i>
                    <input type="text" id="id_conexion" name="id"
                           maxlength="{{ type == 'INTER' ? '21' : '7' }}"
                           placeholder="{{ type == 'INTER' ? '9.xx.xx.xx.xxx.xxx.xx' : 'PGE1234' }}"
                           autocomplete="username" required>
                </div>
                <p class="field-hint" id="id-hint">
                    {% if type == 'INTER' %}Format : 9.xx.xx.xx.xxx.xxx.xx{% else %}Format : PGE1234 ou PM1234{% endif %}
                </p>
            </div>

            <div class="mb-3">
                <label class="field-label">Mot de passe</label>
                <div class="input-wrap">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" id="password" name="password"
                           placeholder="••••••••" autocomplete="new-password" required>
                    <button type="button" class="eye-btn" onclick="toggleVis('password','eyeIcon1')">
                        <i class="fas fa-eye" id="eyeIcon1"></i>
                    </button>
                </div>
                <p class="field-hint">Minimum 8 caractères</p>
            </div>

            <div class="mb-3">
                <label class="field-label">Confirmer le mot de passe</label>
                <div class="input-wrap">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" id="password2" name="password2"
                           placeholder="••••••••" autocomplete="new-password" required>
                    <button type="button" class="eye-btn" onclick="toggleVis('password2','eyeIcon2')">
                        <i class="fas fa-eye" id="eyeIcon2"></i>
                    </button>
                </div>
                <p class="field-hint" id="matchHint">Les mots de passe doivent correspondre</p>
            </div>

            <button type="submit" class="btn-register" id="create_login">
                <i class="fas fa-user-plus"></i> Créer mon compte
            </button>
        </form>

        <div class="login-cta">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </div>

    </div>

    <div class="register-footer">
        <i class="fas fa-shield-alt"></i>
        Inscription sécurisée — données chiffrées
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const idInput   = document.getElementById('id_conexion');
const pass1     = document.getElementById('password');
const pass2     = document.getElementById('password2');
const matchHint = document.getElementById('matchHint');
const errorBox  = document.getElementById('errorBox');
const errorText = document.getElementById('errorText');
let currentType = '{{ type }}' || null;

function selectType(t) {
    currentType = t;
    document.getElementById('type').value = t;
    document.getElementById('btn-inter').classList.toggle('selected', t === 'INTER');
    document.getElementById('btn-fam').classList.toggle('selected', t === 'FAM');

    if (t === 'INTER') {
        document.getElementById('id-label').textContent = 'Identifiant salarié';
        document.getElementById('id-icon').className = 'fas fa-id-card input-icon';
        idInput.maxLength = 21;
        idInput.placeholder = '9.xx.xx.xx.xxx.xxx.xx';
        document.getElementById('id-hint').textContent = 'Format : 9.xx.xx.xx.xxx.xxx.xx';
    } else {
        document.getElementById('id-label').textContent = 'Code client (PM ou PGE)';
        document.getElementById('id-icon').className = 'fas fa-users input-icon';
        idInput.maxLength = 7;
        idInput.placeholder = 'PGE1234';
        document.getElementById('id-hint').textContent = 'Format : PGE1234 ou PM1234';
    }
    idInput.value = '';
}

function toggleVis(inputId, iconId) {
    const i = document.getElementById(inputId);
    const e = document.getElementById(iconId);
    i.type = i.type === 'password' ? 'text' : 'password';
    e.className = i.type === 'text' ? 'fas fa-eye-slash' : 'fas fa-eye';
}

function checkMatch() {
    if (!pass2.value) {
        matchHint.textContent = 'Les mots de passe doivent correspondre';
        matchHint.className = 'field-hint';
        return false;
    }
    if (pass1.value === pass2.value) {
        matchHint.textContent = 'Les mots de passe correspondent ✓';
        matchHint.className = 'match-ok';
        return true;
    } else {
        matchHint.textContent = 'Les mots de passe ne correspondent pas';
        matchHint.className = 'match-fail';
        return false;
    }
}
pass1.addEventListener('input', checkMatch);
pass2.addEventListener('input', checkMatch);

document.getElementById('create_login_form').addEventListener('submit', e => {
    if (!currentType) {
        e.preventDefault();
        errorBox.style.display = 'flex';
        errorText.textContent = 'Veuillez choisir un type de compte (Intervenant ou Famille)';
        return;
    }
    if (pass1.value.length < 8) {
        e.preventDefault();
        errorBox.style.display = 'flex';
        errorText.textContent = 'Le mot de passe doit contenir au moins 8 caractères';
        return;
    }
    if (!checkMatch()) {
        e.preventDefault();
        errorBox.style.display = 'flex';
        errorText.textContent = 'Les mots de passe ne correspondent pas';
        return;
    }
    errorBox.style.display = 'none';
});

idInput.addEventListener('input', () => {
    if (currentType === 'INTER') {
        let v = idInput.value.replace(/\D/g, '');
        const b = [1,2,2,2,3,3,2];
        let r = '', pos = 0;
        for (let i = 0; i < b.length && pos < v.length; i++) {
            if (i > 0) r += '.';
            r += v.slice(pos, pos + b[i]);
            pos += b[i];
        }
        idInput.value = r;
    } else if (currentType === 'FAM') {
        idInput.value = idInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    }
});
</script>
{% endblock %}
