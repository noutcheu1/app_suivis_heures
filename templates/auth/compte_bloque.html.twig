{% extends 'base.html.twig' %}
{% block title %}Accès non disponible{% endblock %}
{% block page_title %}Accès non disponible{% endblock %}

{% block body %}
<div style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
    <div style="max-width:480px;width:100%;text-align:center;padding:40px 24px;">
        <div style="width:64px;height:64px;background:#fff7ed;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <i class="fas fa-clock" style="font-size:28px;color:#f59e0b;"></i>
        </div>

        <h1 style="font-size:22px;font-weight:700;margin:0 0 12px;">
            {% if raison == 'archive' %}
                Compte archivé
            {% else %}
                Candidature en cours de traitement
            {% endif %}
        </h1>

        <p style="color:var(--text-muted);font-size:15px;line-height:1.6;margin:0 0 32px;">
            {% if raison == 'archive' %}
                Votre compte a été archivé. Veuillez contacter l'administration pour plus d'informations.
            {% else %}
                Votre candidature est en cours de traitement. Votre accès sera activé une fois votre dossier validé par l'équipe administrative.
            {% endif %}
        </p>

        <a href="{{ path('app_logout') }}" class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:8px;">
            <i class="fas fa-arrow-left"></i> Retour à la connexion
        </a>
    </div>
</div>
{% endblock %}
