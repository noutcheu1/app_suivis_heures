<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token('pointage') }}">
    <title>Pointage {{ nomFam }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root { --primary:#4f46e5; --green:#16a34a; --muted:#64748b; }
        * { box-sizing:border-box; }
        body { margin:0; font-family:Inter,system-ui,-apple-system,sans-serif; background:#f1f5f9;
               min-height:100vh; display:flex; align-items:flex-start; justify-content:center; padding:24px 16px; }
        .card { background:#fff; border-radius:16px; box-shadow:0 8px 30px rgba(0,0,0,.08);
                width:100%; max-width:420px; padding:28px 24px; }
        h1 { font-size:18px; margin:0 0 4px; color:#1e1b4b; }
        .fam { font-size:14px; color:var(--muted); margin-bottom:20px; }
        label { display:block; font-size:13px; font-weight:600; color:#334155; margin:14px 0 6px; }
        input[type=tel], input[type=number] { width:100%; padding:13px 14px; border:1px solid #cbd5e1;
                border-radius:10px; font-size:16px; }
        input:focus { outline:none; border-color:var(--primary); }
        .btn { width:100%; padding:14px; border:none; border-radius:10px; font-size:15px; font-weight:600;
                cursor:pointer; margin-top:18px; color:#fff; background:var(--primary); }
        .btn:disabled { opacity:.5; cursor:not-allowed; }
        .btn-green { background:var(--green); }
        .btn-ghost { background:#e2e8f0; color:#334155; margin-top:8px; }
        .hidden { display:none; }
        .confirm-nom { font-size:20px; font-weight:700; color:#1e1b4b; text-align:center; margin:8px 0 2px; }
        .type-row { display:flex; gap:8px; margin-top:8px; }
        .type-btn { flex:1; padding:11px; border:2px solid #cbd5e1; border-radius:10px; background:#fff;
                cursor:pointer; font-weight:600; color:#334155; font-size:14px; }
        .type-btn.active { border-color:var(--primary); color:var(--primary); background:#eef2ff; }
        .done { text-align:center; padding:10px 0; }
        .done i { font-size:46px; color:var(--green); }
        .done p { font-size:16px; color:#334155; margin:12px 0 0; }
        .hint { font-size:12px; color:var(--muted); margin-top:10px; text-align:center; }
        .info-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:12px 14px; margin-top:14px; }
        .info-box .t { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); margin-bottom:6px; }
        .info-line { display:flex; justify-content:space-between; font-size:14px; color:#334155; padding:2px 0; }
        .info-line b { color:#1e1b4b; }
    </style>
</head>
<body>
<div class="card" id="card"
     data-url-identifier="{{ path('pointage_identifier', {token: token}) }}"
     data-url-demarrer="{{ path('pointage_demarrer', {token: token}) }}"
     data-url-terminer="{{ path('pointage_terminer', {token: token}) }}"
     data-url-cloturer="{{ path('pointage_cloturer', {token: token}) }}"
     data-url-modifier="{{ path('pointage_modifier', {token: token}) }}"
     data-tel-prefill="{{ telPrefill }}"
     data-force-type="{{ forceType|default('') }}">

    <h1><i class="fas fa-clock" style="color:var(--primary);"></i> Pointage</h1>
    <div class="fam">{{ nomFam }}</div>

    {# Étape 1 : saisie du numéro #}
    <div id="etape-tel">
        <label for="tel">Votre numéro de téléphone</label>
        <input type="tel" id="tel" inputmode="numeric" autocomplete="tel" placeholder="06 12 34 56 78">
        <button class="btn" id="btn-identifier">Continuer</button>
        <div class="hint">Identifiez-vous avec le numéro enregistré dans votre dossier.</div>
    </div>

    {# Étape « oubli » : un pointage précédent non terminé à clôturer d'abord #}
    <div id="etape-oubli" class="hidden">
        <div class="confirm-nom" id="oubli-nom"></div>
        <div class="info-box" style="border-color:#fed7aa;background:#fff7ed;">
            <div class="t" style="color:#ea580c;"><i class="fas fa-stopwatch"></i> Pointage non terminé</div>
            <div class="info-line"><span>Famille</span><b id="oubli-fam">—</b></div>
            <div class="info-line"><span>Démarré</span><b id="oubli-debut">—</b></div>
            <div class="info-line"><span id="oubli-date-label">Date</span><b id="oubli-date">—</b></div>
        </div>
        <div class="hint" id="oubli-prevu"></div>
        <button class="btn btn-green" id="btn-cloturer"><i class="fas fa-pen"></i> Modifier et clôturer</button>
    </div>

    {# Étape 2 : confirmation + action #}
    <div id="etape-action" class="hidden">
        <div class="confirm-nom" id="confirm-nom"></div>
        <div class="hint" id="confirm-sub"></div>

        {# Planning prévu du jour #}
        <div id="planning-section" class="info-box hidden">
            <div class="t"><i class="fas fa-calendar-day"></i> Prévu au planning aujourd'hui</div>
            <div id="planning-list"></div>
        </div>

        {# Récap horaires : au démarrage = heure de comptage ; en cours = début → fin #}
        <div id="horaires-section" class="info-box hidden">
            <div class="t"><i class="fas fa-stopwatch"></i> Horaires</div>
            <div class="info-line"><span id="h-debut-label">Début</span><b id="h-debut">—</b></div>
            <div class="info-line" id="h-fin-line"><span>Fin (maintenant)</span><b id="h-fin">—</b></div>
        </div>

        <div id="type-section" class="hidden">
            <label>Type de prestation</label>
            <div class="type-row" id="type-row"></div>
        </div>

        <div id="km-section" class="hidden">
            <label for="km">Kilomètres avec enfant(s) (optionnel)</label>
            <input type="number" id="km" min="0" step="0.1" placeholder="0">
        </div>

        <button class="btn btn-green" id="btn-demarrer">Démarrer</button>
        <button class="btn btn-green hidden" id="btn-terminer">Terminer</button>
        {# Visible seulement une fois le pointage démarré : ouvre le pop-up d'édition #}
        <button class="btn btn-ghost hidden" id="btn-modifier" style="margin-top:8px;">
            <i class="fas fa-pen"></i> Modifier les heures
        </button>
        <button class="btn btn-ghost" id="btn-retour">Ce n'est pas moi / changer de numéro</button>
    </div>

    {# Étape 3 : confirmation finale #}
    <div id="etape-fin" class="hidden done">
        <i class="fas fa-circle-check"></i>
        <p id="fin-msg"></p>
    </div>
</div>

{# ── Pop-up : modifier les heures (début + fin) — n'affecte pas l'heure réelle ── #}
<div id="modal-heures" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;padding:16px;">
    <div style="background:#fff;border-radius:14px;max-width:380px;width:100%;padding:22px;">
        <h3 style="margin:0 0 4px;font-size:17px;color:#1e1b4b;">Modifier les heures</h3>
        <p style="font-size:13px;color:#64748b;margin:0 0 16px;">
            Ajustez les heures affichées. L'heure réelle du pointage n'est pas modifiée.
        </p>

        <label style="font-weight:600;font-size:14px;">Heure de début</label>
        <div style="display:flex;gap:8px;align-items:center;margin:6px 0 14px;">
            <select id="mod-debut-h" style="flex:1;padding:11px;border:1px solid #cbd5e1;border-radius:10px;font-size:16px;"></select>
            <span style="font-weight:700;">h</span>
            <select id="mod-debut-m" style="flex:1;padding:11px;border:1px solid #cbd5e1;border-radius:10px;font-size:16px;"></select>
        </div>

        <label style="font-weight:600;font-size:14px;">Heure de fin</label>
        <div style="display:flex;gap:8px;align-items:center;margin:6px 0 18px;">
            <select id="mod-fin-h" style="flex:1;padding:11px;border:1px solid #cbd5e1;border-radius:10px;font-size:16px;"></select>
            <span style="font-weight:700;">h</span>
            <select id="mod-fin-m" style="flex:1;padding:11px;border:1px solid #cbd5e1;border-radius:10px;font-size:16px;"></select>
        </div>

        <div style="display:flex;gap:8px;">
            <button class="btn btn-green" id="mod-save" style="flex:1;">Enregistrer</button>
            <button class="btn btn-ghost" id="mod-cancel" style="flex:1;">Annuler</button>
        </div>
    </div>
</div>

<script src="{{ asset('assets/js/app.js') }}?v={{ 'now'|date('YmdHis') }}"></script>
<script src="{{ asset('assets/js/pointage.js') }}?v={{ 'now'|date('YmdHis') }}" defer></script>
</body>
</html>
