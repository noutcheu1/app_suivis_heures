{% extends 'base.html.twig' %}
{% block title %}Relevés intervenant — {{ mois }}{% endblock %}
{% block page_title %}Relevés intervenant{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>Relevés</h1>
            <p>Mois : <strong>{{ mois }}</strong></p>
        </div>
        <div style="display:flex;gap:8px;">
            <a href="{{ path('intervenant_panel_mvc', {id: intervenantId}) }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('releves_intervenant_pdf_mvc', {intervenantId: intervenantId, mois: mois}) }}"
               class="btn btn-primary btn-sm">
                <i class="fas fa-file-pdf"></i> Télécharger PDF
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-clock" style="color:var(--primary);"></i>
        <span class="card-title">Détail des heures</span>
        {% if heures is not empty %}
        <span class="badge badge-muted" style="margin-left:auto;">{{ heures|length }} prestation{% if heures|length > 1 %}s{% endif %}</span>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">

        {% if heures is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
            <h3>Aucune heure enregistrée</h3>
            <p>Aucune prestation pour ce mois</p>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Famille</th>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Type</th>
                    <th>Km</th>
                    <th>Validé</th>
                </tr>
            </thead>
            <tbody>
            {% for h in heures %}
            <tr>
                <td style="font-weight:500;">{{ h.nomFam }}</td>
                <td>{{ h.datePresta|date('d/m/Y') }}</td>
                <td>{{ h.heureDebutPresta|date('H:i') }}</td>
                <td>{{ h.heureFinPresta|date('H:i') }}</td>
                <td>
                    <span class="badge {{ h.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ h.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
                <td>{{ h.kmAvecEnfant ?? 0 }} km</td>
                <td>
                    {% if h.validerFam %}
                        <span class="badge badge-success">Validé</span>
                    {% else %}
                        <span class="badge badge-warning">En attente</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</div>

{% endblock %}
