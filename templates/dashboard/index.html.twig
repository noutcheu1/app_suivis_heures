{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="dashboard-container">

    <h1>
        {% if is_granted('ROLE_ADMIN') %}
            Tableau de bord Administrateur
        {% elseif is_granted('ROLE_INTERVENANT') %}
            Tableau de bord Intervenant
        {% elseif is_granted('ROLE_FAMILLE') %}
            Tableau de bord Famille
        {% else %}
            Bienvenue
        {% endif %}
    </h1>

    {# ================= ADMIN ================= #}
    {% if is_granted('ROLE_ADMIN') %}

        <div class="admin-dashboard">

            <div class="stats-cards">
                <div class="stat-card">
                    <h3>{{ stats.total_intervenants ?? '-' }}</h3>
                    <p>Intervenants</p>
                </div>

                <div class="stat-card">
                    <h3>{{ stats.total_familles ?? '-' }}</h3>
                    <p>Familles</p>
                </div>

                <div class="stat-card">
                    <h3>{{ stats.heures_ce_mois ?? '-' }}</h3>
                    <p>Heures ce mois</p>
                </div>
            </div>

            <div class="menu-sections">

                <div class="menu-section">
                    <h2>Gestion des Intervenants</h2>
                    <ul class="menu">
                        <li>
                            <a href="{{ path('admin_intervenants_mvc') }}">
                                <img src="{{ asset('assets/icons/intervenants.png') }}">
                                Liste des Intervenants
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="menu-section">
                    <h2>Gestion des Familles</h2>
                    <ul class="menu">
                        <li>
                            <a href="{{ path('admin_familles_mvc') }}">
                                <img src="{{ asset('assets/icons/famille.png') }}">
                                Liste des Familles
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_signalements_mvc') }}">
                                <img src="{{ asset('assets/icons/erreur.png') }}">
                                Signalements Familles
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="menu-section">
                    <h2>Paie et Export</h2>
                    <ul class="menu">
                        <li>
                            <a href="{{ path('admin_prepare_paie_mvc') }}">
                                <img src="{{ asset('assets/icons/piece.png') }}">
                                Préparation à la paie
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_recapitulatif_mvc') }}">
                                <img src="{{ asset('assets/icons/tab.png') }}">
                                Récapitulatif
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('admin_fiches_vierges_mvc') }}">
                                <img src="{{ asset('assets/icons/folder.png') }}">
                                Fiches vierges
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="menu-section">
                    <h2>Configuration</h2>
                    <ul class="menu">
                        <li>
                            <a href="{{ path('admin_exceptions_facturation_mvc') }}">
                                <img src="{{ asset('assets/icons/plusmoin.png') }}">
                                Exceptions de tarif
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

    {# ================= INTERVENANT ================= #}
    {% elseif is_granted('ROLE_INTERVENANT') %}

        <div class="intervenant-dashboard">
            <h2>Bonjour, {{ user.nomCompletInter ?? user.nom ?? 'Intervenant' }}</h2>

            <ul class="menu">
                <li>
                    <a href="{{ path('intervenant_heures_mvc', {id: user.id}) }}">
                        <img src="{{ asset('assets/icons/calendar.png') }}">
                        Ajouter mes heures
                    </a>
                </li>

                <li>
                    <a href="{{ path('releves_intervenant_mvc', {intervenantId: user.id}) }}">
                        <img src="{{ asset('assets/icons/folderENFA.png') }}">
                        Mes relevés
                    </a>
                </li>

                <li>
                    <a href="{{ path('intervenant_panel_mvc', {id: user.id}) }}">
                        <img src="{{ asset('assets/icons/profile.png') }}">
                        Mon profil
                    </a>
                </li>

                <li>
                    <a href="{{ path('intervenant_suivie_mvc', {id: user.id}) }}">
                        <img src="{{ asset('assets/icons/calendar.png') }}">
                        Mon suivi
                    </a>
                </li>
            </ul>
        </div>

    {# ================= FAMILLE ================= #}
    {% elseif is_granted('ROLE_FAMILLE') %}

        <div class="famille-dashboard">
            <h2>Bonjour, {{ user.nomFamille ?? 'Famille' }}</h2>

            <ul class="menu">
                <li>
                    <a href="{{ path('famille_detail_mvc', {numFam: user.username}) }}">
                        <img src="{{ asset('assets/icons/validation.png') }}">
                        Valider les heures
                    </a>
                </li>

                <li>
                    <a href="{{ path('releves_famille_mvc', {numFam: user.username}) }}">
                        <img src="{{ asset('assets/icons/folderENFA.png') }}">
                        Mes relevés
                    </a>
                </li>

                <li>
                    <a href="{{ path('famille_estimation_facture_mvc', {numFam: user.username}) }}">
                        <img src="{{ asset('assets/icons/calculator.png') }}">
                        Estimer ma facture
                    </a>
                </li>
            </ul>
        </div>

    {% else %}

        <div class="welcome-section">
            <h2>Bienvenue sur l'application de suivi des heures</h2>
            <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
        </div>

    {% endif %}

</div>

{# ================= CSS CONSERVÉ ================= #}
{% block stylesheets %}
{{ parent() }}
<style>
.dashboard-container { max-width: 1200px; margin: 0 auto; padding: 20px; }

.stats-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }

.stat-card { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; text-align: center; }

.stat-card h3 { font-size: 2em; margin: 0; color: #007bff; }

.menu-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }

.menu-section { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; }

.menu { list-style: none; padding: 0; }

.menu a { display: flex; align-items: center; padding: 10px; text-decoration: none; }

.menu img { width: 24px; height: 24px; margin-right: 10px; }

.welcome-section { text-align: center; padding: 60px 20px; }

.btn-primary { background: #007bff; color: white; padding: 10px 20px; border-radius: 5px; }
</style>
{% endblock %}

{% endblock %}