{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="dashboard-container">
    <h1>
        {% if auth and authService is defined and authService.isAdmin() %}
            Tableau de bord Administrateur
        {% elseif auth and authService is defined and authService.isIntervenant() %}
            Tableau de bord Intervenant
        {% elseif auth and authService is defined and authService.isFamille() %}
            Tableau de bord Famille
        {% else %}
            Bienvenue
        {% endif %}
    </h1>

    {% if auth and authService is defined %}

        {# ── ADMIN ─────────────────────────────────────────────────────────── #}
        {% if authService.isAdmin() %}
            <div class="admin-dashboard">
                <div class="stats-cards">
                    <div class="stat-card">
                        <h3>{{ stats.total_intervenants ?? '-' }}</h3>
                        <p>Intervenants</p>
                    </div>
                    <div class="stat-card">
                        <h3>{{ stats.total_familles ?? '-' }}</h3>
                        <p>Familles</p>
                    </div>
                    <div class="stat-card">
                        <h3>{{ stats.heures_ce_mois ?? '-' }}</h3>
                        <p>Heures ce mois</p>
                    </div>
                </div>

                <div class="menu-sections">
                    <div class="menu-section">
                        <h2>Gestion des Intervenants</h2>
                        <ul class="menu">
                            <li>
                                <a href="{{ path('admin_intervenants_mvc') }}">
                                    <img src="{{ asset('assets/icons/intervenants.png') }}" alt="Intervenants">
                                    Liste des Intervenants
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="menu-section">
                        <h2>Gestion des Familles</h2>
                        <ul class="menu">
                            <li>
                                <a href="{{ path('admin_familles_mvc') }}">
                                    <img src="{{ asset('assets/icons/famille.png') }}" alt="Familles">
                                    Liste des Familles
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_signalements_mvc') }}">
                                    <img src="{{ asset('assets/icons/erreur.png') }}" alt="Signalements">
                                    Signalements Familles
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="menu-section">
                        <h2>Paie et Export</h2>
                        <ul class="menu">
                            <li>
                                <a href="{{ path('admin_prepare_paie_mvc') }}">
                                    <img src="{{ asset('assets/icons/piece.png') }}" alt="Paie">
                                    Préparation à la paie
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_recapitulatif_mvc') }}">
                                    <img src="{{ asset('assets/icons/tab.png') }}" alt="Récapitulatif">
                                    Récapitulatif des interventions
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_fiches_vierges_mvc') }}">
                                    <img src="{{ asset('assets/icons/folder.png') }}" alt="Fiches">
                                    Fiches relevé d'heures vierge
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="menu-section">
                        <h2>Configuration</h2>
                        <ul class="menu">
                            <li>
                                <a href="{{ path('admin_exceptions_facturation_mvc') }}">
                                    <img src="{{ asset('assets/icons/plusmoin.png') }}" alt="Exceptions">
                                    Exceptions de tarif
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        {# ── INTERVENANT ───────────────────────────────────────────────────── #}
        {% elseif authService.isIntervenant() %}
            <div class="intervenant-dashboard">
                <h2>Bonjour, {{ user.nomCompletInter ?? user.nom ?? 'Intervenant' }}</h2>

                <ul class="menu">
                    <li>
                        <a href="{{ path('intervenant_heures_mvc', {id: authService.intervenant_id()}) }}">
                            <img src="{{ asset('assets/icons/calendar.png') }}" alt="Heures">
                            Ajouter mes heures
                        </a>
                    </li>
                    <li>
                        {# intervenantId (pas id) — voir routes debug:router #}
                        <a href="{{ path('releves_intervenant_mvc', {intervenantId: authService.intervenant_id()}) }}">
                            <img src="{{ asset('assets/icons/folderENFA.png') }}" alt="Relevés">
                            Mes relevés
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('intervenant_panel_mvc', {id: authService.intervenant_id()}) }}">
                            <img src="{{ asset('assets/icons/profile.png') }}" alt="Profil">
                            Mon profil
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('intervenant_suivie_mvc', {id: authService.intervenant_id()}) }}">
                            <img src="{{ asset('assets/icons/calendar.png') }}" alt="Suivi">
                            Mon suivi
                        </a>
                    </li>
                </ul>
            </div>

        {# ── FAMILLE ───────────────────────────────────────────────────────── #}
        {% elseif authService.isFamille() %}
            <div class="famille-dashboard">
                <h2>Bonjour, {{ user['Nom de la famille'] ?? 'Famille' }}</h2>

                <ul class="menu">
                    <li>
                        {# numFam — voir routes debug:router #}
                        <a href="{{ path('famille_detail_mvc', {numFam: authService.famille_id()}) }}">
                            <img src="{{ asset('assets/icons/validation.png') }}" alt="Validation">
                            Valider les heures
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('releves_famille_mvc', {numFam: authService.famille_id()}) }}">
                            <img src="{{ asset('assets/icons/folderENFA.png') }}" alt="Relevés">
                            Mes relevés
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('famille_estimation_facture_mvc', {numFam: authService.famille_id()}) }}">
                            <img src="{{ asset('assets/icons/calculator.png') }}" alt="Estimation">
                            Estimer ma facture
                        </a>
                    </li>
                </ul>
            </div>
        {% endif %}

    {% else %}
        <div class="welcome-section">
            <h2>Bienvenue sur l'application de suivi des heures</h2>
            <p>Veuillez vous connecter pour accéder à votre tableau de bord.</p>
            <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
        </div>
    {% endif %}
</div>

{% block stylesheets %}
{{ parent() }}
<style>
.dashboard-container { max-width: 1200px; margin: 0 auto; padding: 20px; }
.stats-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }
.stat-card { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; text-align: center; }
.stat-card h3 { font-size: 2em; margin: 0; color: #007bff; }
.stat-card p { margin: 5px 0 0 0; color: #6c757d; }
.menu-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
.menu-section { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; }
.menu-section h2 { margin-top: 0; margin-bottom: 20px; color: #495057; border-bottom: 2px solid #007bff; padding-bottom: 10px; }
.menu { list-style: none; padding: 0; margin: 0; }
.menu li { margin-bottom: 10px; }
.menu a { display: flex; align-items: center; padding: 10px 15px; text-decoration: none; color: #495057; border-radius: 5px; transition: background-color 0.3s; }
.menu a:hover { background-color: #f8f9fa; color: #007bff; }
.menu img { width: 24px; height: 24px; margin-right: 10px; }
.welcome-section { text-align: center; padding: 60px 20px; }
.btn { display: inline-block; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; }
.btn-primary { background-color: #007bff; color: white; }
.btn-primary:hover { background-color: #0056b3; }
</style>
{% endblock %}

{% endblock %}
