{% extends 'base.html.twig' %}
{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block body %}

{% if is_granted('ROLE_ADMIN') %}

    {# Redirect handled by AppAuthenticator this is a fallback #}
    {% set _ = '<script>window.location="' ~ path('admin_dashboard_mvc') ~ '"</script>' %}
    <meta http-equiv="refresh" content="0;url={{ path('admin_dashboard_mvc') }}">

{% elseif is_granted('ROLE_INTERVENANT') %}

    {% set iid = auth_intervenant_id() %}
    <meta http-equiv="refresh" content="0;url={{ path('intervenant_panel_mvc') }}">

{% elseif is_granted('ROLE_FAMILLE') %}

    <meta http-equiv="refresh" content="0;url={{ path('famille_panel_mvc') }}">

{% else %}

<div class="page-header">
    <h1>Bienvenue</h1>
    <p>Connectez-vous pour accéder à votre espace</p>
</div>

<div style="max-width:400px;">
    <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">
        <i class="fas fa-sign-in-alt"></i> Se connecter
    </a>
</div>

{% endif %}

{% endblock %}
