{% extends 'base.html.twig' %}
{% block title %}Écarts — {{ famille.nomFamille ?? famille.numeroFamille }}{% endblock %}
{% block page_title %}Prestations par famille{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <a href="{{ path('admin_signalements_mvc') }}"
               style="font-size:13px;color:var(--text-muted);text-decoration:none;">
                <i class="fas fa-chevron-left"></i> Toutes les familles
            </a>
            <h1 style="margin-top:6px;">{{ famille_label(famille) }}</h1>
            <p>Prestations avec écart — les plus récentes en premier</p>
        </div>
    </div>
</div>

{% if ecarts is empty %}
<div class="card">
    <div class="card-body">
        <div class="empty-state" style="padding:40px 20px;">
            <div class="empty-state-icon"><i class="fas fa-check-circle" style="color:var(--success);"></i></div>
            <h3>Aucun écart</h3>
            <p>Toutes les prestations déclarées ont des heures concordantes.</p>
        </div>
    </div>
</div>
{% else %}
<div class="card">
    <div class="card-body" style="padding:0;overflow-x:auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Intervenant</th>
                    <th>Heures intervenant</th>
                    <th>Heures famille</th>
                    <th>Écart</th>
                    <th>Facturation</th>
                </tr>
            </thead>
            <tbody>
            {% for h in ecarts %}
                {% set durI = (h.heureFinPresta|date('H') * 60 + h.heureFinPresta|date('i')) - (h.heureDebutPresta|date('H') * 60 + h.heureDebutPresta|date('i')) %}
                {% set durF = (h.heureFinFam|date('H') * 60 + h.heureFinFam|date('i')) - (h.heureDebutFam|date('H') * 60 + h.heureDebutFam|date('i')) %}
                {% set ecart = durF - durI %}
                {% set absEcart = ecart < 0 ? -ecart : ecart %}
                {% set ecartH   = absEcart // 60 %}
                {% set ecartMin = absEcart % 60 %}
                {% set sourceEffective = (h.sourceFacturation == 'fam') ? 'fam' : 'inter' %}
                {% set iv = intervenants[h.numInter] ?? null %}

            <tr style="background:rgba(245,158,11,.05);">
                <td>
                    {{ h.datePresta|date('d/m/Y') }}<br>
                    <small style="color:var(--text-muted);">
                        {{ h.datePresta|date('D')|replace({'Mon':'Lun','Tue':'Mar','Wed':'Mer','Thu':'Jeu','Fri':'Ven','Sat':'Sam','Sun':'Dim'}) }}
                    </small>
                </td>
                <td>
                    <span class="badge {{ h.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ h.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
                <td style="font-size:13px;font-weight:500;">
                    {% if iv %}
                        {{ iv.prenom }} {{ iv.nom }}
                    {% else %}
                        {{ h.numInter }}
                    {% endif %}
                </td>

                <td>
                    <span style="{{ sourceEffective == 'inter' ? 'font-weight:700;color:var(--primary);' : 'color:var(--text-muted);' }}">
                        {{ h.heureDebutPresta|date('H:i') }} → {{ h.heureFinPresta|date('H:i') }}
                        <small style="color:var(--text-muted);">({{ (durI // 60) }}h{{ '%02d'|format(durI % 60) }})</small>
                    </span>
                </td>

                <td>
                    <span style="{{ sourceEffective == 'fam' ? 'font-weight:700;color:var(--primary);' : 'color:var(--text-muted);' }}">
                        {{ h.heureDebutFam|date('H:i') }} → {{ h.heureFinFam|date('H:i') }}
                        <small style="color:var(--text-muted);">({{ (durF // 60) }}h{{ '%02d'|format(durF % 60) }})</small>
                    </span>
                </td>

                <td>
                    <span style="font-weight:600;color:{{ ecart > 0 ? 'var(--success)' : 'var(--danger)' }};">
                        {{ ecart > 0 ? '+' : '-' }}{% if ecartH > 0 %}{{ ecartH }}h{% endif %}{{ '%02d'|format(ecartMin) }}min
                    </span>
                </td>

                <td>
                    <div style="display:flex;gap:4px;align-items:center;">
                        <form method="POST" action="{{ path('admin_choisir_source_mvc', {id: h.id}) }}">
                            <input type="hidden" name="source" value="inter">
                            <input type="hidden" name="numFam" value="{{ famille.numeroFamille }}">
                            <button type="submit"
                                    class="btn btn-sm {{ sourceEffective == 'inter' ? 'btn-primary' : 'btn-secondary' }}"
                                    title="Facturer heures intervenant">
                                <i class="fas fa-user-tie"></i> Inter
                            </button>
                        </form>
                        <form method="POST" action="{{ path('admin_choisir_source_mvc', {id: h.id}) }}">
                            <input type="hidden" name="source" value="fam">
                            <input type="hidden" name="numFam" value="{{ famille.numeroFamille }}">
                            <button type="submit"
                                    class="btn btn-sm {{ sourceEffective == 'fam' ? 'btn-primary' : 'btn-secondary' }}"
                                    title="Facturer heures famille">
                                <i class="fas fa-users"></i> Fam
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% endblock %}
