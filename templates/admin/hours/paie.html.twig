{% extends 'base.html.twig' %}
{% block title %}Préparation à la paie — {{ mois }}{% endblock %}
{% block page_title %}Préparation à la paie{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>Préparation à la paie</h1>
            <p>Période : <strong>{{ mois }}</strong></p>
        </div>
        <a href="{{ path('admin_prepare_paie_csv_mvc', {mois: mois}) }}"
           class="btn btn-primary btn-sm">
            <i class="fas fa-file-csv"></i> Exporter CSV
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-money-check-alt" style="color:var(--primary);"></i>
        <span class="card-title">Données de paie</span>
        {% if donneesPaie is not empty %}
        <span class="badge badge-muted" style="margin-left:auto;">{{ donneesPaie|length }} ligne{% if donneesPaie|length > 1 %}s{% endif %}</span>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">

        {% if donneesPaie is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-file-invoice"></i></div>
            <h3>Aucune donnée pour ce mois</h3>
            <p>Aucune prestation déclarée pour la période sélectionnée</p>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Intervenant</th>
                    <th>Type</th>
                    <th>Heures déclarées</th>
                    <th>Trajets</th>
                    <th>Km avec enfants</th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in donneesPaie %}
            <tr>
                <td style="font-weight:500;">{{ ligne.nomComplet ?? '-' }}</td>
                <td>
                    <span class="badge {{ ligne.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ ligne.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
                <td><strong>{{ ligne.dureeTotale ?? '-' }}</strong></td>
                <td>{{ ligne.nbrTrajet ?? 0 }}</td>
                <td>{{ ligne.kmAvecEnfant ?? 0 }} km</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</div>

{% endblock %}
