{% extends 'base.html.twig' %}
{% block title %}Signalements{% endblock %}
{% block page_title %}Signalements familles{% endblock %}

{% block body %}

<div class="page-header">
    <div>
        <h1>Signalements des familles</h1>
        <p>Prestations contestées en attente de traitement</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-flag" style="color:var(--danger);"></i>
        <span class="card-title">Signalements en attente</span>
        {% if signalements is not empty %}
        <span class="badge badge-danger" style="margin-left:auto;">{{ signalements|length }}</span>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">

        {% if signalements is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-check-circle" style="color:var(--success);"></i></div>
            <h3>Aucun signalement en attente</h3>
            <p>Toutes les prestations ont été validées</p>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Intervenant</th>
                    <th>Famille</th>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Type</th>
                    <th>Remarque</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for s in signalements %}
            <tr>
                <td>{{ s.numInter }}</td>
                <td style="font-weight:500;">{{ s.nomFam }}</td>
                <td>{{ s.datePresta|date('d/m/Y') }}</td>
                <td>{{ s.heureDebutPresta|date('H:i') }}</td>
                <td>{{ s.heureFinPresta|date('H:i') }}</td>
                <td>
                    <span class="badge {{ s.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ s.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
                <td>
                    {% if s.remarque %}
                    <span style="font-size:12px;color:var(--danger);font-style:italic;">{{ s.remarque }}</span>
                    {% else %}—{% endif %}
                </td>
                <td>
                    <a href="{{ path('intervenant_suivie_mvc', {id: s.numInter, edite: s.id}) }}"
                       class="btn btn-secondary btn-sm">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</div>

{% endblock %}
