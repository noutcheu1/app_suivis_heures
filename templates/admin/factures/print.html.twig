<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Facture — {{ famille ? famille.nomFamille : facture.numFam }} — {{ moisAnnee }}</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1a1a1a; background: #f3f4f6; }

.page {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 14mm 16mm 12mm;
    background: #fff;
    box-shadow: 0 2px 16px rgba(0,0,0,.08);
}

.doc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px solid #1e40af;
    padding-bottom: 10px;
    margin-bottom: 14px;
}
.doc-title { font-size: 20px; font-weight: 700; color: #1e40af; }
.doc-subtitle { font-size: 11px; color: #6b7280; margin-top: 3px; }
.doc-meta { text-align: right; font-size: 11px; color: #374151; }
.doc-meta strong { font-size: 13px; color: #1a1a1a; }

.famille-block {
    background: #f0f4ff;
    border-left: 4px solid #1e40af;
    padding: 8px 12px;
    margin-bottom: 14px;
    border-radius: 0 4px 4px 0;
}
.famille-nom { font-size: 14px; font-weight: 700; }
.famille-info { font-size: 11px; color: #6b7280; margin-top: 2px; }

.kpis { display: flex; gap: 10px; margin-bottom: 14px; }
.kpi { flex: 1; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 10px; text-align: center; }
.kpi-label { font-size: 9.5px; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; margin-bottom: 4px; }
.kpi-value { font-size: 16px; font-weight: 700; color: #1e40af; }
.kpi-value.total { color: #059669; font-size: 20px; }

.section { margin-bottom: 14px; }
.section-title {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .6px; color: #1e40af;
    border-bottom: 1px solid #dbeafe; padding-bottom: 4px; margin-bottom: 8px;
}

table { width: 100%; border-collapse: collapse; font-size: 11px; }
thead th {
    background: #f3f4f6; padding: 5px 7px; text-align: left;
    font-size: 10px; text-transform: uppercase; letter-spacing: .4px;
    color: #6b7280; border-bottom: 1px solid #e5e7eb;
}
thead th.right, td.right { text-align: right; }
tbody tr:nth-child(even) td { background: #fafafa; }
tbody td { padding: 4px 7px; border-bottom: 1px solid #f3f4f6; }

.recap-table td { padding: 4px 0; font-size: 12px; }
.recap-table td:last-child { text-align: right; font-weight: 600; }
.recap-total td { border-top: 2px solid #1a1a1a; padding-top: 8px; font-size: 15px; font-weight: 800; }
.recap-total td:last-child { color: #059669; }

.divider { border: none; border-top: 1px dashed #d1d5db; margin: 16px 0; }

.avis-grid { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
.avis-item { flex: 1; min-width: 120px; }
.avis-label { font-size: 10px; color: #6b7280; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 4px; }
.stars { font-size: 15px; letter-spacing: 2px; color: #d1d5db; }
.stars .filled { color: #f59e0b; }

.paiement-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
.field-box { border: 1px solid #d1d5db; border-radius: 4px; padding: 6px 10px; }
.field-label { font-size: 9.5px; color: #6b7280; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 3px; }
.field-value { font-size: 12px; min-height: 18px; }

.signature-row { display: flex; gap: 20px; margin-top: 12px; }
.sig-box { flex: 1; border: 1px solid #d1d5db; border-radius: 4px; padding: 8px 10px; min-height: 60px; }
.sig-label { font-size: 9.5px; color: #6b7280; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 4px; }

.doc-footer { margin-top: auto; padding-top: 10px; border-top: 1px solid #e5e7eb; font-size: 9.5px; color: #9ca3af; text-align: center; }

.btn-pdf {
    display: inline-flex; align-items: center; gap: 6px;
    background: #1e40af; color: #fff; border: none; border-radius: 6px;
    padding: 9px 18px; font-size: 13px; cursor: pointer;
    font-family: inherit;
}
.btn-pdf:hover { background: #1d3a9a; }
.btn-pdf:disabled { background: #9ca3af; cursor: not-allowed; }

/* Tables hidden on screen — PDF source only */
.pdf-only { display: none; }
</style>
</head>
<body>

{# ── Barre d'actions ─────────────────────────────────────────────────────── #}
<div style="padding:12px 16mm;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:10;box-shadow:0 1px 4px rgba(0,0,0,.06);">
    <button class="btn-pdf" id="btn-gen-pdf" onclick="genererFacturePDF()">
        &#128196; Générer PDF
    </button>
    <a href="{{ backUrl is defined ? backUrl : path('admin_facture_detail_mvc', {numFam: facture.numFam, moisAnnee: moisAnnee}) }}"
       style="font-size:13px;color:#6b7280;text-decoration:none;">← Retour à la facture</a>
    <span id="pdf-status" style="font-size:12px;color:#6b7280;"></span>
</div>

{# ── Page A4 (affichage écran) ────────────────────────────────────────────── #}
<div class="page">

    {# ── En-tête ──────────────────────────────────────────── #}
    <div class="doc-header">
        <div>
            <div class="doc-title">Facture mensuelle</div>
            <div class="doc-subtitle">Association Chaudoudoux — Service à domicile</div>
        </div>
        <div class="doc-meta">
            <div>Période : <strong>{{ moisAnnee|date('F Y', null, 'fr')|capitalize }}</strong></div>
            <div style="margin-top:3px;">Édité le {{ "now"|date('d/m/Y') }}</div>
            <div style="margin-top:3px;font-family:monospace;font-size:10px;color:#9ca3af;">
                Réf : {{ facture.numFam }}-{{ moisAnnee }}
            </div>
        </div>
    </div>

    {# ── Infos famille ────────────────────────────────────── #}
    <div class="famille-block">
        <div class="famille-nom">{{ famille ? famille.nomFamille : facture.numFam }}</div>
        {% if famille %}
        <div class="famille-info">
            {% if famille.adresse %}{{ famille.adresse }}{% if famille.codePostal or famille.ville %}, {% endif %}{% endif %}
            {% if famille.codePostal %}{{ famille.codePostal }} {% endif %}
            {% if famille.ville %}{{ famille.ville }}{% endif %}
            {% if famille.telDom %} — Tél : {{ famille.telDom }}{% endif %}
        </div>
        {% endif %}
    </div>

    {# ── KPIs ─────────────────────────────────────────────── #}
    <div class="kpis">
        {% if facture.heuresGE > 0 %}
        <div class="kpi">
            <div class="kpi-label">Garde d'enfants</div>
            <div class="kpi-value">{{ facture.heuresGE }} h</div>
        </div>
        {% endif %}
        {% if facture.heuresMENA > 0 %}
        <div class="kpi">
            <div class="kpi-label">Ménage</div>
            <div class="kpi-value">{{ facture.heuresMENA }} h</div>
        </div>
        {% endif %}
        <div class="kpi">
            <div class="kpi-label">Interventions</div>
            <div class="kpi-value">{{ facture.nbInterventions }}</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Montant total dû</div>
            <div class="kpi-value total">{{ facture.montantTotal|number_format(2, ',', ' ') }} €</div>
        </div>
    </div>

    {# ── Prestations GE ───────────────────────────────────── #}
    {% if facture.prestationsGE is not empty %}
    <div class="section">
        <div class="section-title">
            Garde d'enfants — {{ facture.heuresGE }} h × {{ facture.tauxGE|number_format(2, ',') }} €/h
            = {{ facture.montantGE|number_format(2, ',') }} €
        </div>
        <table id="pdf-table-ge">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th class="right">Durée</th>
                    <th class="right">Km</th>
                    <th>Déclaré famille</th>
                </tr>
            </thead>
            <tbody>
            {% for p in facture.prestationsGE %}
            {% if p.heureDebutPresta and p.heureFinPresta %}
                {% set sec = p.heureFinPresta.timestamp - p.heureDebutPresta.timestamp %}
                {% if sec < 0 %}{% set sec = sec + 86400 %}{% endif %}
            {% else %}{% set sec = 0 %}{% endif %}
            <tr>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta ? p.heureDebutPresta|date('H:i') : '—' }}</td>
                <td>{{ p.heureFinPresta ? p.heureFinPresta|date('H:i') : '—' }}</td>
                <td class="right">{% if sec > 0 %}{{ (sec // 3600) }}h{{ '%02d'|format((sec % 3600) // 60) }}{% else %}—{% endif %}</td>
                <td class="right">{{ p.kmAvecEnfant ? p.kmAvecEnfant ~ ' km' : '-' }}</td>
                <td class="right">{{ p.declarerLeFam ? 'Oui' : 'Non' }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {# ── Prestations Ménage ───────────────────────────────── #}
    {% if facture.prestationsMENA is not empty %}
    <div class="section">
        <div class="section-title">
            Ménage — {{ facture.heuresMENA }} h × {{ facture.tauxMENA|number_format(2, ',') }} €/h
            = {{ facture.montantMENA|number_format(2, ',') }} €
        </div>
        <table id="pdf-table-mena">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th class="right">Durée</th>
                    <th>Déclaré famille</th>
                </tr>
            </thead>
            <tbody>
            {% for p in facture.prestationsMENA %}
            {% if p.heureDebutPresta and p.heureFinPresta %}
                {% set sec = p.heureFinPresta.timestamp - p.heureDebutPresta.timestamp %}
                {% if sec < 0 %}{% set sec = sec + 86400 %}{% endif %}
            {% else %}{% set sec = 0 %}{% endif %}
            <tr>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta ? p.heureDebutPresta|date('H:i') : '—' }}</td>
                <td>{{ p.heureFinPresta ? p.heureFinPresta|date('H:i') : '—' }}</td>
                <td class="right">{% if sec > 0 %}{{ (sec // 3600) }}h{{ '%02d'|format((sec % 3600) // 60) }}{% else %}—{% endif %}</td>
                <td class="right">{{ p.declarerLeFam ? 'Oui' : 'Non' }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {# ── Récapitulatif financier ───────────────────────────── #}
    <div class="section">
        <div class="section-title">Récapitulatif financier</div>
        <table class="recap-table" id="pdf-table-recap">
            <tbody>
            {% if facture.montantGE > 0 %}
            <tr>
                <td>Garde d'enfants ({{ facture.heuresGE }} h × {{ facture.tauxGE|number_format(2, ',') }} €/h{% if facture.tauxGESource == 'famille' %} — taux famille{% endif %})</td>
                <td>{{ facture.montantGE|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            {% if facture.montantMENA > 0 %}
            <tr>
                <td>Ménage ({{ facture.heuresMENA }} h × {{ facture.tauxMENA|number_format(2, ',') }} €/h)</td>
                <td>{{ facture.montantMENA|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            {% if facture.fraisGestion > 0 %}
            <tr>
                <td>Frais de gestion ({{ facture.nbInterventions }} interventions)</td>
                <td>{{ facture.fraisGestion|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            {% if facture.montantKm > 0 %}
            <tr>
                <td>Frais kilométriques ({{ facture.kmTotal }} km)</td>
                <td>{{ facture.montantKm|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            {% if facture.abonnement > 0 %}
            <tr>
                <td>Abonnement mensuel</td>
                <td>{{ facture.abonnement|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            {% if facture.montantSupl != 0 %}
            <tr>
                <td>{{ facture.libeleSupl ?: 'Supplément / exception' }}</td>
                <td>{{ facture.montantSupl|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            </tbody>
            <tfoot>
            <tr class="recap-total">
                <td><strong>Total dû</strong></td>
                <td><strong>{{ facture.montantTotal|number_format(2, ',', ' ') }} €</strong></td>
            </tr>
            </tfoot>
        </table>
    </div>

    <hr class="divider">

    {# ── Questionnaire de satisfaction ─────────────────────── #}
    {% set releve = facture.releveGE ?? facture.releveMENA %}
    <div class="section">
        <div class="section-title">
            Questionnaire de satisfaction — {{ moisAnnee|date('F Y', null, 'fr')|capitalize }}
            {% if releve and releve.signerLe %}
            <span style="color:#059669;font-size:10px;font-weight:400;margin-left:8px;">
                ✓ Signé le {{ releve.signerLe|date('d/m/Y') }}
            </span>
            {% endif %}
        </div>

        <div class="avis-grid">
            {% for critere in [
                {label: 'Ponctualité',         val: releve ? releve.avisPonctualite : null},
                {label: 'Régularité relation',  val: releve ? releve.avisReguRela : null},
                {label: 'Respect des horaires', val: releve ? releve.avisRespectHo : null},
                {label: 'Qualité du travail',   val: releve ? releve.avisQualiteTr : null}
            ] %}
            <div class="avis-item">
                <div class="avis-label">{{ critere.label }}</div>
                <div class="stars">
                    {% if critere.val %}
                        {% for i in 1..5 %}
                            <span class="{{ i <= critere.val ? 'filled' : '' }}">★</span>
                        {% endfor %}
                    {% else %}
                        ☆ ☆ ☆ ☆ ☆ <span style="font-size:9px;color:#9ca3af;">(non renseigné)</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# ── Zone paiement ────────────────────────────────────── #}
    <div class="section">
        <div class="section-title">Paiement</div>
        {% set rel = facture.releveGE ?? facture.releveMENA %}
        <div class="paiement-grid">
            <div class="field-box">
                <div class="field-label">Mode de règlement</div>
                <div class="field-value">{{ rel and rel.typeReglement ? rel.typeReglement : '' }}</div>
            </div>
            <div class="field-box">
                <div class="field-label">N° chèque</div>
                <div class="field-value">{{ rel and rel.numCheque ? rel.numCheque : '' }}</div>
            </div>
            <div class="field-box">
                <div class="field-label">Nombre de CESU</div>
                <div class="field-value">{{ rel and rel.nbrCESU ? rel.nbrCESU : '' }}</div>
            </div>
            <div class="field-box">
                <div class="field-label">Complément CESU</div>
                <div class="field-value">{{ rel and rel.complementCESU ? rel.complementCESU : '' }}</div>
            </div>
            <div class="field-box">
                <div class="field-label">Montant principal</div>
                <div class="field-value">
                    {% if rel and rel.montantPrincipal %}{{ rel.montantPrincipal|number_format(2, ',', ' ') }} €{% endif %}
                </div>
            </div>
            <div class="field-box">
                <div class="field-label">Montant complément</div>
                <div class="field-value">
                    {% if rel and rel.montantComplement %}{{ rel.montantComplement|number_format(2, ',', ' ') }} €{% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ── Signatures ───────────────────────────────────────── #}
    <div class="signature-row">
        <div class="sig-box">
            <div class="sig-label">Signature de la famille</div>
        </div>
        <div class="sig-box">
            <div class="sig-label">Signature de l'intervenant(e)</div>
        </div>
        <div class="sig-box">
            <div class="sig-label">Cachet / visa association</div>
        </div>
    </div>

    {# ── Pied de page ─────────────────────────────────────── #}
    <div class="doc-footer" style="margin-top:16px;">
        Association Chaudoudoux — Document généré automatiquement — {{ "now"|date('d/m/Y H:i') }}
    </div>

</div>{# /page #}

{#
    Tables cachées utilisées uniquement pour la génération PDF via jsPDF.
    Elles contiennent les données en texte brut (sans CSS dynamique).
#}
<table class="pdf-only" id="pdf-table-satis">
    <thead>
        <tr>
            <th>Critère</th>
            <th>Note</th>
        </tr>
    </thead>
    <tbody>
        {% set releve = facture.releveGE ?? facture.releveMENA %}
        {% for critere in [
            {label: 'Ponctualité',         val: releve ? releve.avisPonctualite : null},
            {label: 'Régularité relation',  val: releve ? releve.avisReguRela : null},
            {label: 'Respect des horaires', val: releve ? releve.avisRespectHo : null},
            {label: 'Qualité du travail',   val: releve ? releve.avisQualiteTr : null}
        ] %}
        <tr>
            <td>{{ critere.label }}</td>
            <td>
                {% if critere.val %}
                    {% for i in 1..5 %}{{ i <= critere.val ? '★' : '☆' }}{% endfor %}
                    ({{ critere.val }}/5)
                {% else %}
                    Non renseigné
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        {% if releve and releve.signerLe %}
        <tr>
            <td>Signé le</td>
            <td>{{ releve.signerLe|date('d/m/Y') }}</td>
        </tr>
        {% endif %}
    </tbody>
</table>

<table class="pdf-only" id="pdf-table-paiement">
    <thead>
        <tr><th>Champ</th><th>Valeur</th></tr>
    </thead>
    <tbody>
        {% set rel = facture.releveGE ?? facture.releveMENA %}
        <tr>
            <td>Mode de règlement</td>
            <td>{{ rel and rel.typeReglement ? rel.typeReglement : '-' }}</td>
        </tr>
        <tr>
            <td>N° chèque</td>
            <td>{{ rel and rel.numCheque ? rel.numCheque : '-' }}</td>
        </tr>
        <tr>
            <td>Nombre de CESU</td>
            <td>{{ rel and rel.nbrCESU ? rel.nbrCESU : '-' }}</td>
        </tr>
        <tr>
            <td>Complément CESU</td>
            <td>{{ rel and rel.complementCESU ? rel.complementCESU : '-' }}</td>
        </tr>
        <tr>
            <td>Montant principal</td>
            <td>{% if rel and rel.montantPrincipal %}{{ rel.montantPrincipal|number_format(2, ',', ' ') }} €{% else %}-{% endif %}</td>
        </tr>
        <tr>
            <td>Montant complément</td>
            <td>{% if rel and rel.montantComplement %}{{ rel.montantComplement|number_format(2, ',', ' ') }} €{% else %}-{% endif %}</td>
        </tr>
    </tbody>
</table>

{# ── Scripts jsPDF ───────────────────────────────────────────────────────── #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://unpkg.com/jspdf-autotable@3.5.31/dist/jspdf.plugin.autotable.min.js"></script>

<script>
const FAM_NOM    = {{ (famille ? famille.nomFamille : facture.numFam)|json_encode|raw }};
const FAM_ADR    = {{ (famille and famille.adresse ? famille.adresse ~ (famille.codePostal ? ', ' ~ famille.codePostal : '') ~ (famille.ville ? ' ' ~ famille.ville : '') : '')|json_encode|raw }};
const FAM_TEL    = {{ (famille and famille.telDom ? famille.telDom : '')|json_encode|raw }};
const FAM_NUM    = {{ facture.numFam|json_encode|raw }};
const MOIS_ANNEE = {{ moisAnnee|json_encode|raw }};
const MOIS_LABEL = {{ moisAnnee|date('F Y', null, 'fr')|capitalize|json_encode|raw }};
const MONTANT    = {{ facture.montantTotal|json_encode|raw }};

async function genererFacturePDF() {
    const btn = document.getElementById('btn-gen-pdf');
    const status = document.getElementById('pdf-status');

    if (!window.jspdf) {
        alert('Bibliothèque PDF non chargée. Vérifiez votre connexion internet.');
        return;
    }

    btn.disabled = true;
    btn.textContent = '⏳ Génération…';
    status.textContent = '';

    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'mm', 'a4');

        const BLUE   = [30,  64, 175];
        const GRAY   = [107, 114, 128];
        const BLACK  = [26,  26,  26];
        const GREEN  = [5,   150, 105];
        const LGRAY  = [243, 244, 246];
        const BORDER = [229, 231, 235];

        const cellStyles = {
            fontSize: 9,
            cellPadding: 1.5,
            valign: 'middle',
            lineColor: BORDER,
            lineWidth: 0.1,
        };
        const headStyles = {
            fillColor: LGRAY,
            textColor: GRAY,
            fontStyle: 'bold',
            fontSize: 8,
            lineColor: BORDER,
            lineWidth: 0.1,
        };

        // ── Page 1 ────────────────────────────────────────────────────────
        // Titre
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(...BLUE);
        doc.text('Facture mensuelle', 14, 18);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...GRAY);
        doc.text('Association Chaudoudoux — Service à domicile', 14, 24);

        // Méta (droite)
        doc.setFontSize(9);
        doc.setTextColor(...BLACK);
        doc.text('Période : ' + MOIS_LABEL, 196, 14, {align: 'right'});
        doc.text('Édité le ' + new Date().toLocaleDateString('fr-FR'), 196, 19, {align: 'right'});
        doc.setTextColor(...GRAY);
        doc.setFontSize(8);
        doc.text('Réf : ' + FAM_NUM + '-' + MOIS_ANNEE, 196, 24, {align: 'right'});

        // Séparateur
        doc.setDrawColor(...BLUE);
        doc.setLineWidth(0.6);
        doc.line(14, 27, 196, 27);

        // Bloc famille
        doc.setFillColor(240, 244, 255);
        doc.setDrawColor(30, 64, 175);
        doc.setLineWidth(0);
        doc.rect(14, 30, 4, 14, 'F');
        doc.setFillColor(240, 244, 255);
        doc.rect(18, 30, 178, 14, 'F');

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.setTextColor(...BLACK);
        doc.text(FAM_NOM, 21, 37);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...GRAY);
        const famDetails = [FAM_ADR, FAM_TEL ? 'Tél : ' + FAM_TEL : ''].filter(Boolean).join(' — ');
        if (famDetails) doc.text(famDetails, 21, 42);

        let y = 50;

        // KPIs en ligne
        const kpiData = [];
        {% if facture.heuresGE > 0 %}kpiData.push(["Garde d'enfants", "{{ facture.heuresGE }} h"]);{% endif %}
        {% if facture.heuresMENA > 0 %}kpiData.push(["Ménage", "{{ facture.heuresMENA }} h"]);{% endif %}
        kpiData.push(["Interventions", "{{ facture.nbInterventions }}"]);
        kpiData.push(["Montant total dû", "{{ facture.montantTotal|number_format(2, ',', ' ') }} €"]);

        const kpiColW = 182 / kpiData.length;
        kpiData.forEach(([label, value], i) => {
            const x = 14 + i * kpiColW;
            doc.setFillColor(255, 255, 255);
            doc.setDrawColor(...BORDER);
            doc.setLineWidth(0.2);
            doc.roundedRect(x, y, kpiColW - 2, 14, 1, 1, 'FD');
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7.5);
            doc.setTextColor(...GRAY);
            doc.text(label.toUpperCase(), x + (kpiColW - 2) / 2, y + 5, {align: 'center'});
            const isLast = (i === kpiData.length - 1);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(isLast ? 12 : 11);
            doc.setTextColor(...(isLast ? GREEN : BLUE));
            doc.text(value, x + (kpiColW - 2) / 2, y + 11, {align: 'center'});
        });

        y += 18;

        // ── Prestations GE ───────────────────────────────────────────────
        const tableGE = document.getElementById('pdf-table-ge');
        if (tableGE) {
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9);
            doc.setTextColor(...BLUE);
            doc.text("GARDE D'ENFANTS — {{ facture.heuresGE }} h × {{ facture.tauxGE|number_format(2, ',') }} €/h = {{ facture.montantGE|number_format(2, ',') }} €", 14, y);
            y += 3;
            doc.setDrawColor(...BLUE);
            doc.setLineWidth(0.2);
            doc.line(14, y, 196, y);
            y += 2;

            doc.autoTable({
                html: '#pdf-table-ge',
                startY: y,
                theme: 'plain',
                styles: cellStyles,
                headStyles: headStyles,
                columnStyles: {
                    0: { cellWidth: 22 },
                    1: { cellWidth: 16 },
                    2: { cellWidth: 16 },
                    3: { cellWidth: 18, halign: 'right' },
                    4: { cellWidth: 18, halign: 'right' },
                    5: { cellWidth: 18, halign: 'right' },
                },
                margin: { left: 14, right: 14 },
            });
            y = doc.lastAutoTable.finalY + 6;
        }

        // ── Prestations MENA ─────────────────────────────────────────────
        const tableMENA = document.getElementById('pdf-table-mena');
        if (tableMENA) {
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9);
            doc.setTextColor(...BLUE);
            doc.text("MÉNAGE — {{ facture.heuresMENA }} h × {{ facture.tauxMENA|number_format(2, ',') }} €/h = {{ facture.montantMENA|number_format(2, ',') }} €", 14, y);
            y += 3;
            doc.setDrawColor(...BLUE);
            doc.setLineWidth(0.2);
            doc.line(14, y, 196, y);
            y += 2;

            doc.autoTable({
                html: '#pdf-table-mena',
                startY: y,
                theme: 'plain',
                styles: cellStyles,
                headStyles: headStyles,
                columnStyles: {
                    0: { cellWidth: 22 },
                    1: { cellWidth: 16 },
                    2: { cellWidth: 16 },
                    3: { cellWidth: 18, halign: 'right' },
                    4: { cellWidth: 18, halign: 'right' },
                },
                margin: { left: 14, right: 14 },
            });
            y = doc.lastAutoTable.finalY + 6;
        }

        // ── Récapitulatif financier ───────────────────────────────────────
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(...BLUE);
        doc.text('RÉCAPITULATIF FINANCIER', 14, y);
        y += 3;
        doc.setDrawColor(...BLUE);
        doc.setLineWidth(0.2);
        doc.line(14, y, 196, y);
        y += 2;

        doc.autoTable({
            html: '#pdf-table-recap',
            startY: y,
            theme: 'plain',
            styles: { ...cellStyles, fontSize: 10 },
            headStyles: headStyles,
            columnStyles: {
                0: { cellWidth: 140 },
                1: { cellWidth: 38, halign: 'right', fontStyle: 'bold' },
            },
            margin: { left: 14, right: 14 },
            didParseCell: function(data) {
                if (data.section === 'foot') {
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.fontSize = 12;
                    data.cell.styles.lineWidth = { top: 0.4, bottom: 0, left: 0, right: 0 };
                    data.cell.styles.lineColor = BLACK;
                    if (data.column.index === 1) data.cell.styles.textColor = GREEN;
                }
            }
        });
        y = doc.lastAutoTable.finalY + 8;

        // ── Questionnaire de satisfaction ─────────────────────────────────
        // Nouvelle page si peu de place
        if (y > 230) { doc.addPage(); y = 15; }

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(...BLUE);
        doc.text('QUESTIONNAIRE DE SATISFACTION — ' + MOIS_LABEL.toUpperCase(), 14, y);
        y += 3;
        doc.setDrawColor(...BLUE);
        doc.setLineWidth(0.2);
        doc.line(14, y, 196, y);
        y += 2;

        doc.autoTable({
            html: '#pdf-table-satis',
            startY: y,
            theme: 'plain',
            styles: { ...cellStyles, fontSize: 10 },
            headStyles: headStyles,
            columnStyles: {
                0: { cellWidth: 80 },
                1: { cellWidth: 100 },
            },
            margin: { left: 14, right: 14 },
        });
        y = doc.lastAutoTable.finalY + 8;

        // ── Zone paiement ─────────────────────────────────────────────────
        if (y > 240) { doc.addPage(); y = 15; }

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(...BLUE);
        doc.text('PAIEMENT', 14, y);
        y += 3;
        doc.setDrawColor(...BLUE);
        doc.setLineWidth(0.2);
        doc.line(14, y, 196, y);
        y += 2;

        doc.autoTable({
            html: '#pdf-table-paiement',
            startY: y,
            theme: 'plain',
            styles: cellStyles,
            headStyles: headStyles,
            columnStyles: {
                0: { cellWidth: 60 },
                1: { cellWidth: 120 },
            },
            margin: { left: 14, right: 14 },
        });
        y = doc.lastAutoTable.finalY + 10;

        // ── Signatures ────────────────────────────────────────────────────
        if (y > 260) { doc.addPage(); y = 15; }

        const sigLabels = ['Signature de la famille', "Signature de l'intervenant(e)", 'Cachet / visa association'];
        const sigW = 56;
        sigLabels.forEach((label, i) => {
            const x = 14 + i * (sigW + 4);
            doc.setDrawColor(...BORDER);
            doc.setLineWidth(0.3);
            doc.rect(x, y, sigW, 22);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7.5);
            doc.setTextColor(...GRAY);
            doc.text(label.toUpperCase(), x + sigW / 2, y + 4, {align: 'center'});
        });
        y += 28;

        // ── Pied de page ──────────────────────────────────────────────────
        const pageCount = doc.internal.getNumberOfPages();
        for (let p = 1; p <= pageCount; p++) {
            doc.setPage(p);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7.5);
            doc.setTextColor(...GRAY);
            doc.text(
                'Association Chaudoudoux — Document généré automatiquement — ' + new Date().toLocaleDateString('fr-FR', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}),
                14, 291
            );
            doc.text('Page ' + p + ' / ' + pageCount, 196, 291, {align: 'right'});
        }

        // ── Sauvegarde ────────────────────────────────────────────────────
        doc.save('facture-' + FAM_NUM + '-' + MOIS_ANNEE + '.pdf');
        status.textContent = '✓ PDF généré avec succès';
        status.style.color = '#059669';

    } catch (e) {
        console.error('[genererFacturePDF]', e);
        status.textContent = 'Erreur : ' + e.message;
        status.style.color = '#dc2626';
    } finally {
        btn.disabled = false;
        btn.textContent = '📄 Générer PDF';
    }
}

// Génération automatique si ?auto=1
if (new URLSearchParams(window.location.search).get('auto') === '1') {
    window.addEventListener('load', () => setTimeout(genererFacturePDF, 500));
}
</script>

</body>
</html>
