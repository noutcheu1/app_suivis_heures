{% extends 'base.html.twig' %}
{% block title %}Gestion des tarifs{% endblock %}
{% block page_title %}Tarifs{% endblock %}

{% block body %}

<div class="page-header">
    <h1>Grilles tarifaires</h1>
    <p>Chaque modification crée une nouvelle version horodatée — les anciennes restent archivées.</p>
</div>

{# ── Flash messages ──────────────────────────────────────────────────────── #}
{% for msg in app.flashes('success') %}
<div class="alert alert-success mb-3" style="background:var(--success-bg);border:1px solid #a7f3d0;color:#065f46;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-check-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger mb-3" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
</div>
{% endfor %}

{# ── Tarif actif ──────────────────────────────────────────────────────────── #}
{% if tarifActif %}
<div class="card mb-4" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;">
    <h2 style="font-size:15px;font-weight:700;margin:0 0 16px;color:var(--text);display:flex;align-items:center;gap:8px;">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:var(--success-bg);border-radius:50%;">
            <i class="fas fa-circle-check" style="font-size:12px;color:var(--success);"></i>
        </span>
        Tarif actif — en vigueur depuis {{ tarifActif.dateDebut }}
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;">
        <div class="kpi-card" style="padding:12px;">
            <div class="kpi-label">Frais / intervention</div>
            <div class="kpi-value" style="font-size:18px;">{{ tarifActif.parIntervention }} €</div>
        </div>
        <div class="kpi-card" style="padding:12px;">
            <div class="kpi-label">Plafond frais</div>
            <div class="kpi-value" style="font-size:18px;">{{ tarifActif.maxParIntervention }} €</div>
        </div>
        <div class="kpi-card" style="padding:12px;">
            <div class="kpi-label">KM avec enfants</div>
            <div class="kpi-value" style="font-size:18px;">{{ tarifActif.kmEnfants }} €/km</div>
        </div>
        <div class="kpi-card" style="padding:12px;">
            <div class="kpi-label">Abonnement mensuel</div>
            <div class="kpi-value" style="font-size:18px;">{{ tarifActif.abonnement }} €</div>
        </div>
    </div>
</div>
{% else %}
<div class="alert alert-danger mb-4" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:14px 18px;">
    <i class="fas fa-triangle-exclamation me-2"></i>
    <strong>Aucun tarif configuré.</strong> Le calcul des factures est impossible tant qu'aucun tarif n'est enregistré. Créez une première version ci-dessous.
</div>
{% endif %}

{# ── Formulaire nouvelle version ─────────────────────────────────────────── #}
<div class="card mb-4" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-md);padding:24px;">
    <h2 style="font-size:15px;font-weight:700;margin:0 0 20px;color:var(--text);">
        <i class="fas fa-plus-circle me-2" style="color:var(--primary);"></i>
        Nouvelle version tarifaire
    </h2>

    <form method="POST" action="{{ path('admin_tarifs_creer_mvc') }}">

        {# Mois de prise en compte #}
        <div class="mb-4">
            <label class="form-label fw-600" style="font-weight:600;">Mois d'entrée en vigueur</label>
            <input type="month" name="dateDebut" class="form-control" style="max-width:220px;"
                   value="{{ formDefaults.dateDebut ?? '' }}" required>
            <div class="form-text text-muted">Le tarif s'appliquera à tous les récapitulatifs de ce mois et des mois suivants (jusqu'à la prochaine version).</div>
        </div>

        {# ── Taux horaire Garde d'Enfants ──────────────────────────────── #}
        {% if nbrPalierGE > 0 %}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 12px;">
            Taux horaire — Garde d'Enfants (GE)
        </h3>
        <div class="table-wrapper mb-4">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tranche d'heures mensuel</th>
                    <th style="width:160px;">Taux (€/h)</th>
                </tr>
            </thead>
            <tbody>
            {% for i in 1..nbrPalierGE %}
                <tr>
                    {% if i == 1 %}
                    <td>
                        <span style="color:var(--text-muted);">≥</span>
                        <input type="number" name="heures_max_GE_1" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_GE_1'] ?? 16 }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h&nbsp;&nbsp;<span class="badge" style="background:#f0f9ff;color:#0ea5e9;">Taux variable (Access)</span>
                        <input type="hidden" name="tarif_GE_1" value="V">
                    </td>
                    <td><span style="color:var(--text-muted);font-size:12px;">défini par famille</span></td>
                    {% elseif i == nbrPalierGE %}
                    <td>
                        &lt;&nbsp;
                        <input type="number" name="heures_max_GE_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_GE_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="tarif_GE_{{ i }}" step="0.01" min="0"
                                   value="{{ formDefaults['tarif_GE_' ~ i] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€/h</span>
                        </div>
                    </td>
                    {% else %}
                    <td>
                        <span style="color:var(--text-muted);">≥</span>
                        <input type="number" name="heures_min_GE_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_min_GE_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h &nbsp;et&nbsp; &lt;&nbsp;
                        <input type="number" name="heures_max_GE_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_GE_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="tarif_GE_{{ i }}" step="0.01" min="0"
                                   value="{{ formDefaults['tarif_GE_' ~ i] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€/h</span>
                        </div>
                    </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% endif %}

        {# ── Taux horaire Ménage ───────────────────────────────────────── #}
        {% if nbrPalierM > 0 %}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 12px;">
            Taux horaire — Ménage (M)
        </h3>
        <div class="table-wrapper mb-4">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tranche d'heures mensuel</th>
                    <th style="width:160px;">Taux (€/h)</th>
                </tr>
            </thead>
            <tbody>
            {% for i in 1..nbrPalierM %}
                <tr>
                    {% if i == 1 %}
                    <td>
                        <span style="color:var(--text-muted);">≥</span>
                        <input type="number" name="heures_max_M_1" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_M_1'] ?? 16 }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h&nbsp;&nbsp;<span class="badge" style="background:#f0f9ff;color:#0ea5e9;">Taux variable (Access)</span>
                        <input type="hidden" name="tarif_M_1" value="V">
                    </td>
                    <td><span style="color:var(--text-muted);font-size:12px;">défini par famille</span></td>
                    {% elseif i == nbrPalierM %}
                    <td>
                        &lt;&nbsp;
                        <input type="number" name="heures_max_M_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_M_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="tarif_M_{{ i }}" step="0.01" min="0"
                                   value="{{ formDefaults['tarif_M_' ~ i] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€/h</span>
                        </div>
                    </td>
                    {% else %}
                    <td>
                        <span style="color:var(--text-muted);">≥</span>
                        <input type="number" name="heures_min_M_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_min_M_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h &nbsp;et&nbsp; &lt;&nbsp;
                        <input type="number" name="heures_max_M_{{ i }}" step="0.5" min="0"
                               value="{{ formDefaults['heures_max_M_' ~ i] ?? '' }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="tarif_M_{{ i }}" step="0.01" min="0"
                                   value="{{ formDefaults['tarif_M_' ~ i] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€/h</span>
                        </div>
                    </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
        <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;">
            <i class="fas fa-info-circle me-1"></i>
            Ménage : 0 palier configuré (<code>nbrPalierTarifM = 0</code>) — taux entièrement variable (Access).
        </p>
        {% endif %}

        {# ── Frais de gestion GE ──────────────────────────────────────── #}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 12px;">
            Frais de gestion — Garde d'Enfants
        </h3>
        <div class="table-wrapper mb-4">
        <table class="data-table">
            <thead>
                <tr><th>Condition</th><th>Seuil heures / mois</th><th style="width:160px;">Montant (€)</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Enfant <strong>≥ 6 ans</strong></td>
                    <td>
                        &lt;&nbsp;
                        <input type="number" name="gestion_heure_1" step="0.5" min="0"
                               value="{{ formDefaults['gestion_heure_1'] ?? 25 }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="gestion_tarif_1" step="0.01" min="0"
                                   value="{{ formDefaults['gestion_tarif_1'] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>Enfant <strong>&lt; 6 ans</strong></td>
                    <td>
                        &lt;&nbsp;
                        <input type="number" name="gestion_heure_2" step="0.5" min="0"
                               value="{{ formDefaults['gestion_heure_2'] ?? 20 }}"
                               style="width:70px;" class="form-control d-inline-block" required>
                        h
                    </td>
                    <td>
                        <div class="input-group" style="max-width:140px;">
                            <input type="number" name="gestion_tarif_2" step="0.01" min="0"
                                   value="{{ formDefaults['gestion_tarif_2'] ?? '' }}"
                                   class="form-control" required>
                            <span class="input-group-text">€</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        </div>

        {# ── Frais fixes ──────────────────────────────────────────────── #}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 12px;">
            Frais fixes
        </h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-bottom:24px;">

            <div>
                <label class="form-label">Frais par intervention (€)</label>
                <div class="input-group">
                    <input type="number" name="parIntervention" step="0.01" min="0"
                           value="{{ formDefaults['parIntervention'] ?? '' }}"
                           class="form-control" required>
                    <span class="input-group-text">€</span>
                </div>
            </div>

            <div>
                <label class="form-label">Plafond frais / intervention (€)</label>
                <div class="input-group">
                    <input type="number" name="maxParIntervention" step="0.01" min="0"
                           value="{{ formDefaults['maxParIntervention'] ?? '' }}"
                           class="form-control" required>
                    <span class="input-group-text">€</span>
                </div>
                <div class="form-text text-muted">Pour familles Rennes + GE</div>
            </div>

            <div>
                <label class="form-label">Remboursement km avec enfants</label>
                <div class="input-group">
                    <input type="number" name="kmEnfants" step="0.01" min="0"
                           value="{{ formDefaults['kmEnfants'] ?? '' }}"
                           class="form-control" required>
                    <span class="input-group-text">€/km</span>
                </div>
            </div>

            <div>
                <label class="form-label">Abonnement mensuel (€)</label>
                <div class="input-group">
                    <input type="number" name="abonnement" step="0.01" min="0"
                           value="{{ formDefaults['abonnement'] ?? '' }}"
                           class="form-control" required>
                    <span class="input-group-text">€</span>
                </div>
            </div>

        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-floppy-disk me-2"></i>Enregistrer cette version
        </button>
        <span style="font-size:12px;color:var(--text-muted);margin-left:12px;">
            Les anciens tarifs ne sont pas supprimés — un nouvel enregistrement est créé.
        </span>

    </form>
</div>

{# ── Historique ─────────────────────────────────────────────────────────── #}
{% if tarifs|length > 1 %}
<div class="card" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-md);padding:24px;">
    <h2 style="font-size:15px;font-weight:700;margin:0 0 16px;color:var(--text);">
        <i class="fas fa-clock-rotate-left me-2" style="color:var(--text-muted);"></i>
        Historique des versions ({{ tarifs|length }})
    </h2>
    <div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mois d'entrée en vigueur</th>
                <th>Frais / interv.</th>
                <th>Plafond</th>
                <th>KM enfants</th>
                <th>Abonnement</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
        {% for tarif in tarifs %}
        <tr {% if loop.first %}style="background:var(--success-bg);"{% endif %}>
            <td><strong>{{ tarif.dateDebut }}</strong></td>
            <td>{{ tarif.parIntervention }} €</td>
            <td>{{ tarif.maxParIntervention }} €</td>
            <td>{{ tarif.kmEnfants }} €/km</td>
            <td>{{ tarif.abonnement }} €</td>
            <td>
                {% if loop.first %}
                <span class="badge" style="background:var(--success-bg);color:var(--success);border:1px solid #a7f3d0;">
                    <i class="fas fa-circle-check me-1"></i>Actif
                </span>
                {% else %}
                <span class="badge badge-muted">Archivé</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{% endblock %}
