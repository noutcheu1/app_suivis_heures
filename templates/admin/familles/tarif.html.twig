{% extends 'base.html.twig' %}
{% block title %}Tarif {{ famille.nomFamille ?? famille.numeroFamille }}{% endblock %}
{% block page_title %}Tarif famille{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>Taux horaire {{ famille_label(famille) }}</h1>
            <p>
                <code style="font-size:12px;color:var(--text-muted);">{{ famille.numeroFamille }}</code>
                &nbsp;· Chaque modification crée une nouvelle version horodatée.
            </p>
        </div>
        <a href="{{ path('admin_famille_detail_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Retour au détail
        </a>
    </div>
</div>

{# ── Flash messages ───────────────────────────────────────────────────────── #}
{% for msg in app.flashes('success') %}
<div class="alert alert-success mb-3" style="background:var(--success-bg);border:1px solid #a7f3d0;color:#065f46;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-check-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger mb-3" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
</div>
{% endfor %}

{# ── Taux actifs ──────────────────────────────────────────────────────────── #}
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-bottom:24px;">

    <div class="card" style="padding:20px;">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;">
            Garde d'enfants (GE)
        </div>
        {% if tarifGEActif %}
        <div style="font-size:26px;font-weight:800;color:var(--primary);">{{ tarifGEActif.tauxHoraire }} <span style="font-size:15px;font-weight:500;">€/h</span></div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Depuis {{ tarifGEActif.dateDebut }}</div>
        {% else %}
        <div style="font-size:14px;color:var(--text-muted);font-style:italic;">Taux standard (grille globale)</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;">
            Ménage (M)
        </div>
        {% if tarifMActif %}
        <div style="font-size:26px;font-weight:800;color:var(--primary);">{{ tarifMActif.tauxHoraire }} <span style="font-size:15px;font-weight:500;">€/h</span></div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Depuis {{ tarifMActif.dateDebut }}</div>
        {% else %}
        <div style="font-size:14px;color:var(--text-muted);font-style:italic;">Taux standard (grille globale)</div>
        {% endif %}
    </div>

</div>

{# ── Formulaire nouveau taux ──────────────────────────────────────────────── #}
<div class="card mb-4" style="padding:24px;">
    <h2 style="font-size:15px;font-weight:700;margin:0 0 20px;color:var(--text);">
        <i class="fas fa-plus-circle me-2" style="color:var(--primary);"></i>
        Définir un nouveau taux horaire
    </h2>
    <form method="POST" action="{{ path('famille_tarif_creer_mvc', {numFam: famille.numeroFamille}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('tarif_famille_creer') }}">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;align-items:end;">

            <div>
                <label class="form-label" style="font-weight:600;font-size:13px;">Type de prestation</label>
                <select name="typePresta" class="form-control" required>
                    <option value="GE">Garde d'enfants (GE)</option>
                    <option value="M">Ménage (M)</option>
                </select>
            </div>

            <div>
                <label class="form-label" style="font-weight:600;font-size:13px;">Taux horaire (€/h)</label>
                <div class="input-group">
                    <input type="number" name="tauxHoraire" step="0.01" min="0" class="form-control"
                           placeholder="ex. 12.50" required>
                    <span class="input-group-text">€/h</span>
                </div>
            </div>

            <div>
                <label class="form-label" style="font-weight:600;font-size:13px;">Mois d'entrée en vigueur</label>
                <input type="month" name="dateDebut" class="form-control"
                       value="{{ 'now'|date('Y-m') }}" required>
            </div>

            <div>
                <button type="submit" class="btn btn-primary" style="width:100%;">
                    <i class="fas fa-floppy-disk me-2"></i>Enregistrer
                </button>
            </div>

        </div>
        <p style="font-size:12px;color:var(--text-muted);margin-top:10px;">
            Les anciennes versions sont conservées un nouvel enregistrement horodaté est créé.
        </p>
    </form>
</div>

{# ── Historique ───────────────────────────────────────────────────────────── #}
<div class="card" style="padding:24px;">
    <h2 style="font-size:15px;font-weight:700;margin:0 0 16px;color:var(--text);">
        <i class="fas fa-clock-rotate-left me-2" style="color:var(--text-muted);"></i>
        Historique des taux ({{ tarifs|length }})
    </h2>

    {% if tarifs is empty %}
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-tags"></i></div>
        <h3>Aucun taux spécifique défini</h3>
        <p>Cette famille utilise la grille tarifaire globale</p>
    </div>
    {% else %}
    <div style="overflow-x:auto;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mois d'entrée</th>
                <th>Type</th>
                <th>Taux (€/h)</th>
                <th>Statut</th>
            </tr>
        </thead>
        {% set activeGEId = tarifGEActif ? tarifGEActif.id : null %}
        {% set activeMId  = tarifMActif  ? tarifMActif.id  : null %}
        <tbody>
        {% for tarif in tarifs %}
            {% set isActif = (tarif.id == activeGEId) or (tarif.id == activeMId) %}
            <tr {% if isActif %}style="background:var(--success-bg);"{% endif %}>
                <td><strong>{{ tarif.dateDebut }}</strong></td>
                <td>
                    <span class="badge {{ tarif.typePresta in ['GE','ENFA'] ? 'badge-info' : 'badge-muted' }}">
                        {{ tarif.labelPresta }}
                    </span>
                </td>
                <td><strong>{{ tarif.tauxHoraire }} €/h</strong></td>
                <td>
                    {% if isActif %}
                    <span class="badge" style="background:var(--success-bg);color:var(--success);border:1px solid #a7f3d0;">
                        <i class="fas fa-circle-check me-1"></i>Actif
                    </span>
                    {% else %}
                    <span class="badge badge-muted">Archivé</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

</div>

{% endblock %}
