{% extends 'base.html.twig' %}
{% block title %}Familles{% endblock %}
{% block page_title %}Familles{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    #familleTable th, #familleTable td {
        font-size: 16px;
        padding: 14px 16px;
    }
    #familleTable th { font-weight: 700; }
    #familleTable tbody tr:hover { background: var(--primary-light); }
    .btn-voir { font-size: 15px; padding: 8px 18px; font-weight: 600; }
    #searchInput {
        font-size: 16px;
        padding: 10px 16px 10px 40px;
        border: 2px solid var(--border);
        border-radius: var(--radius-md);
        width: 100%;
        max-width: 400px;
    }
    #searchInput:focus { outline: none; border-color: var(--primary); }

    /* Switch inline */
    .switch-inline { position:relative; display:inline-block; width:46px; height:26px; }
    .switch-inline input { opacity:0; width:0; height:0; }
    .slider-inline {
        position:absolute; cursor:pointer; inset:0;
        background:#d1d5db; border-radius:999px; transition:.2s;
    }
    .slider-inline::before {
        content:""; position:absolute;
        width:20px; height:20px; left:3px; top:3px;
        background:#fff; border-radius:50%; transition:.2s;
        box-shadow:0 1px 3px rgba(0,0,0,.2);
    }
    .switch-inline input:checked + .slider-inline { background:#22c55e; }
    .switch-inline input:checked + .slider-inline::before { transform:translateX(20px); }
    .switch-inline input:disabled + .slider-inline { opacity:.5; cursor:default; }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1 style="font-size:26px;">Familles</h1>
            <p style="font-size:16px;">{{ users|length }} famille{% if users|length > 1 %}s{% endif %}</p>
        </div>
        <a href="{{ path('admin_familles_mvc') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="table-wrapper">

    <div class="table-toolbar" style="margin-bottom:20px;">
        <div class="table-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Rechercher une famille…" oninput="filterRows()">
        </div>
    </div>

    {% if users is empty %}
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-users"></i></div>
        <h3 style="font-size:20px;">Aucune famille trouvée</h3>
    </div>
    {% else %}

    <table class="data-table" id="familleTable">
        <thead>
            <tr>
                <th data-sort-col="0">Famille</th>
                <th data-sort-col="1">N° famille</th>
                <th data-sort-col="2">Identifiant</th>
                <th data-sort-col="3">Statut</th>
                {% if kmType %}<th>km SI FAMILLE <br> A RENNES</th>{% endif %}
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
        {% set estRennes = user.ville|lower == 'rennes' %}
        {% set exKm = kmType and estRennes and (kmExonerations[user.numeroFamille][kmType] ?? false) %}
        <tr>
            <td style="font-weight:600;">{{ famille_label(user) }}</td>
            <td>{{ user.numeroFamille }}</td>
            <td>
                {% if user.pmFamille %}{{ user.pmFamille }}{% endif %}
                {% if user.pgeFamille %}{{ user.pgeFamille }}{% endif %}
            </td>
            <td>
                {% if user.archive %}
                    <span class="badge badge-danger" style="font-size:14px;">Archivée</span>
                {% else %}
                    <span class="badge badge-success" style="font-size:14px;">Active</span>
                {% endif %}
            </td>
            {% if kmType %}
            <td>
                {% if estRennes %}
                <label class="switch-inline" title="{{ exKm ? 'Désactiver' : 'Activer' }} frais km">
                    <input type="checkbox"
                           {{ exKm ? 'checked' : '' }}
                           onchange="toggleKmInline(this, '{{ user.numeroFamille }}', '{{ kmType }}')">
                    <span class="slider-inline"></span>
                </label>
                {% else %}
                <span style="color:var(--text-muted);font-size:13px;">—</span>
                {% endif %}
            </td>
            {% endif %}
            <td>
                <a href="{{ path('admin_famille_detail_mvc', {numFam: user.numeroFamille}) }}"
                   class="btn btn-primary btn-voir">
                    <i class="fas fa-eye"></i> Voir
                </a>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

    {% endif %}

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function filterRows() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#familleTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function toggleKmInline(sw, numFam, type) {
    sw.disabled = true;
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
    try {
        const resp = await fetch(`/familles-mvc/${numFam}/toggle-km/${type}`, {
            method: 'POST',
            headers: { 'X-CSRF-Token': csrf }
        });
        const data = await resp.json();
        sw.checked = data.exonereKm;
    } catch (e) {
        sw.checked = !sw.checked; // annuler si erreur
    }
    sw.disabled = false;
}

const tbody = document.querySelector('#familleTable tbody');
if (tbody) {
    document.querySelectorAll('#familleTable thead th[data-sort-col]').forEach(th => {
        const col = parseInt(th.dataset.sortCol);
        th.style.cursor = 'pointer';
        th.addEventListener('click', function () {
            this.asc = !this.asc;
            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) => {
                const v1 = a.children[col]?.textContent.trim() ?? '';
                const v2 = b.children[col]?.textContent.trim() ?? '';
                return this.asc ? v1.localeCompare(v2) : v2.localeCompare(v1);
            });
            rows.forEach(r => tbody.appendChild(r));
        });
    });
}
</script>
{% endblock %}
