{% extends 'base.html.twig' %}
{% block title %} {{ famille.nomFamille ?? famille.numeroFamille ?? '' }}{% endblock %}
{% block page_title %}Détail famille{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>{{ famille_label(famille) }}</h1>
            <p>
                <code style="font-size:12px;color:var(--text-muted);">{{ famille.numeroFamille }}</code>
            </p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a href="{{ path('famille_admin_panel_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-primary btn-sm">
                <i class="fas fa-house"></i> Dashboard famille
            </a>
            <a href="{{ path('famille_tarif_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-tags"></i> Taux horaire
            </a>
            <a href="{{ path('admin_familles_mvc') }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour aux familles
            </a>
        </div>
    </div>
</div>

{# ── Flash messages ───────────────────────────────────────────────────────── #}
{% for msg in app.flashes('success') %}
<div class="alert alert-success mb-3" style="background:var(--success-bg);border:1px solid #a7f3d0;color:#065f46;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-check-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger mb-3" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('warning') %}
<div class="alert alert-warning mb-3" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-triangle-exclamation me-2"></i>{{ msg }}
</div>
{% endfor %}

{# ── Info famille ─────────────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-house-user" style="color:var(--primary);"></i>
        <span class="card-title">Informations famille</span>
    </div>
    <div class="card-body">
        {% set dt_style = "color:var(--text-muted);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;" %}
        <dl style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px 24px;font-size:13.5px;margin:0 0 16px;">
            <div>
                <dt style="{{ dt_style }}">N° client</dt>
                <dd style="margin:0;font-weight:600;">{{ famille.numeroFamille }}</dd>
            </div>
            {% if famille.adresse %}
            <div>
                <dt style="{{ dt_style }}">Adresse</dt>
                <dd style="margin:0;">{{ famille.adresse }}{% if famille.codePostal %}, {{ famille.codePostal }}{% endif %}{% if famille.ville %} {{ famille.ville }}{% endif %}</dd>
            </div>
            {% endif %}
            {% if famille.telDom %}
            <div>
                <dt style="{{ dt_style }}">Tél. domicile</dt>
                <dd style="margin:0;">{{ famille.telDom }}</dd>
            </div>
            {% endif %}
            {% if famille.modePaiement is defined and famille.modePaiement %}
            <div>
                <dt style="{{ dt_style }}">Mode de paiement</dt>
                <dd style="margin:0;">{{ famille.modePaiement }}</dd>
            </div>
            {% endif %}
        </dl>

        {# ── Parents ── #}
        {% if parents is not empty %}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 10px;padding-top:12px;border-top:1px solid var(--border);">
            <i class="fas fa-user-friends" style="margin-right:6px;"></i>Parents / Contacts
        </h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
        {% for parent in parents %}
            <div style="background:var(--bg-subtle,#f9fafb);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px;">
                <div style="font-weight:700;font-size:13.5px;margin-bottom:8px;">
                    {{ parent.nomComplet }}
                    {% if parent.profession %}
                        <span style="font-weight:400;font-size:11px;color:var(--text-muted);margin-left:6px;">— {{ parent.profession }}</span>
                    {% endif %}
                </div>
                <dl style="margin:0;display:grid;gap:4px;font-size:12.5px;">
                    {% if parent.telPortable %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Portable</dt>
                        <dd style="margin:0;"><a href="tel:{{ parent.telPortable }}">{{ parent.telPortable }}</a></dd>
                    </div>
                    {% endif %}
                    {% if parent.telTravail %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Travail</dt>
                        <dd style="margin:0;"><a href="tel:{{ parent.telTravail }}">{{ parent.telTravail }}</a></dd>
                    </div>
                    {% endif %}
                    {% if parent.email %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Email</dt>
                        <dd style="margin:0;"><a href="mailto:{{ parent.email }}">{{ parent.email }}</a></dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        {% endfor %}
        </div>
        {% else %}
        <p style="font-size:13px;color:var(--text-muted);margin:12px 0 0;padding-top:12px;border-top:1px solid var(--border);">
            <i class="fas fa-info-circle"></i> Aucun parent enregistré pour cette famille.
        </p>
        {% endif %}
    </div>
</div>

{# ── Ajouter un planning ──────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-calendar-plus" style="color:var(--primary);"></i>
        <span class="card-title">Ajouter un planning</span>
    </div>
    <div class="card-body">
        <form method="POST" action="{{ path('admin_ajouter_planning_mvc', {numFam: famille.numeroFamille}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('ajouter_planning') }}">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;align-items:end;">

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Intervenant</label>
                    <select name="numInter" class="form-control" required>
                        <option value="">— Choisir —</option>
                        {% for inter in intervenants %}
                        <option value="{{ inter.id }}">{{ inter.nomCompletInter }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Type</label>
                    <select name="typePrestation" class="form-control">
                        <option value="ENFA">Garde d'enfants</option>
                        <option value="MENA">Ménage</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Jour</label>
                    <select name="jour" class="form-control" required>
                        <option value="lundi">Lundi</option>
                        <option value="mardi">Mardi</option>
                        <option value="mercredi">Mercredi</option>
                        <option value="jeudi">Jeudi</option>
                        <option value="vendredi">Vendredi</option>
                        <option value="samedi">Samedi</option>
                        <option value="dimanche">Dimanche</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Heure début</label>
                    <input type="time" name="heureDebut" class="form-control" value="09:00" required>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Heure fin</label>
                    <input type="time" name="heureFin" class="form-control" value="12:00">
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Date début</label>
                    <input type="date" name="dateDeb" class="form-control" value="{{ "now"|date("Y-m-d") }}" required>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Date fin <span style="font-weight:400;color:var(--text-muted);">(optionnel)</span></label>
                    <input type="date" name="dateFin" class="form-control">
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Fréquence</label>
                    <select name="frequence" class="form-control">
                        <option value="1">Hebdomadaire</option>
                        <option value="2">Bi-hebdomadaire</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" style="font-size:12px;font-weight:600;">Mode adhésion</label>
                    <select name="typeAdh" class="form-control" required>
                        {% for adh in typeAdhs %}
                        <option value="{{ adh.idADH_TypeADH }}" {{ adh.idADH_TypeADH == 'PREST' ? 'selected' : '' }}>{{ adh.intitule_TypeADH ?? adh.idADH_TypeADH }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary" style="width:100%;">
                        <i class="fas fa-plus"></i> Ajouter
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

{# ── Plannings actifs ─────────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-calendar-check" style="color:var(--primary);"></i>
        <span class="card-title">Plannings actifs</span>
        {% if plannings is not empty %}
        <span class="badge badge-muted" style="margin-left:auto;">{{ plannings|length }}</span>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">
        {% if plannings is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
            <h3>Aucun planning actif</h3>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Intervenant</th>
                    <th>Jour</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Type</th>
                    <th>Fréquence</th>
                    <th>Début contrat</th>
                    <th>Fin contrat</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
            {% for pl in plannings %}
            <tr>
                <td>{{ interMap[pl.numSalarie] ?? '#' ~ pl.numSalarie }}</td>
                <td style="text-transform:capitalize;">{{ pl.jour }}</td>
                <td>{{ pl.heureDebut|date('H:i') }}</td>
                <td>{{ pl.heureFin ? pl.heureFin|date('H:i') : '—' }}</td>
                <td>
                    <span class="badge {{ pl.typePrestation == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ pl.labelPrestation }}
                    </span>
                </td>
                <td>{{ pl.frequence == 2 ? 'Bi-hebdo' : 'Hebdo' }}</td>
                <td>{{ pl.dateDeb|date('d/m/Y') }}</td>
                <td>{{ pl.dateFin ? pl.dateFin|date('d/m/Y') : '—' }}</td>
                <td>
                    <span class="badge {{ pl.statut == 'Validé' ? 'badge-success' : 'badge-warning' }}">
                        {{ pl.statut ?? 'En attente' }}
                    </span>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
</div>

{# ── Prestations ──────────────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-clock" style="color:var(--primary);"></i>
        <span class="card-title">Prestations</span>
        {% if prestations is not empty %}
        <span class="badge badge-muted" style="margin-left:auto;">{{ prestations|length }}</span>
        {% endif %}
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">

        {% if prestations is empty %}
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
            <h3>Aucune prestation enregistrée</h3>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Intervenant</th>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Type</th>
                    <th>Déclaré famille</th>
                </tr>
            </thead>
            <tbody>
            {% for p in prestations %}
            <tr>
                <td>{{ interMap[p.numInter] }}</td>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta ? p.heureDebutPresta|date('H:i') : '—' }}</td>
                <td>{{ p.heureFinPresta ? p.heureFinPresta|date('H:i') : '—' }}</td>
                <td>
                    <span class="badge {{ p.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ p.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
                <td>
                    {% if p.declarerLeFam %}
                        <span class="badge badge-success">Déclaré</span>
                    {% else %}
                        <span class="badge badge-warning">Non déclaré</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</div>

{% endblock %}
