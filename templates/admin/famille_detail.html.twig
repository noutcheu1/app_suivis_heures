{% extends 'base.html.twig' %}
{% block title %} {{ famille.nomFamille ?? famille.numeroFamille ?? '' }}{% endblock %}
{% block page_title %}Détail famille{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>{{ famille_label(famille) }}</h1>
            <p>
                <code style="font-size:12px;color:var(--text-muted);">{{ famille.numeroFamille }}</code>
            </p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a href="{{ path('famille_admin_panel_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-primary btn-sm">
                <i class="fas fa-house"></i> Dashboard famille
            </a>
            <a href="{{ path('famille_tarif_mvc', {numFam: famille.numeroFamille}) }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-tags"></i> Taux horaire
            </a>
            <a href="{{ path('admin_familles_mvc') }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour aux familles
            </a>
        </div>
    </div>
</div>

{# ── Flash messages ───────────────────────────────────────────────────────── #}
{% for msg in app.flashes('success') %}
<div class="alert alert-success mb-3" style="background:var(--success-bg);border:1px solid #a7f3d0;color:#065f46;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-check-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div class="alert alert-danger mb-3" style="background:var(--danger-bg);border:1px solid #fecaca;color:#991b1b;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('warning') %}
<div class="alert alert-warning mb-3" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:var(--radius);padding:12px 16px;">
    <i class="fas fa-triangle-exclamation me-2"></i>{{ msg }}
</div>
{% endfor %}

{# ── Réponse à la campagne de congés (résumé simple) ─── #}
{% if reponseVacances %}
{% set moisFr = {1:'janvier',2:'février',3:'mars',4:'avril',5:'mai',6:'juin',7:'juillet',8:'août',9:'septembre',10:'octobre',11:'novembre',12:'décembre'} %}
<div class="card" style="margin-bottom:20px;border-left:4px solid #4f46e5;">
    <div class="card-body" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <div style="font-size:26px;">🏖️</div>
        <div style="flex:1;min-width:200px;">
            <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;">
                Vacances{% if campagneVacances %} — {{ campagneVacances.titre }}{% endif %}
            </div>
            {% if not reponseVacances.repondu %}
                <div style="font-size:15px;color:#b45309;font-weight:600;margin-top:4px;">
                    <i class="fas fa-hourglass-half"></i> Pas encore répondu
                </div>
            {% elseif reponseVacances.situation == 'absence' %}
                <div style="font-size:15px;color:#1e1b4b;font-weight:600;margin-top:4px;">
                    <i class="fas fa-plane-departure" style="color:#b45309;"></i> Absente
                    {% if reponseVacances.dateDebutAbsence %}du
                    <strong>{{ reponseVacances.dateDebutAbsence|date('j') }} {{ moisFr[reponseVacances.dateDebutAbsence|date('n')] }}</strong>
                    au
                    <strong>{{ reponseVacances.dateFinAbsence|date('j') }} {{ moisFr[reponseVacances.dateFinAbsence|date('n')] }} {{ reponseVacances.dateFinAbsence|date('Y') }}</strong>{% endif %}
                </div>
            {% elseif reponseVacances.situation == 'modification' %}
                <div style="font-size:15px;color:#1e1b4b;font-weight:600;margin-top:4px;">
                    <i class="fas fa-pen" style="color:#b45309;"></i> Souhaite adapter ses prestations
                    {% if reponseVacances.dateDebutAbsence %}(du
                    <strong>{{ reponseVacances.dateDebutAbsence|date('j') }} {{ moisFr[reponseVacances.dateDebutAbsence|date('n')] }}</strong>
                    au
                    <strong>{{ reponseVacances.dateFinAbsence|date('j') }} {{ moisFr[reponseVacances.dateFinAbsence|date('n')] }} {{ reponseVacances.dateFinAbsence|date('Y') }}</strong>){% endif %}
                </div>
            {% else %}
                <div style="font-size:15px;color:#15803d;font-weight:600;margin-top:4px;">
                    <i class="fas fa-check-circle"></i> Rien ne change (prestations habituelles)
                </div>
            {% endif %}
            {% if reponseVacances.commentaire %}
            <div style="font-size:13px;color:var(--text-muted);margin-top:6px;font-style:italic;">« {{ reponseVacances.commentaire }} »</div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}

{# ── Info famille ─────────────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-house-user" style="color:var(--primary);"></i>
        <span class="card-title">Informations famille</span>
    </div>
    <div class="card-body">
        {% set dt_style = "color:var(--text-muted);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;" %}
        <dl style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px 24px;font-size:13.5px;margin:0 0 16px;">
            <div>
                <dt style="{{ dt_style }}">N° client</dt>
                <dd style="margin:0;font-weight:600;">{{ famille.numeroFamille }}</dd>
            </div>
            {% if famille.adresse %}
            <div>
                <dt style="{{ dt_style }}">Adresse</dt>
                <dd style="margin:0;">{{ famille.adresse }}{% if famille.codePostal %}, {{ famille.codePostal }}{% endif %}{% if famille.ville %} {{ famille.ville }}{% endif %}</dd>
            </div>
            {% endif %}
            {% if famille.telDom %}
            <div>
                <dt style="{{ dt_style }}">Tél. domicile</dt>
                <dd style="margin:0;">{{ famille.telDom }}</dd>
            </div>
            {% endif %}
            {% if famille.modePaiement is defined and famille.modePaiement %}
            <div>
                <dt style="{{ dt_style }}">Mode de paiement</dt>
                <dd style="margin:0;">{{ famille.modePaiement }}</dd>
            </div>
            {% endif %}
        </dl>

        {# ── Parents ── #}
        {% if parents is not empty %}
        <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 10px;padding-top:12px;border-top:1px solid var(--border);">
            <i class="fas fa-user-friends" style="margin-right:6px;"></i>Parents / Contacts
        </h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
        {% for parent in parents %}
            <div style="background:var(--bg-subtle,#f9fafb);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px;">
                <div style="font-weight:700;font-size:13.5px;margin-bottom:8px;">
                    {{ parent.nomComplet }}
                    {% if parent.profession %}
                        <span style="font-weight:400;font-size:11px;color:var(--text-muted);margin-left:6px;">{{ parent.profession }}</span>
                    {% endif %}
                </div>
                <dl style="margin:0;display:grid;gap:4px;font-size:12.5px;">
                    {% if parent.telPortable %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Portable</dt>
                        <dd style="margin:0;"><a href="tel:{{ parent.telPortable }}">{{ parent.telPortable }}</a></dd>
                    </div>
                    {% endif %}
                    {% if parent.telTravail %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Travail</dt>
                        <dd style="margin:0;"><a href="tel:{{ parent.telTravail }}">{{ parent.telTravail }}</a></dd>
                    </div>
                    {% endif %}
                    {% if parent.email %}
                    <div style="display:flex;gap:8px;">
                        <dt style="color:var(--text-muted);min-width:90px;">Email</dt>
                        <dd style="margin:0;"><a href="mailto:{{ parent.email }}">{{ parent.email }}</a></dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        {% endfor %}
        </div>
        {% else %}
        <p style="font-size:13px;color:var(--text-muted);margin:12px 0 0;padding-top:12px;border-top:1px solid var(--border);">
            <i class="fas fa-info-circle"></i> Aucun parent enregistré pour cette famille.
        </p>
        {% endif %}
        
    </div>
</div>

{# ── Remplacements à prévoir (campagne active, seulement si impact réel) ─── #}
{% if remplacements %}
{% set moisR = {1:'janvier',2:'février',3:'mars',4:'avril',5:'mai',6:'juin',7:'juillet',8:'août',9:'septembre',10:'octobre',11:'novembre',12:'décembre'} %}
{% macro dfr(d, moisR) %}{{ d|date('j') }} {{ moisR[d|date('n')] }} {{ d|date('Y') }}{% endmacro %}
{% import _self as h %}
<div class="card" style="margin-bottom:20px;border-left:4px solid #f59e0b;">
    <div class="card-body">
        {# En-tête : la situation en une phrase claire #}
        <div style="display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:6px;">
            <div style="font-size:24px;line-height:1;">🔄</div>
            <div style="flex:1;min-width:220px;">
                <div style="font-size:16px;font-weight:700;color:var(--text);">
                    Remplacements à prévoir pour cette famille
                </div>
                <div style="font-size:13px;color:var(--text-muted);margin-top:2px;">
                    <strong>{{ remplacements.intervenantsAbsents }}</strong> intervenant{{ remplacements.intervenantsAbsents > 1 ? 's' : '' }}
                    de ménage {{ remplacements.intervenantsAbsents > 1 ? 'sont' : 'est' }} en congé —
                    <strong>{{ remplacements.interventions }}</strong> période{{ remplacements.interventions > 1 ? 's' : '' }} à couvrir.
                </div>
            </div>
        </div>

        {% for t in remplacements.trous %}
        {% set tno = loop.index %}
        <div style="border:1px solid var(--border,#e6e8f3);border-radius:12px;padding:14px 16px;margin-top:12px;">
            {# Qui est absent, et quand #}
            <div style="font-size:14.5px;">
                🧹 <strong>{{ t.interNom }}</strong>
                <span style="color:var(--text-muted);">assure le ménage ici et sera absente</span>
            </div>
            <div style="margin-top:6px;">
                <span style="display:inline-block;background:#fef3c7;color:#92400e;font-weight:700;font-size:12.5px;padding:3px 10px;border-radius:8px;">
                    du {{ h.dfr(t.debut, moisR) }} au {{ h.dfr(t.fin, moisR) }}
                </span>
                <span style="color:var(--text-muted);font-size:12.5px;margin-left:6px;">{{ t.creneaux|join(' · ') }}</span>
            </div>

            {# Qui peut la remplacer — actionnable #}
            <div style="margin-top:13px;padding-top:12px;border-top:1px dashed var(--border,#e6e8f3);">
                {% if t.suspend %}
                    <div style="font-size:13.5px;color:#b45309;font-weight:600;">
                        <i class="fas fa-pause"></i> La famille préfère suspendre le ménage sur cette période — aucun remplacement à organiser.
                    </div>
                {% elseif t.suggestions is empty %}
                    <div style="font-size:13.5px;color:#dc2626;font-weight:600;">
                        <i class="fas fa-triangle-exclamation"></i> Aucun remplaçant disponible pour le ménage — à traiter en priorité.
                    </div>
                {% else %}
                    <div style="font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);font-weight:700;margin-bottom:9px;">
                        {{ t.suggestions|length }} remplaçant{{ t.suggestions|length > 1 ? 's' : '' }} disponible{{ t.suggestions|length > 1 ? 's' : '' }} — à contacter
                    </div>
                    <div style="display:flex;flex-direction:column;gap:7px;">
                    {% for s in t.suggestions %}
                        {% if loop.index == 4 %}<div id="more-{{ tno }}" style="display:none;flex-direction:column;gap:7px;">{% endif %}
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13.5px;">
                            <span style="width:26px;height:26px;border-radius:50%;background:#eef2ff;color:#4f46e5;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;">
                                {{ s.nom|first|upper }}
                            </span>
                            <strong>{{ s.nom }}</strong>
                            {% if s.proche %}<span title="Même ville que la famille" style="background:#e9f9ef;color:#16a34a;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;"> même ville</span>{% endif %}
                            <span style="color:var(--text-muted);font-size:12px;">{{ s.charge }} famille{{ s.charge > 1 ? 's' : '' }}</span>
                            {% if s.tel %}<a href="tel:{{ s.tel }}" style="margin-left:auto;color:#4f46e5;font-weight:600;text-decoration:none;"><i class="fas fa-phone" style="font-size:11px;"></i> {{ s.tel }}</a>{% endif %}
                        </div>
                        {% if loop.last and t.suggestions|length > 3 %}</div>{% endif %}
                    {% endfor %}
                    </div>
                    {% if t.suggestions|length > 3 %}
                    <a href="#" onclick="var m=document.getElementById('more-{{ tno }}');m.style.display='flex';this.style.display='none';return false;"
                       style="display:inline-block;margin-top:8px;font-size:13px;color:#4f46e5;font-weight:600;text-decoration:none;">
                        + voir les {{ t.suggestions|length - 3 }} autres
                    </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{% endblock %}
