{% extends 'base.html.twig' %}
{% block title %}Intervenants{% endblock %}
{% block page_title %}Intervenants{% endblock %}

{% block body %}

<div class="page-header">
    <h1>Intervenants</h1>
    <p>{{ users|length }} intervenant{% if users|length > 1 %}s{% endif %} actif{% if users|length > 1 %}s{% endif %}</p>
</div>

<div class="table-wrapper">

    <div class="table-toolbar">
        <div class="table-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Rechercher un intervenant..." oninput="filterTable()">
        </div>
    </div>

    {% if users is empty %}
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-id-card"></i></div>
        <h3>Aucun intervenant</h3>
        <p>Aucun intervenant actif trouvé</p>
    </div>
    {% else %}
    <table class="data-table" id="intervenantTable">
        <thead>
            <tr>
                <th>Nom</th>
                <th>N° salarié</th>
                <th>Tél. portable</th>
                <th>Taux horaire</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
        <tr>
            <td>
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:32px;height:32px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas fa-{{ user.titre == 'MR' ? 'male' : 'female' }}" style="font-size:13px;color:var(--primary);"></i>
                    </div>
                    <div>
                        <div style="font-weight:600;">{{ user.nom }} {{ user.prenom }}</div>
                        {% if user.titre %}<div style="font-size:11px;color:var(--text-muted);">{{ user.titre }}</div>{% endif %}
                    </div>
                </div>
            </td>
            <td><code style="font-size:12px;background:var(--bg);padding:2px 6px;border-radius:4px;">{{ user.numSalarie ?? '—' }}</code></td>
            <td>{{ user.telPortable ?? '—' }}</td>
            <td>
                {% if user.tauxHoraire %}
                    <span class="badge badge-muted">{{ user.tauxHoraire }} €/h</span>
                {% else %}—{% endif %}
            </td>
            <td>
                <div style="display:flex;gap:6px;">
                    <a href="{{ path('intervenant_panel_mvc', {id: app.user.id}) }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-eye"></i> Voir
                    </a>
                    <a href="{{ path('intervenant_heures_mvc', {id: app.user.id}) }}" class="btn btn-ghost btn-sm">
                        <i class="fas fa-clock"></i>
                    </a>
                </div>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#intervenantTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
{% endblock %}
