<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Génération du PDF…</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b;
               background: linear-gradient(160deg,#eef2ff 0%,#faf5ff 60%,#fff 100%);
               min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }

        .att { background: #fff; border-radius: 20px; box-shadow: 0 18px 50px rgba(79,70,229,.16);
               padding: 40px 44px; text-align: center; max-width: 420px; width: 100%; }
        .att .ic { font-size: 40px; margin-bottom: 12px; }
        .att h1 { font-size: 20px; margin: 0 0 6px; }
        .att p { color: #64748b; font-size: 14px; margin: 0; }
        .spinner { width: 46px; height: 46px; border: 4px solid #e2e8f0; border-top-color: #6366f1;
                   border-radius: 50%; margin: 0 auto 18px; animation: spin .8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn { display: inline-block; margin-top: 18px; background: #6366f1; color: #fff; border: none;
               border-radius: 10px; padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer;
               text-decoration: none; }
        .btn.sec { background: #eef0f6; color: #475569; }
        .att .actions { display: none; gap: 10px; justify-content: center; }

        /* Grille rendue HORS ÉCRAN : nécessaire à html2canvas, invisible pour l'utilisateur. */
        .offscreen { position: fixed; left: -99999px; top: 0; }
        /* Format étiquettes Avery L7160 : 21/A4 (3 × 7), étiquette 63,5 × 38,1 mm. */
        /* Hauteur < A4 (le contenu ne fait que ~282mm) : évite qu'un arrondi de
           rasterisation ne déborde et ne crée une page blanche au découpage. */
        .page { width: 210mm; height: 290mm; background: #fff;
                padding: 15.1mm 0 0 9.2mm; }                    /* marge gauche 7,2 + 2mm */
        .grid { display: grid; grid-template-columns: repeat(3, 63.5mm);
                column-gap: 4.5mm; row-gap: 0; }                /* pas d'espace vertical entre lignes */
        .cell { width: 63.5mm; height: 38.1mm; overflow: hidden; text-align: center;
                display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 1.5mm; }
        .cell .qr { width: 31.5mm; height: 38.1mm; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .cell .qr img, .cell .qr canvas { width: 31.5mm !important; height: 31.5mm !important; }
        /* Moitié droite : nom de la famille + appel à l'action. */
        .cell .txt { flex: 1; min-width: 0; padding-left: 2mm; display: flex; flex-direction: column;
                     align-items: center; justify-content: center; text-align: center; }
        .cell .nom { font-size: 12px; font-weight: 800; line-height: 1.15; color: #1e1b4b;
                     word-break: break-word; }
        .cell .msg { font-size: 8px; font-weight: 600; color: #4f46e5; margin-top: 1.5mm; line-height: 1.15; }
    </style>
</head>
<body>
<div class="att" id="att">
    <div class="spinner" id="spin"></div>
    <div class="ic" id="ic" style="display:none;">✅</div>
    <h1 id="titre">Génération du PDF…</h1>
    <p id="sous">{{ total }} QR code{{ total > 1 ? 's' : '' }} · {{ pages|length }} page{{ pages|length > 1 ? 's' : '' }}. Merci de patienter.</p>
    <div class="actions" id="actions">
        <button class="btn" onclick="telechargerPdf()">⬇️ Retélécharger</button>
        <a class="btn sec" href="{{ path('admin_qrcodes_familles_mvc') }}">← Retour à la sélection</a>
    </div>
</div>

{# Grille hors écran, capturée par html2canvas #}
<div class="offscreen"  id="feuilles">
{% for pageItems in pages %}
    <div class="page">
        <div class="grid">
            {% for item in pageItems %}
            <div class="cell">
                <div class="qr" data-url="{{ item.url }}"></div>
                <div class="txt">
                    <div class="nom">{{ famille_label(item.numFam) }}</div>
                    <div class="msg">📷 Scanne-moi en début et en fin intervention</div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
{% endfor %}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous"></script>
<script src="{{ asset('assets/js/html-to-pdf.js') }}"></script>
<script>
const TOTAL = {{ total }};

document.querySelectorAll('.qr').forEach(function (el) {
    new QRCode(el, {
        text: el.dataset.url, width: 240, height: 240,
        colorDark: '#1e1b4b', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M
    });
});

function fini(ok, msg){
    document.getElementById('spin').style.display = 'none';
    document.getElementById('ic').style.display = '';
    document.getElementById('ic').textContent = ok ? '✅' : '⚠️';
    document.getElementById('titre').textContent = ok ? 'PDF téléchargé' : 'Échec de génération';
    document.getElementById('sous').textContent = msg;
    document.getElementById('actions').style.display = 'flex';
}

async function telechargerPdf() {
    try {
        await pagesToPDF('.page', 'qrcodes-familles.pdf', {
            // scale 2 (au lieu de 3) + JPEG 0.8 → PDF ~2× plus léger, QR toujours net.
            orientation: 'p', format: 'a4', margin: 0, scale: 2, quality: 0.8,
            onError: e => { throw e; },
        });
        fini(true, 'Votre PDF a été téléchargé. Vous pouvez fermer cet onglet.');
    } catch (e) {
        fini(false, 'Erreur : ' + (e.message || e));
    }
}

// Lancement automatique une fois les QR dessinés.
if (TOTAL > 0) {
    window.addEventListener('load', () => setTimeout(telechargerPdf, 400));
} else {
    fini(false, 'Aucune famille sélectionnée.');
}
</script>
</body>
</html>
