{% extends 'base.html.twig' %}

{% block title %}Détail Intervenant{% endblock %}

{% block body %}
<h1>{{ intervenant.nom }} {{ intervenant.prenom }}</h1>

<ul class="menu">
    <li><a href="{{ path('intervenants_mvc') }}">← Retour à la liste</a></li>
    <li><a href="{{ path('intervenant_panel_mvc', {id: intervenant.id}) }}">Voir le panel</a></li>
</ul>

<div class="profile-info">
    <table class="table">
        <tr><th>Numéro salarié</th><td>{{ intervenant.numSalarie ?? '-' }}</td></tr>
        <tr><th>Email</th><td>{{ intervenant.email ?? '-' }}</td></tr>
        <tr><th>Téléphone</th><td>{{ intervenant.telPortable ?? '-' }}</td></tr>
        <tr><th>Adresse</th><td>{{ intervenant.adresse ?? '-' }} {{ intervenant.codePostal }} {{ intervenant.ville }}</td></tr>
        <tr><th>Taux horaire</th><td>{{ intervenant.tauxHoraire ?? '-' }} €</td></tr>
        <tr><th>Archivé</th><td>{{ intervenant.archive ? 'Oui' : 'Non' }}</td></tr>
    </table>
</div>

<h2>Prestations</h2>
{% if prestations is empty %}
    <p>Aucune prestation enregistrée.</p>
{% else %}
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Famille</th>
                <th>Date</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Type</th>
                <th>Validé</th>
            </tr>
        </thead>
        <tbody>
        {% for p in prestations %}
            <tr>
                <td>{{ p.nomFam }}</td>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta|date('H:i') }}</td>
                <td>{{ p.heureFinPresta|date('H:i') }}</td>
                <td>{{ p.typePresta }}</td>
                <td>{{ p.validerFam ? 'Oui' : 'Non' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
