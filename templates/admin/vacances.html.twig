{% extends 'base.html.twig' %}
{% block title %}Formulaires de vacances{% endblock %}
{% block page_title %}Formulaires de vacances{% endblock %}

{% block body %}

<div class="page-header">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <div>
      <h1>Campagnes de congés</h1>
      <p>Créez une campagne, puis envoyez le formulaire aux familles et intervenants pour recueillir leurs dates.</p>
    </div>
    {% if actif %}
    <span style="background:#d1fae5;color:#065f46;border:1px solid #a7f3d0;border-radius:6px;padding:6px 14px;font-size:12px;font-weight:bold;">
      <i class="fas fa-check-circle"></i> Actif : {{ actif.titre }}
    </span>
    {% else %}
    <span style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;border-radius:6px;padding:6px 14px;font-size:12px;">
      <i class="fas fa-pause-circle"></i> Aucun formulaire actif
    </span>
    {% endif %}
  </div>
</div>

{% for msg in app.flashes('success') %}
<div class="flash-ok" style="background:#d1fae5;border:1px solid #a7f3d0;color:#065f46;border-radius:4px;padding:8px 14px;margin-bottom:10px;">
  <i class="fas fa-check"></i> {{ msg }}
</div>
{% endfor %}
{% for msg in app.flashes('error') %}
<div style="background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;border-radius:4px;padding:8px 14px;margin-bottom:10px;">
  <i class="fas fa-exclamation-triangle"></i> {{ msg }}
</div>
{% endfor %}

{# ── Nouvelle campagne de congés ────────────────────────────────────── #}
<div class="card" style="margin-bottom:16px;">
  <div class="card-header">
    <i class="fas fa-umbrella-beach" style="color:var(--primary);"></i>
    <span class="card-title">Nouvelle campagne de congés</span>
  </div>
  <div class="card-body">
    <form method="POST" action="{{ path('admin_vacances_creer_mvc') }}" id="campagneForm">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('vacances_creer') }}">

      {# ── Type de campagne (liste prédéfinie + Autre) ── #}
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:6px;">
        De quelles vacances s'agit-il ? <span style="color:#c00;">*</span>
      </label>
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
        {% for t in ["Vacances d'hiver", "Vacances de printemps", "Vacances d'été", "Vacances de la Toussaint", "Vacances de Noël"] %}
        <label style="display:inline-flex;align-items:center;gap:6px;border:1px solid #d1d5db;border-radius:999px;padding:6px 12px;font-size:13px;cursor:pointer;background:#fff;">
          <input type="radio" name="typeCampagne" value="{{ t }}" required onchange="toggleTitrePerso(false)"> {{ t }}
        </label>
        {% endfor %}
        <label style="display:inline-flex;align-items:center;gap:6px;border:1px solid #d1d5db;border-radius:999px;padding:6px 12px;font-size:13px;cursor:pointer;background:#fff;">
          <input type="radio" name="typeCampagne" value="autre" onchange="toggleTitrePerso(true)"> Autre…
        </label>
      </div>

      {# Titre personnalisé (affiché si "Autre") #}
      <div id="titrePersoWrap" style="display:none;margin-bottom:14px;">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
          Nom de ces vacances <span style="color:#c00;">*</span>
        </label>
        <input type="text" name="titrePerso" id="titrePerso" placeholder="Ex. Pont du 1er mai"
               style="width:100%;max-width:360px;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;">
      </div>

      {# ── Dates ── #}
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:end;">
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
            Les vacances commencent le <span style="color:#c00;">*</span>
          </label>
          <input type="date" name="dateDebut" required
                 style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
            Les vacances se terminent le <span style="color:#c00;">*</span>
          </label>
          <input type="date" name="dateFin" required
                 style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
            Date d'ouverture du formulaire des vacances posées
          </label>
          <input type="date" name="dateApparitionDebut"
                 style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
            Date de fermeture du formulaire des vacances posées <span style="color:#c00;">*</span>
          </label>
          <input type="date" name="dateLimiteReponse" required
                 style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;">
        </div>
      </div>

      <div style="margin-top:12px;">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">
          Petit mot à mettre dans l'email (facultatif)
        </label>
        <textarea name="message" rows="2" placeholder="Merci de nous indiquer vos dates de vacances avant la date indiquée."
                  style="width:100%;padding:8px 10px;font-size:13px;border:1px solid #d1d5db;border-radius:6px;resize:vertical;"></textarea>
      </div>

      <div style="margin-top:12px;text-align:right;">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="fas fa-plus"></i> Enregistrer
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleTitrePerso(show) {
    const wrap = document.getElementById('titrePersoWrap');
    const inp  = document.getElementById('titrePerso');
    wrap.style.display = show ? 'block' : 'none';
    inp.required = show;
    if (!show) inp.value = '';
    else inp.focus();
}

// Validation métier côté client (retour immédiat ; le serveur revérifie de toute façon).
document.getElementById('campagneForm').addEventListener('submit', function (e) {
    const val = n => document.querySelector('[name="' + n + '"]').value;
    const ouverture = val('dateApparitionDebut');
    const debut     = val('dateDebut');
    const fin       = val('dateFin');
    const limite    = val('dateLimiteReponse');

    const aujourdhui = new Date().toISOString().slice(0, 10); // AAAA-MM-JJ

    let erreur = null;
    if (limite && limite < aujourdhui) {
        erreur = 'La date limite de réponse est déjà passée : choisissez une date à venir.';
    } else if (debut && fin && debut > fin) {
        erreur = 'La date de fin des vacances doit être après la date de début.';
    } else if (limite && debut && limite >= debut) {
        erreur = 'La date pour répondre doit être avant le début des vacances.';
    } else if (ouverture && limite && ouverture >= limite) {
        erreur = 'La date où les gens peuvent répondre doit être avant la date limite pour répondre.';
    }
    if (erreur) {
        if (typeof window.toast === 'function') {
            e.preventDefault();
            window.toast(erreur, 'error');
        }
        // Si le système de notif n'est pas chargé, on laisse le formulaire partir :
        // le serveur revalide et affichera l'erreur (message flash en haut de page).
    }
});
</script>

{# ── Liste des formulaires ──────────────────────────────────────────── #}
<div class="card">
  <div class="card-header">
    <i class="fas fa-list" style="color:var(--primary);"></i>
    <span class="card-title">Formulaires enregistrés</span>
    {% if configs is not empty %}
    <span class="badge badge-muted" style="margin-left:auto;">{{ configs|length }}</span>
    {% endif %}
  </div>
  <div class="card-body" style="padding:0;overflow-x:auto;">

    {% if configs is empty %}
    <div class="empty-state">
      <div class="empty-state-icon"><i class="fas fa-umbrella-beach"></i></div>
      <h3>Aucun formulaire créé</h3>
      <p>Créez un formulaire ci-dessus pour l'ajouter aux relevés famille.</p>
    </div>
    {% else %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Campagnes</th>
          <th>Période de congés</th>
          <th>Date de fermeture du formulaire</th>
          <th>Statut</th>
          <th>Créé le</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for cfg in configs %}
      <tr>
        <td style="font-weight:600;">{{ cfg.titre }}</td>
        <td style="font-size:12px;white-space:nowrap;">
          {% if cfg.dateDebut %}{{ cfg.dateDebut|date('d/m/Y') }}{% else %}—{% endif %}
          {% if cfg.dateFin %} → {{ cfg.dateFin|date('d/m/Y') }}{% endif %}
        </td>
        <td style="font-size:12px;white-space:nowrap;">
          {{ cfg.dateLimiteReponse ? cfg.dateLimiteReponse|date('d/m/Y') : '—' }}
        </td>
        <td>
          {% set st = cfg.statut ?? 'brouillon' %}
          {% if st == 'envoyee' %}
            <span class="badge badge-info"><i class="fas fa-paper-plane"></i> Envoyée</span>
          {% elseif st == 'cloturee' %}
            <span class="badge badge-muted"><i class="fas fa-lock"></i> Clôturée</span>
          {% else %}
            <span class="badge badge-warning"><i class="fas fa-pencil"></i> Brouillon</span>
          {% endif %}
        </td>
        <td style="white-space:nowrap;font-size:11px;">{{ cfg.createdAt|date('d/m/Y H:i') }}</td>
        <td style="text-align:right;white-space:nowrap;">
          <a href="{{ path('admin_vacances_remplacements_mvc', {id: cfg.id}) }}" class="btn btn-sm btn-primary"
             style="text-decoration:none;" title="Vue d'ensemble des remplacements">
            <i class="fas fa-people-arrows"></i> Remplacements
          </a>
          <form method="POST" action="{{ path('admin_vacances_toggle_mvc', {id: cfg.id}) }}" style="display:inline;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('vacances_toggle_' ~ cfg.id) }}">
            <button type="submit" class="btn btn-sm {{ cfg.actif ? 'btn-warning' : 'btn-success' }}"
                    title="{{ cfg.actif ? 'Désactiver' : 'Activer sur tous les relevés' }}">
              <i class="fas {{ cfg.actif ? 'fa-pause' : 'fa-play' }}"></i>
              {{ cfg.actif ? 'Désactiver' : 'Activer' }}
            </button>
          </form>
          <form method="POST" action="{{ path('admin_vacances_supprimer_mvc', {id: cfg.id}) }}" style="display:inline;"
                onsubmit="return confirm('Supprimer ce formulaire ?');">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('vacances_supprimer_' ~ cfg.id) }}">
            <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

  </div>
</div>

{% endblock %}
