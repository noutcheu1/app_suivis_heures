{% extends 'base.html.twig' %}
{% block title %}Profil — {{ user.nom }} {{ user.prenom }}{% endblock %}
{% block page_title %}Mon profil{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:16px;">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-id-card" style="font-size:20px;color:var(--primary);"></i>
            </div>
            <div>
                <h1>{{ user.nom }} {{ user.prenom }}</h1>
                <p>
                    {{ user.titre in ['MME', 'Mel'] ? 'Intervenante' : 'Intervenant' }}
                    {% if user.archive is defined and user.archive %}
                        — <span class="badge badge-danger">Archivé</span>
                    {% endif %}
                </p>
            </div>
        </div>
        <a href="{{ path('intervenant_panel_mvc', {id: user.id}) }}" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Mon espace
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-info-circle" style="color:var(--primary);"></i>
        <span class="card-title">Informations personnelles</span>
    </div>
    <div class="card-body">
        <dl style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;font-size:13.5px;margin:0;">
        {% for key, value in user %}
            {% if value is not null and value != '' %}
            <div>
                <dt style="color:var(--text-muted);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">
                    {{ key|capitalize|replace({'_': ' '}) }}
                </dt>
                <dd style="margin:0;">
                    {% if key == 'email' %}
                        <a href="mailto:{{ value }}" style="color:var(--primary);">{{ value }}</a>
                    {% else %}
                        {{ value }}
                    {% endif %}
                </dd>
            </div>
            {% endif %}
        {% endfor %}
        </dl>
    </div>
</div>

{% endblock %}
