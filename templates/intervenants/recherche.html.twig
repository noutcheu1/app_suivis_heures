{% extends 'base.html.twig' %}

{% block title %}Recherche intervenant{% endblock %}

{% block body %}
<h1>Recherche d'intervenant</h1>

<form method="GET" action="{{ path('intervenant_recherche_mvc') }}">
    <div class="search-container">
        <input type="text" class="search-input" name="q" value="{{ terme }}" placeholder="Nom, prénom...">
        <button type="submit" class="btn btn-primary">Rechercher</button>
    </div>
</form>

{% if terme is not empty %}
    {% if users is empty %}
        <p>Aucun résultat pour <strong>{{ terme }}</strong>.</p>
    {% else %}
        <ul class="menu" id="intervenantList">
        {% for user in users %}
            <li class="search-item">
                <a href="{{ path('intervenant_panel_mvc', {id: user.id ?? user.id_intervenant}) }}">
                    <img src="{{ asset('assets/icons/user.png') }}" alt="Profil">
                    <span class="name">{{ user.nom }} {{ user.prenom }}</span>
                </a>
            </li>
        {% endfor %}
        </ul>
    {% endif %}
{% endif %}
{% endblock %}
