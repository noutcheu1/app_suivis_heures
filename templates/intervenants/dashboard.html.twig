{% extends 'base.html.twig' %}
{% block title %}Mon espace {{ user.nom }} {{ user.prenom }}{% endblock %}
{% block page_title %}Mon espace{% endblock %}

{% block body %}

{% if user %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:14px;">
            <div style="width:44px;height:44px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-user" style="font-size:18px;color:var(--primary);"></i>
            </div>
            <div>
                <h1>{{ user.titre in ['MME','Mel'] ? 'Bonjour Mme' : 'Bonjour M.' }} {{ user.prenom }} {{ user.nom }}</h1>
                <p>{{ user.prenom ?? '' }} {{ user.nom ?? '' }}</p>
            </div>
        </div>
    </div>
</div>

{# ── Réponse à la campagne de congés (résumé simple) ─── #}
{% if reponseVacances is defined and reponseVacances %}
{% set moisFr = {1:'janvier',2:'février',3:'mars',4:'avril',5:'mai',6:'juin',7:'juillet',8:'août',9:'septembre',10:'octobre',11:'novembre',12:'décembre'} %}
<div class="card" style="margin-bottom:20px;border-left:4px solid #4f46e5;">
    <div class="card-body" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <div style="font-size:26px;">🏖️</div>
        <div style="flex:1;min-width:200px;">
            <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;">
                Vacances{% if campagneVacances %} — {{ campagneVacances.titre }}{% endif %}
            </div>
            {% if not reponseVacances.repondu %}
                <div style="font-size:15px;color:var(--warning);font-weight:600;margin-top:4px;">
                    <i class="fas fa-hourglass-half"></i> Pas encore répondu
                </div>
            {% elseif reponseVacances.dateDebutConge %}
                <div style="font-size:15px;color:#1e1b4b;font-weight:600;margin-top:4px;">
                    En congé du
                    <strong>{{ reponseVacances.dateDebutConge|date('j') }} {{ moisFr[reponseVacances.dateDebutConge|date('n')] }}</strong>
                    au
                    <strong>{{ reponseVacances.dateFinConge|date('j') }} {{ moisFr[reponseVacances.dateFinConge|date('n')] }} {{ reponseVacances.dateFinConge|date('Y') }}</strong>
                </div>
            {% else %}
                <div style="font-size:15px;color:#15803d;font-weight:600;margin-top:4px;">
                    <i class="fas fa-check-circle"></i> Pas de congé prévu sur cette période
                </div>
                {# La dispo remplacement n'est demandée QUE si pas en congé #}
                <div style="font-size:14px;margin-top:2px;">
                    {% if reponseVacances.disponibleRemplacement %}
                        <span style="color:#15803d;"><i class="fas fa-check-circle"></i> Disponible pour des remplacements</span>
                    {% else %}
                        <span style="color:var(--text-muted);"><i class="fas fa-times-circle"></i> Pas disponible pour remplacer</span>
                    {% endif %}
                </div>
            {% endif %}
            {% if reponseVacances.commentaire %}
            <div style="font-size:13px;color:var(--text-muted);margin-top:6px;font-style:italic;">« {{ reponseVacances.commentaire }} »</div>
            {% endif %}
        </div>
        {# Bouton pour répondre / modifier depuis le site, tant que la campagne est ouverte #}
        {% if campagneVacances and (campagneVacances.dateLimiteReponse is null or campagneVacances.dateLimiteReponse|date('Y-m-d') >= "now"|date('Y-m-d')) %}
        <a href="{{ path('vacances_reponse_intervenant', {token: reponseVacances.token}) }}"
           style="background:#4f46e5;color:#fff;font-weight:600;font-size:14px;padding:10px 18px;border-radius:10px;text-decoration:none;white-space:nowrap;">
            {{ reponseVacances.repondu ? 'Modifier ma réponse' : 'Répondre maintenant' }}
        </a>
        {% endif %}
    </div>
</div>
{% endif %}

{# ── KPIs mois courant ─────────────────────────────── #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:20px;">
    <div class="kpi-card">
        <div class="kpi-label">Total heures du mois</div>
        <div class="kpi-value">{{ stats.totalHeures }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Saisies famille</div>
        <div class="kpi-value" style="color:var(--success);">{{ stats.heuresValidees }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Non saisies famille</div>
        <div class="kpi-value" style="color:var(--warning);">{{ stats.heuresAttente }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Écarts</div>
        <div class="kpi-value" style="color:var(--warning);">{{ stats.nbSignalements }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Prestations</div>
        <div class="kpi-value" style="color:var(--info);">{{ stats.nbPrestations }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Km avec enfants</div>
        <div class="kpi-value" style="color:var(--primary);">{{ stats.totalKm|number_format(1, ',', ' ') }} km</div>
    </div>
</div>

{# ── Alertes ───────────────────────────────────────── #}
{% if alertes is not empty %}
<div style="margin-bottom:20px;">
    {% for alerte in alertes %}
    <div style="background:var(--warning-bg);border:1px solid #fde68a;border-radius:var(--radius);padding:12px 16px;display:flex;align-items:center;gap:10px;font-size:13.5px;margin-bottom:8px;">
        <i class="fas fa-triangle-exclamation" style="color:var(--warning);flex-shrink:0;"></i>
        <div style="flex:1;">
            Relevé <strong>{{ alerte.libelle }}</strong> <strong>{{ alerte.mois }}</strong>
            ({{ alerte.nbPrestations }} prestation{% if alerte.nbPrestations > 1 %}s{% endif %}) non signé
        </div>
        <a href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: alerte.type}) }}"
           class="btn btn-secondary btn-sm" style="flex-shrink:0;">
            Signer <i class="fas fa-arrow-right"></i>
        </a>
    </div>
    {% endfor %}
</div>
{% endif %}


{# ── Actions rapides ───────────────────────────────── #}
<h2 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:0 0 12px;">Actions rapides</h2>

<div class="action-grid" style="margin-bottom:28px;">

    <a class="action-card" href="{{ path('intervenant_pointer_mvc', {id: user.id}) }}">
        <div class="action-card-icon" style="background:#eef2ff;">
            <i class="fas fa-stopwatch" style="color:#4f46e5;"></i>
        </div>
        <div>
            <p class="action-card-label">Pointer</p>
            <p class="action-card-desc">Manuel, scan QR ou garde d'enfant</p>
        </div>
    </a>

    <a class="action-card" href="{{ path('intervenant_qr_mvc', {id: user.id}) }}">
        <div class="action-card-icon" style="background:#f0fdf4;">
            <i class="fas fa-qrcode" style="color:#10b981;"></i>
        </div>
        <div>
            <p class="action-card-label">Scanner QR</p>
            <p class="action-card-desc">Pointage rapide famille</p>
        </div>
    </a>

    <a class="action-card" href="{{ path('intervenant_planning_mvc', {id: user.id}) }}">
        <div class="action-card-icon" style="background:#f0f9ff;">
            <i class="fas fa-calendar-days" style="color:#0ea5e9;"></i>
        </div>
        <div>
            <p class="action-card-label">Mes familles</p>
            <p class="action-card-desc">Interventions & contacts</p>
        </div>
    </a>

    <a class="action-card" href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: 'ENFA'}) }}">
        <div class="action-card-icon" style="background:#fff7ed;">
            <i class="fas fa-child" style="color:#f59e0b;"></i>
        </div>
        <div>
            <p class="action-card-label">Relevé Garde enfants</p>
            <p class="action-card-desc">Fiche mensuelle ENFA</p>
        </div>
    </a>

    <a class="action-card" href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: 'MENA'}) }}">
        <div class="action-card-icon" style="background:#fdf4ff;">
            <i class="fas fa-broom" style="color:#a21caf;"></i>
        </div>
        <div>
            <p class="action-card-label">Relevé Ménage</p>
            <p class="action-card-desc">Fiche mensuelle MENA</p>
        </div>
    </a>

    <a class="action-card" href="{{ path('mes_conges_mvc', {type: 'INTERVENANT', personneId: user.id}) }}">
        <div class="action-card-icon" style="background:#eef2ff;">
            <i class="fas fa-umbrella-beach" style="color:#6366f1;"></i>
        </div>
        <div>
            <p class="action-card-label">Mes congés</p>
            <p class="action-card-desc">Déclarer mes absences</p>
        </div>
    </a>

</div>

{# ── Dernières activités ───────────────────────────── #}
{% if dernieres is not empty %}
<div class="card">
    <div class="card-header">
        <i class="fas fa-history" style="color:var(--primary);font-size:13px;"></i>
        <span class="card-title">Dernières interventions</span>
        <a href="{{ path('intervenant_heures_mvc', {id: user.id}) }}"
           style="margin-left:auto;font-size:12px;color:var(--primary);font-weight:500;">
            Tout voir <i class="fas fa-arrow-right" style="font-size:10px;"></i>
        </a>
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Famille</th>
                    <th>Date</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Type</th>
                   
                </tr>
            </thead>
            <tbody>
            {% for p in dernieres %}
            <tr>
                <td style="font-weight:500;">{{ (p.numFam and p.numFam != '0' and not p.occasionnel) ? famille_label(p.numFam) : ('Famille occasionnelle' ~ (p.nomFam ? ' ' ~ p.nomFam : '')) }}</td>
                <td>{{ p.datePresta|date('d/m/Y') }}</td>
                <td>{{ p.heureDebutPresta ? p.heureDebutPresta|date('H:i') : '—' }}</td>
                <td>{{ p.heureFinPresta ? p.heureFinPresta|date('H:i') : '—' }}</td>
                <td>
                    <span class="badge {{ p.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                        {{ p.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                    </span>
                </td>
               
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% else %}
<div class="empty-state">
    <div class="empty-state-icon"><i class="fas fa-user-slash"></i></div>
    <h3>Intervenant introuvable</h3>
    <p>Ce compte n'est lié à aucun dossier intervenant.</p>
</div>
{% endif %}

{% endblock %}
