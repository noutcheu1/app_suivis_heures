{% extends 'base_new.html.twig' %}

{% block title %}Liste des intervenants - Application Chaudoudoux{% endblock %}

{% block stylesheets %}
<style>
    .page-header {
        background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 15px;
    }
    
    .search-container {
        background: white;
        padding: 1.5rem;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    
    .intervenant-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 1.5rem;
        border-left: 5px solid #28a745;
    }
    
    .intervenant-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .intervenant-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
    
    .intervenant-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #495057;
        margin: 0;
    }
    
    .intervenant-id {
        background: #e9ecef;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.9rem;
        color: #6c757d;
    }
    
    .intervenant-info {
        margin-bottom: 1rem;
    }
    
    .intervenant-info-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        color: #6c757d;
    }
    
    .intervenant-info-item i {
        margin-right: 0.5rem;
        width: 20px;
        text-align: center;
    }
    
    .intervenant-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    
    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
    }
    
    .btn-action:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }
    
    .btn-primary {
        background: linear-gradient(45deg, #0d6efd, #0056b3);
        color: white;
    }
    
    .btn-success {
        background: linear-gradient(45deg, #28a745, #1e7e34);
        color: white;
    }
    
    .btn-info {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }
    
    .btn-warning {
        background: linear-gradient(45deg, #ffc107, #e0a800);
        color: white;
    }
    
    .search-input {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: border-color 0.3s ease;
    }
    
    .search-input:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }
    
    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }
    
    .status-active {
        background: #d4edda;
        color: #155724;
    }
    
    .status-inactive {
        background: #f8d7da;
        color: #721c24;
    }
    
    .pagination {
        justify-content: center;
        margin-top: 2rem;
    }
    
    .pagination .page-link {
        border: none;
        margin: 0 0.25rem;
        border-radius: 8px;
        color: #28a745;
    }
    
    .pagination .page-item.active .page-link {
        background: linear-gradient(45deg, #28a745, #1e7e34);
    }
    
    .specialties {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }
    
    .specialty-tag {
        background: #e9ecef;
        padding: 0.25rem 0.5rem;
        border-radius: 15px;
        font-size: 0.8rem;
        color: #495057;
    }
</style>
{% endblock %}

{% block body %}
<!-- Header de la page -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-3">
                    <i class="fas fa-users me-3"></i>
                    Liste des intervenants
                </h1>
                <p class="mb-0">
                    Gérez tous les intervenants inscrits dans le système
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="text-white">
                    <i class="fas fa-users me-2"></i>
                    {{ intervenants|length }} intervenant(s) trouvé(s)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barre de recherche -->
<div class="container">
    <div class="search-container">
        <form method="GET" action="{{ path('intervenants_mvc') }}">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label for="search" class="form-label">
                        <i class="fas fa-search me-2"></i>
                        Rechercher un intervenant
                    </label>
                    <input type="text" class="form-control search-input" id="search" name="search" 
                           placeholder="Nom, prénom, numéro de sécurité sociale..." 
                           value="{{ app.request.query.get('search', '') }}">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-search me-2"></i>
                        Rechercher
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Liste des intervenants -->
<div class="container">
    {% if intervenants is defined and intervenants|length > 0 %}
        {% for intervenant in intervenants %}
            <div class="intervenant-card">
                <div class="intervenant-header">
                    <h3 class="intervenant-name">
                        <i class="fas fa-user me-2 text-success"></i>
                        {{ intervenant.nom|default('Nom non spécifié') }} {{ intervenant.prenom|default('') }}
                    </h3>
                    <div>
                        <span class="intervenant-id">
                            #{{ intervenant.id_intervenant|default(intervenant.id|default('N/A')) }}
                        </span>
                        {% if intervenant.actif is defined and intervenant.actif %}
                            <span class="status-badge status-active ms-2">Actif</span>
                        {% else %}
                            <span class="status-badge status-inactive ms-2">Inactif</span>
                        {% endif %}
                    </div>
                </div>
                
                <div class="intervenant-info">
                    {% if intervenant['Numéro de sécurité sociale'] is defined and intervenant['Numéro de sécurité sociale'] %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-id-card"></i>
                            <span>N° SS: {{ intervenant['Numéro de sécurité sociale'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if intervenant['Téléphone'] is defined and intervenant['Téléphone'] %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-phone"></i>
                            <span>{{ intervenant['Téléphone'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if intervenant['Email'] is defined and intervenant['Email'] %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-envelope"></i>
                            <span>{{ intervenant['Email'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if intervenant['Adresse'] is defined and intervenant['Adresse'] %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>{{ intervenant['Adresse'] }}</span>
                        </div>
                    {% endif %}
                    
                    {% if intervenant.specialites is defined and intervenant.specialites|length > 0 %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-tools"></i>
                            <span>Spécialités:</span>
                            <div class="specialties">
                                {% for specialite in intervenant.specialites %}
                                    <span class="specialty-tag">{{ specialite }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    
                    {% if intervenant.date_embauche is defined %}
                        <div class="intervenant-info-item">
                            <i class="fas fa-calendar"></i>
                            <span>Embauché le: {{ intervenant.date_embauche }}</span>
                        </div>
                    {% endif %}
                </div>
                
                <div class="intervenant-actions">
                    <a href="{{ path('intervenant_panel_mvc', {id: intervenant.id_intervenant|default(intervenant.id)}) }}" 
                       class="btn-action btn-primary">
                        <i class="fas fa-tachometer-alt me-2"></i>
                        Tableau de bord
                    </a>
                    
                    <a href="{{ path('intervenant_profile_mvc', {id: intervenant.id_intervenant|default(intervenant.id)}) }}" 
                       class="btn-action btn-info">
                        <i class="fas fa-user me-2"></i>
                        Profil
                    </a>
                    
                    <a href="{{ path('intervenant_heures_mvc', {id: intervenant.id_intervenant|default(intervenant.id)}) }}" 
                       class="btn-action btn-success">
                        <i class="fas fa-plus-circle me-2"></i>
                        Ajouter heures
                    </a>
                    
                    <a href="{{ path('releves_intervenant_mvc', {intervenantId: intervenant.id_intervenant|default(intervenant.id)}) }}" 
                       class="btn-action btn-warning">
                        <i class="fas fa-file-alt me-2"></i>
                        Relevés
                    </a>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-users fa-4x text-muted"></i>
            </div>
            <h3 class="text-muted">Aucun intervenant trouvé</h3>
            <p class="text-muted">
                {% if app.request.query.get('search') %}
                    Aucun intervenant ne correspond à votre recherche.
                {% else %}
                    Il n'y a aucun intervenant enregistré dans le système.
                {% endif %}
            </p>
            {% if app.request.query.get('search') %}
                <a href="{{ path('intervenants_mvc') }}" class="btn btn-success mt-3">
                    <i class="fas fa-times me-2"></i>
                    Effacer la recherche
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>

<!-- Pagination (si nécessaire) -->
{% if intervenants is defined and intervenants|length > 10 %}
<div class="container">
    <nav aria-label="Pagination des intervenants">
        <ul class="pagination">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            <li class="page-item active">
                <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">3</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}
{% endblock %}
