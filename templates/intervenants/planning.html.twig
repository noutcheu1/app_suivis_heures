{% extends 'base.html.twig' %}
{% block title %}Mes familles — {{ user.nom }} {{ user.prenom }}{% endblock %}
{% block page_title %}Mes familles{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>Mes familles</h1>
            <p>{{ familles|length }} famille{% if familles|length > 1 %}s{% endif %} dans votre planning</p>
        </div>
        <div style="display:flex;gap:8px;">
            <a href="{{ path('intervenant_qr_mvc', {id: app.user.id}) }}" class="btn btn-primary btn-sm">
                <i class="fas fa-qrcode"></i> Scanner QR
            </a>
            <a href="{{ path('intervenant_panel_mvc', {id: app.user.id}) }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>
</div>

{% if familles is empty %}
<div class="empty-state">
    <div class="empty-state-icon"><i class="fas fa-users-slash"></i></div>
    <h3>Aucune famille dans votre planning</h3>
    <p>Les familles apparaîtront ici une fois que vous aurez saisi des prestations</p>
    <a href="{{ path('intervenant_suivie_mvc', {id: app.user.id}) }}" class="btn btn-primary" style="margin-top:14px;">
        <i class="fas fa-plus"></i> Saisir des heures
    </a>
</div>
{% else %}

{# ── Recherche ─────────────────────────────────────── #}
<div class="table-wrapper">
    <div class="table-toolbar">
        <div class="table-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Rechercher une famille..." oninput="filterCards()">
        </div>
    </div>
</div>

{# ── Cards familles ────────────────────────────────── #}
<div id="familleGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:16px;">
{% for famille in familles %}
<div class="famille-card" data-nom="{{ famille.nomFamille|lower }}">
    <div class="card" style="height:100%;">
        <div class="card-body" style="padding:18px 20px;">

            {# Avatar + nom #}
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                <div style="width:40px;height:40px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="fas fa-house-user" style="font-size:16px;color:var(--primary);"></i>
                </div>
                <div>
                    <div style="font-weight:600;font-size:14px;">{{ famille.nomFamille }}</div>
                    <div style="font-size:11px;color:var(--text-muted);font-family:monospace;">{{ famille.numeroFamille }}</div>
                </div>
            </div>

            {# Infos #}
            <dl style="display:grid;grid-template-columns:auto 1fr;gap:5px 12px;font-size:12.5px;margin:0 0 14px;">
                {% if famille.adresse %}
                <dt style="color:var(--text-muted);"><i class="fas fa-map-marker-alt" style="width:12px;text-align:center;"></i></dt>
                <dd style="margin:0;">{{ famille.adresse }}{% if famille.ville %}, {{ famille.ville }}{% endif %}</dd>
                {% endif %}
                {% if famille.telDom %}
                <dt style="color:var(--text-muted);"><i class="fas fa-phone" style="width:12px;text-align:center;"></i></dt>
                <dd style="margin:0;"><a href="tel:{{ famille.telDom }}" style="color:inherit;">{{ famille.telDom }}</a></dd>
                {% endif %}
            </dl>

            {# Services #}
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;">
                {% if famille.prestGardeEnfants %}
                <span class="badge badge-info"><i class="fas fa-child"></i> Garde enfants</span>
                {% endif %}
                {% if famille.prestMenage %}
                <span class="badge badge-muted"><i class="fas fa-broom"></i> Ménage</span>
                {% endif %}
            </div>

            {# Actions #}
            <div style="display:flex;gap:8px;">
                <a href="{{ path('intervenant_suivie_mvc', {id: app.user.id}) }}?famille={{ famille.numeroFamille }}"
                   class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                    <i class="fas fa-plus"></i> Saisir
                </a>
                <a href="{{ path('intervenant_heures_mvc', {id: app.user.id}) }}"
                   class="btn btn-secondary btn-sm" style="flex:1;justify-content:center;">
                    <i class="fas fa-clock"></i> Historique
                </a>
            </div>

        </div>
    </div>
</div>
{% endfor %}
</div>

{% endif %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function filterCards() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.famille-card').forEach(card => {
        card.style.display = card.dataset.nom.includes(q) ? '' : 'none';
    });
}
</script>
{% endblock %}
