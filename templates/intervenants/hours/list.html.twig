{% extends 'base.html.twig' %}
{% block title %}Mes heures {{ user.nom }} {{ user.prenom }}{% endblock %}
{% block page_title %}Mes heures{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            <h1>Heures de {{ user.nom }} {{ user.prenom }}</h1>
            <p>{{ prestations|length }} prestation{% if prestations|length > 1 %}s{% endif %} enregistrée{% if prestations|length > 1 %}s{% endif %}</p>
        </div>
        <a href="{{ path('intervenant_suivie_mvc', {id: user.id}) }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Saisir des heures
        </a>
    </div>

    {% if isAdmin %}
    <div style="margin-top:12px;">
        <span style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:20px;background:#fff7ed;color:#c2410c;font-weight:600;font-size:13px;border:1px dashed #fdba74;">
            <i class="fas fa-user-shield"></i> Mode admin vous pouvez consulter et modifier toutes les heures
        </span>
    </div>
    {% endif %}
</div>

{# ── Zone de sélection (centrée) : mois + service ─────────────────────────── #}
{% if prestations is not empty %}
<div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-md);padding:18px 20px;margin-bottom:16px;box-shadow:var(--shadow-xs);text-align:center;">
    <div style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);font-weight:600;margin-bottom:8px;">Mois</div>
    <select id="moisSelect" onchange="appliquerSelection()"
        style="padding:10px 14px;border:2px solid var(--primary);border-radius:10px;font-size:16px;font-weight:700;background:var(--bg);color:var(--text);cursor:pointer;font-family:inherit;min-width:200px;">
        {% for g in groupesMois %}
        <option value="{{ g.key }}" {{ g.key == moisActuel ? 'selected' : '' }}>{{ g.label }}</option>
        {% endfor %}
    </select>

    {% if servicesDispo|length > 0 %}
    <div style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);font-weight:600;margin:14px 0 8px;">Service</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        {% for s in servicesDispo %}
        <button type="button" class="svc-btn" data-service="{{ s }}" onclick="choisirService('{{ s }}')"
            style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:24px;border:2px solid var(--border);background:#fff;color:var(--text-muted);font-weight:600;font-size:14px;cursor:pointer;font-family:inherit;transition:all .15s;">
            <i class="fas {{ s == 'MENA' ? 'fa-broom' : 'fa-child' }}"></i>
            {{ s == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
        </button>
        {% endfor %}
    </div>
    {% endif %}

    <div id="selectionResume" style="margin-top:14px;font-size:13px;color:var(--text-muted);"></div>
</div>
{% endif %}

<div class="table-wrapper">

    <div class="table-toolbar">
        <div class="table-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Rechercher..." oninput="filterRows()">
        </div>
        <div style="margin-left:auto;display:flex;gap:8px;">
            <a href="{{ path('intervenant_panel_mvc', {id: user.id}) }}" class="btn btn-ghost btn-sm">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>
    
    {% if prestations is empty %}
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-clock"></i></div>
        <h3>Aucune heure enregistrée</h3>
        <p>Commencez par saisir vos premières prestations</p>
        <a href="{{ path('intervenant_suivie_mvc', {id: user.id}) }}" class="btn btn-primary" style="margin-top:14px;">
            <i class="fas fa-plus"></i> Saisir des heures
        </a>
    </div>
    {% else %}

    <table class="data-table" id="hoursTable">
        <thead>
            <tr>
                <th>Famille</th>
                <th>Date</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Type</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for groupe in groupesMois %}
        {% for presta in groupe.prestations %}
        {% set verrouille = not isAdmin and presta.datePresta < dateLimite %}
        {% set dureeH = (presta.heureFinPresta|date('U') - presta.heureDebutPresta|date('U')) / 3600 %}
        <tr class="presta-row" data-group="{{ groupe.key }}" data-type="{{ presta.typePresta }}" data-hours="{{ dureeH > 0 ? dureeH : 0 }}"{% if verrouille %} style="opacity:.8;"{% endif %}>
            <td>
                {% if presta.numFam and presta.numFam != '0' and not presta.occasionnel %}
                    {% if isAdmin %}
                        <a href="{{ path('admin_famille_detail_mvc', {numFam: presta.numFam}) }}" style="font-weight:500;">
                            {{ famille_label(presta.numFam) }}
                        </a>
                    {% else %}
                        <span style="font-weight:500;">{{ famille_label(presta.numFam) }}</span>
                    {% endif %}
                {% else %}
                    <span style="font-weight:500;">Famille occasionnelle{% if presta.nomFam %} {{ presta.nomFam }}{% endif %}</span>
                {% endif %}
            </td>
            <td>{{ presta.datePresta|date('d/m/Y') }}</td>
            <td>{{ presta.heureDebutPresta|date('H:i') }}</td>
            <td>{{ presta.heureFinPresta|date('H:i') }}</td>
            <td>
                <span class="badge {{ presta.typePresta == 'MENA' ? 'badge-muted' : 'badge-info' }}">
                    {{ presta.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}
                </span>
            </td>
            <td>
                {% if verrouille %}
                    <span class="badge badge-muted" title="Mois clôturé modification impossible">
                        <i class="fas fa-lock" style="font-size:9px;margin-right:3px;"></i>Clôturé
                    </span>
                {% elseif presta.desactiver == 1 %}
                    <span class="badge badge-danger">Supprimé</span>
                {% else %}
                    <span class="badge badge-success">Actif</span>
                {% endif %}
            </td>
            <td>
                <div style="display:flex;gap:6px;">
                    {% if verrouille %}
                        <span class="btn btn-ghost btn-sm" style="opacity:.35;cursor:not-allowed;" title="Mois clôturé">
                            <i class="fas fa-lock"></i>
                        </span>
                    {% else %}
                        <a href="{{ path('intervenant_suivie_mvc', {id: user.id, edite: presta.id}) }}" class="btn btn-ghost btn-sm" title="Modifier">
                            <i class="fas fa-edit"></i>
                        </a>
                        {% if presta.desactiver == 1 %}
                            <button class="btn btn-secondary btn-sm btn-action-presta"
                                    data-action="recup" data-id="{{ presta.id }}" title="Restaurer">
                                <i class="fas fa-undo"></i>
                            </button>
                        {% else %}
                            <button class="btn btn-ghost btn-sm btn-action-presta" title="Supprimer"
                                    data-action="supp" data-id="{{ presta.id }}"
                                    style="color:var(--danger);">
                                <i class="fas fa-trash"></i>
                            </button>
                        {% endif %}
                    {% endif %}
                    <button class="btn btn-ghost btn-sm voir-detail" data-target="{{ presta.id }}" title="Détails">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </td>
        </tr>
        {% endfor %}
        {% endfor %}
        <tr id="noMatchRow" style="display:none;">
            <td colspan="7" style="text-align:center;padding:36px 20px;color:var(--text-muted);">
                <i class="fas fa-calendar-xmark" style="font-size:24px;display:block;margin-bottom:10px;opacity:.5;"></i>
                Aucune heure déclarée pour ce mois et ce service.
            </td>
        </tr>
        </tbody>
    </table>

    {% endif %}

</div>

{% endblock %}

{% block modal %}
{{ parent() }}
{% set todayYM = 'now'|date('Y-m') %}
{% for presta in prestations %}
{% set verrouille = not isAdmin and (presta.datePresta|date('Y-m') < todayYM) %}
<div class="modal fade" id="modalData{{ presta.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:var(--radius-lg);">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-semibold">
                    Détail {{ (presta.numFam and presta.numFam != '0' and not presta.occasionnel) ? famille_label(presta.numFam) : ('Famille occasionnelle' ~ (presta.nomFam ? ' ' ~ presta.nomFam : '')) }}
                    {% if verrouille %}
                    <span class="badge badge-muted" style="margin-left:6px;font-size:10px;">
                        <i class="fas fa-lock" style="font-size:9px;"></i> Clôturé
                    </span>
                    {% endif %}
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <dl style="display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:13.5px;margin:0;">
                    <dt style="color:var(--text-muted);font-weight:500;">Famille</dt>
                    <dd style="margin:0;">{{ (presta.numFam and presta.numFam != '0' and not presta.occasionnel) ? famille_label(presta.numFam) : ('Famille occasionnelle' ~ (presta.nomFam ? ' ' ~ presta.nomFam : '')) }}</dd>
                    <dt style="color:var(--text-muted);font-weight:500;">Date</dt>
                    <dd style="margin:0;">{{ presta.datePresta|date('d/m/Y') }}</dd>
                    <dt style="color:var(--text-muted);font-weight:500;">Début</dt>
                    <dd style="margin:0;">{{ presta.heureDebutPresta|date('H:i') }}</dd>
                    <dt style="color:var(--text-muted);font-weight:500;">Fin</dt>
                    <dd style="margin:0;">{{ presta.heureFinPresta|date('H:i') }}</dd>
                    <dt style="color:var(--text-muted);font-weight:500;">Type</dt>
                    <dd style="margin:0;">{{ presta.typePresta == 'MENA' ? 'Ménage' : "Garde d'enfants" }}</dd>
                    <dt style="color:var(--text-muted);font-weight:500;">Saisie le</dt>
                    <dd style="margin:0;">{{ presta.ajouterLe|date('d/m/Y H:i') }}</dd>
                    {% if presta.modifierLe %}
                    <dt style="color:var(--text-muted);font-weight:500;">Modifiée le</dt>
                    <dd style="margin:0;">{{ presta.modifierLe|date('d/m/Y H:i') }}</dd>
                    {% endif %}
                </dl>
                {% if verrouille %}
                <div style="margin-top:14px;padding:10px 14px;background:#fff8e1;border-radius:8px;border-left:3px solid #f59f00;font-size:12.5px;color:#856404;">
                    <i class="fas fa-lock" style="margin-right:6px;"></i>
                    Ce mois est clôturé. Cette prestation ne peut plus être modifiée.
                </div>
                {% endif %}
            </div>
            <div class="modal-footer border-0 pt-0" style="gap:8px;">
                {% if not verrouille %}
                <a href="{{ path('intervenant_suivie_mvc', {id: user.id, edite: presta.id}) }}" class="btn btn-secondary btn-sm">
                    <i class="fas fa-edit"></i> Modifier
                </a>
                {% endif %}
                <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
let currentMonth   = {{ moisActuel|json_encode|raw }};
let currentService = {{ serviceDefaut|json_encode|raw }};

const SERVICE_LABEL = { MENA: 'Ménage', ENFA: "Garde d'enfants" };

// Affiche uniquement les heures du mois ET du service sélectionnés (+ recherche).
function filterRows() {
    const q = (document.getElementById('searchInput')?.value || '').toLowerCase();
    let visibles = 0;
    let totalHeures = 0;
    document.querySelectorAll('#hoursTable tbody tr.presta-row').forEach(row => {
        const okMois    = row.dataset.group === currentMonth;
        const okService = row.dataset.type  === currentService;
        const okSearch  = !q || row.textContent.toLowerCase().includes(q);
        const show = okMois && okService && okSearch;
        row.style.display = show ? '' : 'none';
        if (show) {
            visibles++;
            totalHeures += parseFloat(row.dataset.hours) || 0;
        }
    });

    const noMatch = document.getElementById('noMatchRow');
    if (noMatch) noMatch.style.display = visibles === 0 ? '' : 'none';

    const resume = document.getElementById('selectionResume');
    if (resume) {
        const moisLabel = document.querySelector('#moisSelect option:checked')?.textContent.trim() || currentMonth;
        const totalFmt  = totalHeures.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        resume.innerHTML = `<i class="fas fa-clock"></i> <strong>${visibles}</strong> prestation(s) · `
            + `<strong>${totalFmt} h</strong> au total ${moisLabel} · ${SERVICE_LABEL[currentService] || currentService}`;
    }
}

// Sélection d'un service : met à jour le style des boutons puis filtre.
function choisirService(service) {
    currentService = service;
    document.querySelectorAll('.svc-btn').forEach(btn => {
        const actif = btn.dataset.service === service;
        btn.style.background  = actif ? 'var(--primary)'   : '#fff';
        btn.style.color       = actif ? '#fff'             : 'var(--text-muted)';
        btn.style.borderColor = actif ? 'var(--primary)'   : 'var(--border)';
    });
    filterRows();
}

// Changement de mois dans la liste déroulante.
function appliquerSelection() {
    currentMonth = document.getElementById('moisSelect').value;
    filterRows();
}

document.querySelectorAll('.btn-action-presta').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id     = btn.dataset.id;
        const action = btn.dataset.action;
        const label  = action === 'supp' ? 'supprimer' : 'restaurer';
        if (!confirm(`Voulez-vous ${label} cette prestation ?`)) return;
        const route = action === 'supp'
            ? `/heures-mvc/supprimer/${id}`
            : `/heures-mvc/restaurer/${id}`;
        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
            const res    = await fetch(route, { method: 'POST', credentials: 'same-origin', headers: { 'X-CSRF-Token': csrfToken } });
            const result = await res.json();
            if (result.success) {
                window.location.reload();
            } else if (result.locked) {
                toast('Ce mois est clôturé la prestation ne peut plus être modifiée.');
            } else {
                toast('Erreur : ' + (result.error ?? 'Impossible d\'effectuer cette action.'));
            }
        } catch (err) {
            toast('Erreur  : ' + err);
        }
    });
});

document.querySelectorAll('.voir-detail').forEach(btn => {
    btn.addEventListener('click', () => {
        const modal = new bootstrap.Modal(document.getElementById('modalData' + btn.dataset.target));
        modal.show();
    });
});
// Note : le tri par colonne a été retiré les prestations sont regroupées par
// mois et filtrées par service via la zone de sélection en haut.

// Au chargement : activer le service par défaut (selon le planning) + mois courant.
document.addEventListener('DOMContentLoaded', () => {
    if (document.querySelector('.svc-btn')) {
        // Si le service par défaut n'a pas de bouton (aucune donnée), prendre le 1er dispo.
        if (!document.querySelector(`.svc-btn[data-service="${currentService}"]`)) {
            currentService = document.querySelector('.svc-btn').dataset.service;
        }
        choisirService(currentService);
    } else {
        filterRows();
    }
});
</script>
{% endblock %}
