{% extends 'base.html.twig' %}

{% block title %}Heures de {{ user.nom }}{% endblock %}
{% block body %}

{% if isAdmin %}
<h1> Voici la/les fiche/s de relevé d'heures de {{ user.nom }} {{ user.prenom }}  </h1>
{% else %}
<h1> {{ user.nom }} {{ user.prenom }} voici vos/votre fiche/s de relevé d'heures </h1>
{% endif %}

<ul class="menu">


    <li>
        <a href="{{ path('releves_intervenant_fiche_mvc', { intervenantId: user.id, type: type, mois: moisOffset-1 }) }}" >
            <img src=" {{ asset('/assets/icons/flecheGauche.png') }}">
            Mois précèdent
        </a>
    </li>

    {% if moisOffset < 0 %}

    <li> 
        <a href="{{ path('releves_intervenant_fiche_mvc', { intervenantId: user.id, type: type, mois: moisOffset+1 }) }}">
            <img src="{{ asset('/assets/icons/flecheDroite.png') }}">
            Mois suivant
        </a>
    </li>

    {% endif %}

</ul>

<div style="overflow-x:auto;">
    <div id="tableContainer"></div>
</div>

<table class="table mt-3">
    <thead>
        <tr>
            <th scope="col">{% if type=="MENA" %} Ménage {% else %} Famille {% endif %}</th>
            <th scope="col">Total des heures</th>
        </tr>
    </thead>
    <tbody id="familleRecap"></tbody>
</table>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Info</th>
            <th scope="col">État</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">Votre fiche est</th>
            <td id="signerMobile"></td>
        </tr>
        <tr {% if type == "MENA" %} style="display:none;" {% endif %}>
            <th scope="row">Total des KM (avec enfants)</th>
            <td id="kmParcourue"></td>
        </tr>
        <tr>
            <th scope="row">Total des heures du mois</th>
            <td id="heureCumuler"></td>
        </tr>
    </tbody>
</table>
<ul class="menu">
    <li>
        <a id="donwload" >
            <img src="{{asset('/assets/icons/save.png')}}">
            {% if isMobile %}
                Cosulter le relever d'heure en PDF
            {% else %}
                Télécharger le relever d'heure
            {% endif %}
        </a>
    </li>
    
    <li align="center">
    
            
        <a id="saveTime">
            <img src="{{asset('/assets/icons/immeuble.png')}}">
            Saisir les heures travailler en dehors de chaudoudoux, puis cliquer ici pour sauvegarder
        </a>
        <input id="heure" type='number' min="0" placeholder="exemple : 4"> h
        <select id="minute" name="minute" required>
            <!-- Options ajoutées via JS -->
        </select> 
    </li>

    <li>    
        <a id="signerButton">
            <img src="{{ asset('/assets/icons/signer.png') }}">
            Signer
        </a>
    </li>
</ul>



{% endblock %}

{% block javascripts %}
{{ parent() }}


<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://unpkg.com/jspdf-autotable"></script>

<script>
console.log('=== [sheet.html.twig] SCRIPT INLINE CHARGÉ ===');

const ID = {{ user.id }};
const paramsUri = new URLSearchParams(window.location.search);
const TYPE_PRESTA = paramsUri.get("type");

console.log('[Twig→JS] ID (user.id depuis Twig) :', ID);
console.log('[Twig→JS] moisOffset (depuis Twig)  :', {{ moisOffset }});
console.log('[Twig→JS] TYPE_PRESTA (depuis URL)   :', TYPE_PRESTA);
console.log('[Twig→JS] isAdmin (depuis Twig)      :', {{ isAdmin ? 'true' : 'false' }});
console.log('[Twig→JS] isMobile (depuis Twig)     :', {{ isMobile is defined and isMobile ? 'true' : 'false' }});

const donwnloadInput = document.getElementById("donwload");
console.log('[DOM] #donwload :', donwnloadInput ? 'trouvé' : '⚠️ INTROUVABLE');

if (!donwnloadInput) {
    alert('[sheet.html.twig] ⚠️ #donwload introuvable dans le DOM !');
} else {
    donwnloadInput.style.opacity = "0.4";
    donwnloadInput.style.pointerEvents = "none";
}

const targetDate = new Date();
targetDate.setMonth(targetDate.getMonth() + {{ moisOffset }});
const ANNEE_COURANTE = String(targetDate.getFullYear());
console.log('[Twig→JS] ANNEE_COURANTE calculée :', ANNEE_COURANTE);

if (donwnloadInput) {
    donwnloadInput.addEventListener("click", () => {
        console.log('[PDF] Clic sur bouton téléchargement — TYPE_PRESTA:', TYPE_PRESTA, 'ANNEE:', ANNEE_COURANTE);
        genererPDF(TYPE_PRESTA, ANNEE_COURANTE);
    });
}

function activerBoutonTelechargement() {
    console.log('[activerBoutonTelechargement] ▶ activation du bouton download');
    if (donwnloadInput) {
        donwnloadInput.style.opacity = "";
        donwnloadInput.style.pointerEvents = "";
        console.log('[activerBoutonTelechargement] ✅ bouton activé');
    } else {
        console.warn('[activerBoutonTelechargement] ⚠️ #donwload introuvable, activation ignorée');
    }
}
</script>

<script src="{{ asset('/assets/js/fiche-dheure.js') }}"></script>
<script src="{{ asset('/assets/js/build_relever_d_heure_pdf.js') }}"></script>



{% endblock %}

{% block stylesheets %}
{{ parent() }}
    <link rel="stylesheet" href="{{ asset('/assets/css/fiche-heure.css') }}">
{% endblock %}