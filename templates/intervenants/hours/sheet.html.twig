{% extends 'base.html.twig' %}
{% block title %}Relevé {% if type == 'MENA' %}Ménage{% else %}Garde d'enfants{% endif %} {{ user.nom }}{% endblock %}
{% block page_title %}Fiche relevé d'heures{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('/assets/css/fiche-heure.css') }}">
{% endblock %}

{% block body %}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
        <div>
            {% if isAdmin %}
            <h1>Relevé de {{ user.nom }} {{ user.prenom }}</h1>
            {% else %}
            <h1>{{ user.nom }} {{ user.prenom }} votre relevé</h1>
            {% endif %}
            <p style="margin:4px 0 0;">Fiche mensuelle</p>
        </div>

        <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">

            {# Onglets type prestation #}
            <div style="display:flex;gap:6px;">
                <a href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: 'ENFA', mois: moisOffset}) }}"
                   class="btn btn-sm {{ type != 'MENA' ? 'btn-primary' : 'btn-secondary' }}">
                    <i class="fas fa-child"></i> Garde d'enfants
                </a>
                <a href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: 'MENA', mois: moisOffset}) }}"
                   class="btn btn-sm {{ type == 'MENA' ? 'btn-primary' : 'btn-secondary' }}">
                    <i class="fas fa-broom"></i> Ménage
                </a>
            </div>

            {# Navigation mois #}
            <div style="display:flex;gap:8px;">
                <a href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: type, mois: moisOffset - 1}) }}"
                   class="btn btn-secondary btn-sm">
                    <i class="fas fa-chevron-left"></i> Mois précédent
                </a>
                {% if moisOffset < 0 %}
                <a href="{{ path('releves_intervenant_fiche_mvc', {intervenantId: user.id, type: type, mois: moisOffset + 1}) }}"
                   class="btn btn-secondary btn-sm">
                    Mois suivant <i class="fas fa-chevron-right"></i>
                </a>
                {% endif %}
            </div>

        </div>
    </div>
</div>

{# ── Tableau des prestations ─────────────────────────── #}
<div class="card" style="margin-bottom:20px;">
    <div class="card-header">
        <i class="fas fa-table-list" style="color:var(--primary);"></i>
        <span class="card-title">Détail des prestations</span>
    </div>
    <div class="card-body" style="padding:0;overflow-x:auto;">
        <div id="tableContainer"></div>
    </div>
</div>

{# ── Récap par famille ───────────────────────────────── #}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;" class="sheet-recap-grid">

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users" style="color:var(--text-muted);font-size:13px;"></i>
            <span class="card-title">{{ type == 'MENA' ? 'Récap ménage' : 'Récap familles' }}</span>
        </div>
        <div class="card-body" style="padding:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{{ type == 'MENA' ? 'Ménage' : 'Famille' }}</th>
                        <th>Total heures</th>
                    </tr>
                </thead>
                <tbody id="familleRecap"></tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-info-circle" style="color:var(--text-muted);font-size:13px;"></i>
            <span class="card-title">Informations</span>
        </div>
        <div class="card-body">
            <dl style="display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:13.5px;margin:0;">

                <dt style="color:var(--text-muted);font-weight:500;">Statut signature</dt>
                <dd style="margin:0;" id="signerMobile">—</dd>

                {% if type != 'MENA' %}
                <dt style="color:var(--text-muted);font-weight:500;">Total KM (avec enfants)</dt>
                <dd style="margin:0;" id="kmParcourue">—</dd>
                {% endif %}

                <dt style="color:var(--text-muted);font-weight:500;">Total heures du mois</dt>
                <dd style="margin:0;font-weight:700;font-size:16px;color:var(--text);" id="heureCumuler">—</dd>

            </dl>
        </div>
    </div>

</div>

{# ── Actions ─────────────────────────────────────────── #}
<div style="display:flex;gap:10px;flex-wrap:wrap;">

    <a id="donwload" href="{{ path('releves_intervenant_pdf_mvc', {intervenantId: user.id, type: type, mois: moisOffset}) }}"
       class="btn btn-primary" target="_blank"
       style="pointer-events:none;opacity:.4;text-decoration:none;">
        <i class="fas fa-download"></i>
        {{ isMobile is defined and isMobile ? 'Consulter le PDF' : 'Télécharger le relevé' }}
    </a>

    <div style="display:flex;align-items:center;gap:8px;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:0 12px;height:34px;">
        <i class="fas fa-building" style="color:var(--text-muted);font-size:13px;"></i>
        <input id="heure" type="number" min="0" placeholder="0" style="width:50px;border:none;outline:none;font-size:13px;font-family:inherit;"> h
        <select id="minute" name="minute" style="border:none;outline:none;font-size:13px;font-family:inherit;background:transparent;"></select>
    </div>

    <button id="saveTime" class="btn btn-secondary">
        <i class="fas fa-save"></i>
        Sauvegarder heures hors Chaudoudoux
    </button>

    <button id="signerButton" class="btn btn-success">
        <i class="fas fa-signature"></i> Signer
    </button>

</div>

<style>
@media (max-width:640px) {
    .sheet-recap-grid { grid-template-columns: 1fr; }
}
/* Cases éditables de la grille relevé (uniquement celles avec un créneau) */
#tableContainer td.cell-editable { cursor:pointer; position:relative; transition:background .15s; }
#tableContainer td.cell-editable:hover { background:var(--primary-light); box-shadow:inset 0 0 0 2px var(--primary); }

/* Découpage en fiches de 5 familles max (meilleur responsive mobile) */
.fiche-block { margin-top:18px; }
.fiche-block:first-of-type { margin-top:0; }
.fiche-block-label {
    font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px;
    color:var(--primary); background:var(--primary-light);
    padding:6px 12px; border-radius:8px 8px 0 0; display:inline-block;
}
#tableContainer table { width:100%; }

/* Navigation entre fiches (quand nombreuses) */
.fiche-pager {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:10px 14px; margin-bottom:12px;
    background:#fff; border:1px solid var(--border); border-radius:var(--radius-md);
    box-shadow:var(--shadow-xs); position:sticky; top:8px; z-index:10;
}
.fiche-counter { font-size:15px; font-weight:600; color:var(--text-muted); }
.fiche-counter strong { font-size:20px; color:var(--primary); }
.fiche-pager .btn[disabled] { opacity:.4; cursor:not-allowed; }
@media (max-width:640px) {
    #tableContainer { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    #tableContainer table { font-size:12px; }
    #tableContainer td, #tableContainer th { padding:4px 5px; }
}

/* Modale d'édition de case */
#cellEditModal, #signConfirmModal { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:3000; display:none; align-items:center; justify-content:center; }
#cellEditModal.open, #signConfirmModal.open { display:flex; }
.cell-modal-box { background:#fff; border-radius:16px; padding:22px 24px; width:92%; max-width:460px; box-shadow:0 20px 60px rgba(0,0,0,.25); }
.cell-modal-box h3 { margin:0 0 4px; font-size:17px; }
.cell-modal-sub { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
.cr-row { display:flex; align-items:center; gap:8px; padding:8px 0; border-top:1px solid var(--border); }
.cr-time { display:flex; align-items:center; gap:3px; }
.cr-time select { padding:6px 8px; border:1.5px solid var(--border); border-radius:8px; font-size:14px; font-weight:600; font-family:inherit; background:var(--bg); }
.cr-sep { font-weight:700; color:var(--text-muted); }
.cr-arrow { color:var(--text-muted); }
.cr-actions { margin-left:auto; display:flex; gap:6px; }
.cell-locked-note { margin-top:12px; padding:9px 12px; background:#fff8e1; border-left:3px solid #f59f00; border-radius:8px; font-size:12.5px; color:#856404; }
</style>

{# ── Modale d'édition d'une case (jour × famille) ───────────────────────── #}
<div id="cellEditModal">
    <div class="cell-modal-box">
        <h3 id="cellModalTitle">Modifier le créneau</h3>
        <div class="cell-modal-sub" id="cellModalSub"></div>

        <div id="cellCreneauxList"><!-- créneaux existants injectés par JS --></div>

        <div id="cellLockedNote" class="cell-locked-note" style="display:none;">
            <i class="fas fa-lock"></i> Ce mois est clôturé modification impossible.
        </div>

        <div style="display:flex;justify-content:flex-end;margin-top:18px;">
            <button type="button" class="btn btn-ghost btn-sm" onclick="fermerCellEditor()">Fermer</button>
        </div>
    </div>
</div>

{# ── Modale de confirmation de signature ────────────────────────────────── #}
<div id="signConfirmModal">
    <div class="cell-modal-box" style="max-width:430px;text-align:center;">
        <div style="font-size:34px;color:var(--primary);margin-bottom:8px;"><i class="fas fa-signature"></i></div>
        <h3 style="margin:0 0 6px;">Confirmer la signature</h3>
        <p style="color:var(--text-muted);font-size:14px;line-height:1.5;margin:0 0 6px;">
            Le relevé sera <strong>envoyé par email</strong> (copie à Chaudoudoux) et
            <strong>ne pourra plus être modifié</strong>.
        </p>
        <p style="color:var(--text-muted);font-size:13px;margin:0 0 18px;">Voulez-vous continuer ?</p>
        <div style="display:flex;gap:10px;justify-content:center;">
            <button type="button" class="btn btn-ghost" onclick="fermerSignConfirm()">Annuler</button>
            <button type="button" class="btn btn-success" id="signConfirmBtn"><i class="fas fa-check"></i> Signer</button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://unpkg.com/jspdf-autotable@3.5.31/dist/jspdf.plugin.autotable.min.js"></script>
<script>
const ID = {{ user.id }};
const paramsUri = new URLSearchParams(window.location.search);
const TYPE_PRESTA = (paramsUri.get("type") || 'ENFA').toUpperCase();

const donwnloadInput = document.getElementById("donwload");

function activerBoutonTelechargement() {
    if (donwnloadInput) {
        donwnloadInput.style.opacity = '';
        donwnloadInput.style.pointerEvents = '';
    }
}
</script>

<script src="{{ asset('/assets/js/fiche-dheure.js') }}?v={{ 'now'|date('YmdHis') }}"></script>
<script>
const VACANCES_CONFIG = {% if vacancesConfig is defined and vacancesConfig %}{
  titre: {{ vacancesConfig.titre|json_encode|raw }},
  moisPeriodes: {{ (vacancesConfig.moisPeriodes ?? '')|json_encode|raw }},
  message: {{ (vacancesConfig.message ?? '')|json_encode|raw }},
  annee: {{ vacancesConfig.dateApparitionDebut ? vacancesConfig.dateApparitionDebut|date('Y') : "now"|date('Y') }}
}{% else %}null{% endif %};
</script>
{% endblock %}
